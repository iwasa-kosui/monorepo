{
  "name": "iori-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "iori": "./bin/iori.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/cli.js",
      "types": "./dist/cli.d.ts"
    }
  },
  "scripts": {
    "start": "node ./bin/iori.mjs",
    "dev": "tsx ./src/cli.ts",
    "test": "vitest",
    "test:ci": "vitest --run",
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "dprint": "0.65.0",
    "eslint": "^10.15.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.3.1"
  }
}
