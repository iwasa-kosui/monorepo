{
  "name": "mdlive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mdlive": "./bin/mdlive.mjs"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "start": "node ./bin/mdlive.mjs",
    "dev": "tsx ./src/cli.ts",
    "test": "vitest",
    "test:ci": "vitest --run",
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "dependencies": {
    "@iwasa-kosui/result": "workspace:*",
    "ignore": "7.0.16",
    "marked": "^18.2.1",
    "shiki": "^4.6.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "dprint": "0.65.0",
    "eslint": "^10.15.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
