{
  "name": "es-patchwork-hands-on",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.12.0"
  },
  "dependencies": {
    "@astrojs/check": "0.9.6",
    "@astrojs/mdx": "4.3.13",
    "astro": "5.16.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.2",
    "@tailwindcss/vite": "4.1.11",
    "dprint": "0.51.1",
    "eslint": "9.36.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.3.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vitest": "3.1.2",
    "wrangler": "4.72.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "astro check && tsc --noEmit",
    "tsc": "astro check && tsc --noEmit",
    "lint": "eslint .",
