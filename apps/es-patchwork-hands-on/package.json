{
  "name": "es-patchwork-hands-on",
  "type": "module",
  "private": true,
  "engines": {
    "node": "24.12.0"
  },
  "dependencies": {
    "@astrojs/check": "0.9.12",
    "@astrojs/mdx": "8.1.6",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "astro": "7.4.13",
    "sql.js": "1.17.0",
    "sucrase": "3.35.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/sql.js": "1.16.0",
    "dprint": "0.65.0",
    "eslint": "10.15.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-exercises-tarball.ts",
    "preview": "wrangler dev",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "astro check && tsc --noEmit",
    "tsc": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "test:e2e": "playwright test",
    "generate:og": "node scripts/generate-og-image.ts"
  }
}
