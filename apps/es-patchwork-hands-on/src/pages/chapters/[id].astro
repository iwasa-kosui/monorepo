---
import { getCollection, render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { schedule, withTimeRanges } from '../../schedule';

export const getStaticPaths = async () => {
  const entries = await getCollection('chapters');
  return entries.map((entry) => ({
    params: { id: entry.id },
    props: { entry, pageIds: entries.map((e) => e.id) },
  }));
};

const { entry, pageIds } = Astro.props;
const rows = withTimeRanges(schedule);
const row = rows.find((candidate) => candidate.id === entry.id);
if (row === undefined) {
  throw new Error(`schedule.ts に章がありません: ${entry.id}`);
}
const pages = rows.filter((candidate) => pageIds.includes(candidate.id));
const index = pages.findIndex((candidate) => candidate.id === row.id);
const previous = pages[index - 1];
const next = pages[index + 1];
const { Content } = await render(entry);
---

<BaseLayout title={row.title}>
  <p><a href="/">トップページへ</a></p>
  <h1>{row.title}</h1>
  <p>{row.range}{row.parts === undefined ? '' : `：${row.parts}`}</p>
  <p><strong>できるようになること：</strong>{entry.data.goal}</p>
  <Content />
  <nav class="mt-12 flex justify-between gap-4">
    {
      previous === undefined ? <span /> : (
        <a href={`/chapters/${previous.id}/`}>← {previous.title}</a>
      )
    }
    {
      next === undefined ? <span /> : (
        <a href={`/chapters/${next.id}/`}>{next.title} →</a>
      )
    }
  </nav>
</BaseLayout>
