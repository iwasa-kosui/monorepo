---
import TopBar from '../components/frame/TopBar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  frontmatter?: { title?: string; topBar?: boolean };
  chapterPage?: boolean;
  topBar?: boolean;
  noindex?: boolean;
}

const title = Astro.props.frontmatter?.title ?? Astro.props.title;
const chapterPage = Astro.props.chapterPage ?? false;
const topBar = Astro.props.frontmatter?.topBar ?? Astro.props.topBar
  ?? false;
const noindex = Astro.props.noindex ?? false;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
  </head>
  <body class:list={{ 'chapter-page': chapterPage }}>
    {
      chapterPage ? <slot /> : (
        <>
          {topBar && <TopBar />}
          <main class="content mx-auto max-w-4xl px-4 py-6">
            <slot />
          </main>
        </>
      )
    }
  </body>
</html>
