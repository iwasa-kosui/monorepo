---
import '../styles/global.css';

import { chapterGoalOf } from '../lib/page-meta';
import { siteDescription, siteName, siteTitle } from '../site';

interface Props {
  title?: string;
  description?: string;
  frontmatter?: { title?: string; description?: string };
  chapterPage?: boolean;
  wide?: boolean;
  noindex?: boolean;
}

const title = Astro.props.frontmatter?.title ?? Astro.props.title;
const chapterPage = Astro.props.chapterPage ?? false;
const wide = Astro.props.wide ?? false;
const noindex = Astro.props.noindex ?? false;
const pageTitle =
  title === undefined || title === siteTitle || title.includes(siteName)
    ? title
    : `${title} | ${siteName}`;
const description = Astro.props.description
  ?? Astro.props.frontmatter?.description
  ?? (await chapterGoalOf(Astro.url.pathname))
  ?? siteDescription;
const imageUrl = Astro.site === undefined
  ? undefined
  : new URL('/og.png', Astro.site).href;
const canonicalUrl = Astro.site === undefined
  ? undefined
  : new URL(Astro.url.pathname, Astro.site).href;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111827"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="ja_JP" />
    <meta name="twitter:card" content="summary_large_image" />
    {imageUrl !== undefined && <meta property="og:image" content={imageUrl} />}
    {
      imageUrl !== undefined && (
        <meta property="og:image:width" content="1200" />
      )
    }
    {
      imageUrl !== undefined && (
        <meta property="og:image:height" content="630" />
      )
    }
    {
      imageUrl !== undefined && (
        <meta property="og:image:alt" content={siteTitle} />
      )
    }
    {imageUrl !== undefined && <meta name="twitter:image" content={imageUrl} />}
    {
      canonicalUrl !== undefined && (
        <meta property="og:url" content={canonicalUrl} />
      )
    }
    {canonicalUrl !== undefined && <link rel="canonical" href={canonicalUrl} />}
  </head>
  <body class:list={{ 'chapter-page': chapterPage }}>
    <main
      class:list={[
        'content mx-auto px-4',
        chapterPage
          ? [
            'chapter-main w-full py-3',
            wide ? 'chapter-main-wide max-w-[77rem]' : 'max-w-6xl',
          ]
          : 'max-w-4xl py-6',
      ]}
    >
      <slot />
    </main>
  </body>
</html>
