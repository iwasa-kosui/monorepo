---
import '../styles/global.css';

interface Props {
  title?: string;
  frontmatter?: { title?: string };
  chapterPage?: boolean;
  noindex?: boolean;
}

const title = Astro.props.frontmatter?.title ?? Astro.props.title;
const chapterPage = Astro.props.chapterPage ?? false;
const noindex = Astro.props.noindex ?? false;
---

<!DOCTYPE html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>
  </head>
  <body class:list={{ 'chapter-page': chapterPage }}>
    <main
      class:list={[
        'content mx-auto px-4',
        chapterPage
          ? 'chapter-main w-full max-w-5xl py-3'
          : 'max-w-4xl py-6',
      ]}
    >
      <slot />
    </main>
  </body>
</html>
