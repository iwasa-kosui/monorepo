---
import '../playground/play.css';

import {
  cancelVisitOf,
  insertTemplate,
  lessonFile,
  snapshotFiles,
} from '../lib/snapshots';

interface Props {
  step: 1 | 2;
}

const { step } = Astro.props;
const start = 'chapter-1-start';
const files = {
  ...snapshotFiles(start),
  ...lessonFile('play-cancel.ts'),
  ...lessonFile('play-initial.ts'),
};
const initial = cancelVisitOf(start);
const source = files['visits.ts'] ?? '';
const position = source.indexOf(initial);
if (position === -1) {
  throw new Error('visits.ts から cancelVisit を切り出せません');
}
const config = JSON.stringify({
  exerciseId: 'play-add-record',
  step,
  files,
  head: source.slice(0, position),
  tail: source.slice(position + initial.length),
  initial,
  complete: cancelVisitOf('chapter-2-step-1'),
  completeStep2: step === 2 ? cancelVisitOf('chapter-2-step-2') : null,
  template: insertTemplate(),
});
const stepLabel = step === 1
  ? 'ステップ1: キャンセルを記録する'
  : 'ステップ2: 理由と操作した人を記録する';
const blanks = [
  ['/* event_name */', '\'VisitCancelled\''],
  ['/* target_id */', 'input.visitId'],
  ['/* target_type */', '\'Visit\''],
  ['/* target_state */', 'JSON.stringify(cancelled)'],
];
const answers = [
  ['when', 'いつ'],
  ['what', '何を'],
  ['who', '誰が'],
  ['why', 'なぜ'],
];
---

<div
  class="play"
  data-play="add-record"
  data-step={step}
  data-state="loading"
  data-config={config}
>
  <header class="play-inquiry">
    <span class="play-inquiry-label">問い合わせ</span>
    <h2>この来院がキャンセルになっているのはなぜですか。</h2>
    <span class="play-step-label">{stepLabel}</span>
    <div class="play-status" data-role="status">
      <span data-role="status-text" role="status"
      >実行環境を読み込んでいます</span>
      <button type="button" data-role="retry" hidden>もう一度読み込む</button>
    </div>
    <details class="play-node">
      <summary>手元の Node で動かすとき</summary>
      <div class="play-node-body">
        {
          step === 1 ? (
            <p>
              <code>chapter-1-start/visits.ts</code> の <code>cancelVisit</code>
              を編集し、<code>node --test visits.test.ts</code>
              を実行します。<code>pass 7</code> と <code>fail 1</code>
              が出れば、ステップ1は完了です。終わらないうちにステップ2へ進むときは、<code
              >chapter-2-step-1</code> に移動して続けます。第1章と同じく、<code
              >ℹ pass</code> と <code>ℹ fail</code>
              の行は失敗の詳細の上に出ます。
            </p>
          ) : (
            <p>
              同じ <code>cancelVisit</code> を編集し、<code>node --test
                visits.test.ts</code> を実行します。<code>pass 8</code> と <code
              >fail 0</code>
              が出れば、ステップ2は完了です。演習が終わらないうちに次の章へ進むときは、<code
              >chapter-2-step-2</code> に移動します。<code
              >chapter-2-step-2</code>
              は全テストが成功する完成のスナップショットです。
            </p>
          )
        }
      </div>
    </details>
  </header>
  <div class="play-columns">
    <section class="play-col play-work" aria-label="コードの編集と実行">
      <p class="play-next">
        <strong>次にすること</strong>
        <span data-role="next"></span>
      </p>
      <div class="play-editor-head">
        <code>visits.ts の cancelVisit</code>
        <div class="play-editor-tools">
          {
            step === 2 && (
              <button
                type="button"
                class="play-quiet"
                data-role="complete"
                disabled
              >
                ステップ1の完成コードを読み込む
              </button>
            )
          }
          <button type="button" class="play-quiet" data-role="reset" disabled>
            最初のコードに戻す
          </button>
          <button type="button" class="play-quiet" data-role="restore" hidden>
            読み込む前のコードに戻す
          </button>
        </div>
      </div>
      <div class="play-editor" data-role="editor"></div>
      <div class="play-actions">
        <button type="button" class="play-primary" data-role="run" disabled>
          ポチの来院をキャンセルする
        </button>
        {
          step === 1 && (
            <button type="button" data-role="template" disabled>
              記録の雛形を <code>UPDATE</code> の次の行に入れる
            </button>
          )
        }
      </div>
      <div class="play-message" data-role="message" aria-live="polite" hidden>
      </div>
    </section>
    <section class="play-col" aria-label="データベースの中身">
      <section class="play-panel" aria-labelledby="visits-title">
        <header class="play-panel-head">
          <h2 id="visits-title"><code>visits</code></h2>
          <span
            class="play-badge"
            data-role="visits-badge"
            data-phase="before"
          >実行前</span>
        </header>
        <table class="play-table" aria-label="visits テーブルの行">
          <thead>
            <tr>
              <th>id</th>
              <th>pet_name</th>
              <th>status</th>
            </tr>
          </thead>
          <tbody data-role="visits-body"></tbody>
        </table>
        <p class="play-caption" data-role="visits-caption"></p>
      </section>
      <section
        class="play-panel play-panel-events"
        aria-labelledby="events-title"
      >
        <header class="play-panel-head">
          <h2 id="events-title"><code>business_events</code></h2>
          <span
            class="play-badge"
            data-role="events-badge"
            data-phase="before"
          >実行前</span>
        </header>
        <div class="play-events" data-role="events"></div>
        <p class="play-caption" data-role="events-caption"></p>
      </section>
    </section>
    <section
      class="play-col play-col-hints"
      aria-label="問い合わせへの答えとテスト"
    >
      <div class="play-hint-area">
        <section class="play-panel" aria-labelledby="answer-title">
          <h2 id="answer-title">問い合わせへの答え</h2>
          <table class="play-table play-answer" aria-label="問い合わせへの答え">
            <tbody>
              {
                answers.map(([key, label]) => (
                  <tr data-answer={key}>
                    <th scope="row">{label}</th>
                    <td data-role="answer-value">まだ実行していません</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </section>
        <section class="play-panel play-hints" aria-labelledby="hints-title">
          <h2 id="hints-title">ヒントと解答</h2>
          <p class="play-hint">上から順に開きます。</p>
          {
            step === 1 ? (
              <>
                <details class="play-hint-step" name="hints-step-1">
                  <summary>ヒント1 考えること</summary>
                  <div class="play-hint-body">
                    <div class="play-hint-head">
                      <strong>ヒント1 考えること</strong>
                      <button
                        type="button"
                        class="play-quiet"
                        data-role="hint-close"
                      >
                        閉じる
                      </button>
                    </div>
                    <p>
                      問い合わせの「いつ」と「何を」に答えるには、<code
                      >business_events</code>
                      に1行を入れます。どの列がどの問いに答えるかは、前のページの
                      <code>business_events</code>
                      の表で確かめます。記録は、来院の更新と同じトランザクションの中に置きます。
                    </p>
                  </div>
                </details>
                <details class="play-hint-step" name="hints-step-1">
                  <summary>ヒント2 変える場所</summary>
                  <div class="play-hint-body">
                    <div class="play-hint-head">
                      <strong>ヒント2 変える場所</strong>
                      <button
                        type="button"
                        class="play-quiet"
                        data-role="hint-close"
                      >
                        閉じる
                      </button>
                    </div>
                    <p>
                      <code>UPDATE</code> の次の行に、<code
                      >business_events</code>
                      への <code>INSERT</code> を足します。左の「記録の雛形を
                      <code>UPDATE</code>
                      の次の行に入れる」を押すと、4つの空欄がある雛形が入ります。更新の後に置くのは、変化後の状態を
                      <code>target_state</code> に入れるためです。
                    </p>
                  </div>
                </details>
                <details class="play-hint-step" name="hints-step-1">
                  <summary>ヒント3 入れる値</summary>
                  <div class="play-hint-body">
                    <div class="play-hint-head">
                      <strong>ヒント3 入れる値</strong>
                      <button
                        type="button"
                        class="play-quiet"
                        data-role="hint-close"
                      >
                        閉じる
                      </button>
                    </div>
                    <table
                      class="play-table play-blanks"
                      aria-label="空欄に入れる値"
                    >
                      <thead>
                        <tr>
                          <th>空欄</th>
                          <th>値</th>
                        </tr>
                      </thead>
                      <tbody>
                        {
                          blanks.map((
                        [blank, value],
                      ) => (
                            <tr>
                              <td><code>{blank}</code></td>
                              <td><code>{value}</code></td>
                            </tr>
                          ))
                        }
                      </tbody>
                    </table>
                  </div>
                </details>
                <details class="play-hint-step" name="hints-step-1">
                  <summary>解答</summary>
                  <div class="play-hint-body">
                    <div class="play-hint-head">
                      <strong>解答</strong>
                      <button
                        type="button"
                        class="play-quiet"
                        data-role="hint-close"
                      >
                        閉じる
                      </button>
                    </div>
                    <p>4つの空欄の値と、その値にする理由は次のとおりです。</p>
                    <ul class="play-changes play-bullets">
                      <li>
                        <code>event_name</code> は <code>'VisitCancelled'</code>
                        です。起きたことの名前で、「何を」に答えます。
                      </li>
                      <li>
                        <code>target_id</code> は <code>input.visitId</code>
                        です。問い合わせの来院の記録を、来院の ID
                        で探すためです。
                      </li>
                      <li>
                        <code>target_type</code> は <code>'Visit'</code>
                        です。来院以外の対象の記録と区別するためです。
                      </li>
                      <li>
                        <code>target_state</code> は <code
                        >JSON.stringify(cancelled)</code>
                        です。キャンセル後の来院の状態を、後から確かめるためです。
                      </li>
                    </ul>
                    <p>
                      次のボタンで、解答のコードを編集欄に読み込めます。テストを実行して
                      <code>pass 7 / fail 1</code>
                      になれば完了です。残る1件は、次のページのステップ2で直します。
                    </p>
                    <button
                      type="button"
                      class="play-quiet"
                      data-role="complete"
                      disabled
                    >
                      ステップ1の完成コードを読み込む
                    </button>
                  </div>
                </details>
              </>
            ) : (
              <>
                <details class="play-hint-step" name="hints-step-2">
                  <summary>ヒント1 考えること</summary>
                  <div class="play-hint-body">
                    <div class="play-hint-head">
                      <strong>ヒント1 考えること</strong>
                      <button
                        type="button"
                        class="play-quiet"
                        data-role="hint-close"
                      >
                        閉じる
                      </button>
                    </div>
                    <p>
                      「誰が」と「なぜ」は、<code>business_events</code> の
                      <code>payload</code>
                      に入れます。呼び出し元は、理由と操作した人を
                      <code>cancelVisit</code> に渡しています。いまの <code
                      >cancelVisit</code>
                      は、その2つを受け取っていません。
                    </p>
                  </div>
                </details>
                <details class="play-hint-step" name="hints-step-2">
                  <summary>ヒント2 変える場所</summary>
                  <div class="play-hint-body">
                    <div class="play-hint-head">
                      <strong>ヒント2 変える場所</strong>
                      <button
                        type="button"
                        class="play-quiet"
                        data-role="hint-close"
                      >
                        閉じる
                      </button>
                    </div>
                    <p>
                      変える場所は2か所です。1か所目は <code>input</code>
                      の型で、2か所目は <code>payload</code> の値です。
                    </p>
                  </div>
                </details>
                <details class="play-hint-step" name="hints-step-2">
                  <summary>ヒント3 入れる値</summary>
                  <div class="play-hint-body">
                    <div class="play-hint-head">
                      <strong>ヒント3 入れる値</strong>
                      <button
                        type="button"
                        class="play-quiet"
                        data-role="hint-close"
                      >
                        閉じる
                      </button>
                    </div>
                    <ol class="play-changes">
                      <li>
                        <code>input</code> の型に <code>reason: string</code> と
                        <code>operatedBy: string</code> を足します。
                      </li>
                      <li>
                        <code>payload</code> の <code>JSON.stringify({
                            '{}'
                          })</code>
                        を、<code>reason</code> と <code>operatedBy</code>
                        を持つオブジェクトに変えます。キーの名前はこのとおりにします。テストと第3章の
                        SELECT は <code>$.reason</code> と <code
                        >$.operatedBy</code>
                        を読みます。
                      </li>
                    </ol>
                  </div>
                </details>
                <details class="play-hint-step" name="hints-step-2">
                  <summary>解答</summary>
                  <div class="play-hint-body">
                    <div class="play-hint-head">
                      <strong>解答</strong>
                      <button
                        type="button"
                        class="play-quiet"
                        data-role="hint-close"
                      >
                        閉じる
                      </button>
                    </div>
                    <ul class="play-changes play-bullets">
                      <li>
                        <code>input</code> の型は <code>{
                          '{ visitId: string; reason: string; operatedBy: string }'
                        }</code>
                        です。呼び出し元が渡す2つを受け取るためです。
                      </li>
                      <li>
                        <code>payload</code> は <code>JSON.stringify({
                            '{ reason: input.reason, operatedBy: input.operatedBy }'
                          })</code>
                        です。テストと第3章の SELECT が、<code>$.reason</code>
                        と
                        <code>$.operatedBy</code> を読むためです。
                      </li>
                    </ul>
                    <p>
                      次のボタンで、解答のコードを編集欄に読み込めます。テストを実行して
                      <code>pass 8 / fail 0</code> になれば完了です。
                    </p>
                    <button
                      type="button"
                      class="play-quiet"
                      data-role="complete-step-2"
                      disabled
                    >
                      ステップ2の完成コードを読み込む
                    </button>
                  </div>
                </details>
              </>
            )
          }
        </section>
      </div>
      <section class="play-panel play-tests" aria-labelledby="tests-title">
        <h2 id="tests-title">テスト</h2>
        <div class="play-tests-row">
          <button type="button" data-role="tests" disabled>
            テストを実行する
          </button>
          <p class="play-summary" data-role="summary">まだ実行していません</p>
        </div>
        <ul
          class="play-failed"
          data-role="failed"
          aria-label="失敗したテスト"
        >
        </ul>
      </section>
    </section>
  </div>
</div>

<script>
import '../playground/play-add-record.ts';
</script>
