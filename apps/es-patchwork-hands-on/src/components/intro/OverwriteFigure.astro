---

---

<section
  class="figure"
  data-overwrite-figure
  data-step="0"
  aria-labelledby="overwrite-title"
>
  <p id="overwrite-title" class="figure-title">
    ボタンを順に押して、上書きした来院をバックアップから戻してみてください。
  </p>

  <svg
    class="scene"
    viewBox="0 0 520 90"
    preserveAspectRatio="xMidYMid meet"
    aria-hidden="true"
    focusable="false"
  >
    <path
      class="bubble"
      d="M84 12 C140 6 250 8 302 11 C312 12 313 40 302 43 C250 47 160 45 108 44 L84 56 L92 42 C72 36 70 14 84 12 Z"
    >
    </path>
    <text class="bubble-text" x="196" y="32" text-anchor="middle">
      なんで記録取ってないんですか
    </text>
    <path
      class="bubble"
      d="M346 44 C372 40 420 41 436 44 C446 46 446 68 436 72 C420 76 372 76 352 73 C340 70 338 48 346 44 Z"
    >
    </path>
    <path class="bubble" d="M436 62 L452 70 L440 54"></path>
    <text class="bubble-text" x="392" y="63" text-anchor="middle">……</text>
    <path
      class="skin"
      d="M40 34 C52 32 60 40 58 52 C56 64 44 68 34 63 C24 58 24 38 40 34 Z"
    >
    </path>
    <path
      class="hair"
      d="M26 46 C24 30 38 24 50 28 C58 32 60 40 58 44 C50 38 38 36 26 46 Z"
    >
    </path>
    <path class="headset" d="M24 48 C20 22 56 18 60 44"></path>
    <path class="headset" d="M24 44 L24 58 M60 40 L60 54"></path>
    <path class="headset" d="M24 58 C26 66 34 68 42 68"></path>
    <circle class="cheek" cx="52" cy="56" r="3"></circle>
    <path class="line" d="M14 88 C14 74 26 70 40 71 C54 72 66 76 66 88"></path>
    <path class="shirt" d="M18 88 C18 77 28 74 40 75 C52 76 62 79 62 88 Z">
    </path>
    <path
      class="skin"
      d="M476 50 C490 48 500 56 498 68 C496 78 484 82 474 77 C466 72 466 54 476 50 Z"
    >
    </path>
    <path
      class="hair dark"
      d="M466 62 C464 46 478 40 490 44 C498 48 500 56 498 60 C490 54 476 52 466 62 Z"
    >
    </path>
    <path class="line" d="M470 66 L478 66 M486 66 L494 66 M478 66 L486 66">
    </path>
    <path class="line" d="M478 75 C482 77 488 76 490 74"></path>
    <path class="line" d="M458 90 C458 82 468 80 482 81 C496 82 508 84 508 90">
    </path>
    <path
      class="shirt blue"
      d="M462 90 C462 84 470 83 482 84 C494 85 504 86 504 90 Z"
    >
    </path>
    <path class="spark" d="M514 54 L518 48 M508 50 L508 44"></path>
  </svg>

  <div class="table-wrap">
    <table class="visit-table">
      <caption class="sr-only">来院のテーブル</caption>
      <thead>
        <tr>
          <th scope="col">id</th>
          <th scope="col">pet_name</th>
          <th scope="col">status</th>
        </tr>
      </thead>
      <tbody>
        <tr class="row">
          <td>visit-pochi</td>
          <td>ポチ</td>
          <td class="status-cell">
            <span class="value value-old">reserved</span>
            <span class="value value-new">cancelled</span>
          </td>
        </tr>
      </tbody>
    </table>
    <div class="backup" aria-hidden="true">
      <span class="tag">昨夜のバックアップ</span>
      <span>visit-pochi</span>
      <span>ポチ</span>
      <span>reserved</span>
    </div>
  </div>

  <ul class="cards">
    <li class="card">
      <span class="card-label">なぜキャンセルか</span>
      <span class="card-value">残っていません</span>
    </li>
    <li class="card">
      <span class="card-label">誰が変えたか</span>
      <span class="card-value">残っていません</span>
    </li>
  </ul>

  <div class="controls">
    <button type="button" data-action="update">
      この来院をキャンセルに更新する
    </button>
    <button type="button" data-action="restore" disabled>
      バックアップから戻す
    </button>
    <button type="button" data-action="reset" disabled>最初に戻す</button>
  </div>

  <p class="message" aria-live="polite" data-message>
    「この来院をキャンセルに更新する」を押してください。
  </p>
</section>

<style>
.figure {
  --line: #d1d5db;
  --panel: #f3f4f6;
  --paper: #ffffff;
  --text: #374151;
  --muted: #4b5563;
  --accent: #1d4ed8;
  --ink: #1e2a5a;
  --red: #dc2626;
  --yellow: #facc15;
  --blue: #2563eb;
  --gray: #9ca3af;
  --row-height: 3rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 0.75rem;
  border: 1px solid var(--line);
  border-radius: 0.5rem;
  background: var(--panel);
  padding: 0.875rem 1rem;
  color: var(--text);
}
.figure-title {
  margin: 0;
  font-size: 0.9375rem;
  font-weight: 700;
  line-height: 1.5;
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}

.scene {
  display: block;
  width: 100%;
  height: 90px;
  border-radius: 0.375rem;
  background: var(--paper);
}
.scene .bubble,
.scene .line,
.scene .headset,
.scene .spark {
  fill: var(--paper);
  stroke: var(--ink);
  stroke-width: 3;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.scene .line,
.scene .headset,
.scene .spark {
  fill: none;
}
.scene .spark {
  stroke: var(--red);
}
.scene .skin {
  fill: #fde8c8;
  stroke: var(--ink);
  stroke-width: 3;
  stroke-linejoin: round;
}
.scene .hair {
  fill: var(--yellow);
  stroke: var(--ink);
  stroke-width: 3;
  stroke-linejoin: round;
}
.scene .hair.dark {
  fill: var(--ink);
}
.scene .shirt {
  fill: var(--red);
  stroke: var(--ink);
  stroke-width: 2;
  stroke-linejoin: round;
}
.scene .shirt.blue {
  fill: var(--blue);
}
.scene .cheek {
  fill: var(--red);
  opacity: 0.5;
}
.scene .bubble-text {
  fill: var(--ink);
  font-size: 13px;
  font-weight: 700;
}

.table-wrap {
  position: relative;
  overflow: hidden;
}
.visit-table {
  display: table;
  width: 100%;
  margin: 0;
  border-collapse: collapse;
  background: var(--paper);
  font-size: 1rem;
}
.visit-table th,
.visit-table td {
  border: 1px solid var(--line);
  padding: 0.375rem 0.75rem;
  text-align: left;
}
.visit-table th {
  background: var(--panel);
  font-weight: 700;
}
.visit-table td {
  height: var(--row-height);
}
.status-cell {
  position: relative;
  overflow: hidden;
}
.value {
  position: absolute;
  top: 50%;
  left: 0.75rem;
  font-weight: 700;
  transition: transform 0.5s ease, opacity 0.5s ease;
  translate: 0 -50%;
}
.value-old {
  opacity: 1;
}
.value-new {
  color: var(--red);
  opacity: 0;
  transform: translateX(-1.5rem);
}
.backup {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  display: none;
  align-items: center;
  gap: 1.25rem;
  height: var(--row-height);
  box-sizing: border-box;
  background: var(--yellow);
  padding-inline: 0.75rem;
  color: var(--ink);
  font-size: 1rem;
  font-weight: 700;
  white-space: nowrap;
}
.backup .tag {
  border: 2px solid var(--ink);
  border-radius: 0.25rem;
  background: var(--paper);
  padding-inline: 0.375rem;
  font-size: 0.75rem;
}

[data-step="1"] .value-old {
  opacity: 0;
  transform: translateX(4rem);
}
[data-step="1"] .value-new {
  opacity: 1;
  transform: translateX(0);
  transition-delay: 0.3s;
}
[data-step="2"] .value-new {
  opacity: 0;
  transform: translateX(-1.5rem);
}
[data-step="2"] .value-old {
  transition-delay: 0.4s;
}

[data-step="2"] .backup {
  display: flex;
  animation: backup-pass 1.8s ease both;
}
@keyframes backup-pass {
  0% {
    opacity: 0;
    transform: translateY(100%);
  }
  35% {
    opacity: 1;
    transform: translateY(0);
  }
  70% {
    opacity: 1;
    transform: translateY(0);
  }
  100% {
    opacity: 0;
    transform: translateY(0);
  }
}

.cards {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
  margin: 0;
  padding: 0;
  list-style: none;
}
.card {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  border: 2px dashed var(--gray);
  border-radius: 0.375rem;
  background: var(--paper);
  padding: 0.875rem 1rem;
}
.card-label {
  font-size: 0.9375rem;
  font-weight: 700;
}
.card-value {
  color: var(--muted);
  font-size: 1rem;
}
[data-step="2"] .card {
  animation: shake 0.6s ease 1.1s both;
  background: #e5e7eb;
  color: var(--gray);
}
[data-step="2"] .card-value {
  color: var(--gray);
}
@keyframes shake {
  0%, 100% {
    transform: translateX(0);
  }
  20% {
    transform: translateX(-6px);
  }
  40% {
    transform: translateX(5px);
  }
  60% {
    transform: translateX(-3px);
  }
  80% {
    transform: translateX(2px);
  }
}

.controls {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.controls button {
  border: 1px solid var(--accent);
  border-radius: 0.375rem;
  background: var(--paper);
  padding: 0.5rem 1rem;
  color: var(--accent);
  font-size: 0.9375rem;
  cursor: pointer;
}
.controls button:hover:not(:disabled) {
  background: #dbeafe;
}
.controls button:disabled {
  border-color: var(--line);
  color: var(--gray);
  cursor: not-allowed;
}
.message {
  margin: 0;
  min-height: 3rem;
  font-size: 1.0625rem;
  font-weight: 700;
  line-height: 1.5;
}

@media (max-height: 700px) {
  .figure {
    --row-height: 2.5rem;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
  }
  .figure-title {
    font-size: 0.8125rem;
  }
  .scene {
    height: 72px;
  }
  .visit-table {
    font-size: 0.875rem;
  }
  .visit-table th,
  .visit-table td {
    padding: 0.25rem 0.625rem;
  }
  .card {
    padding: 0.375rem 0.75rem;
  }
  .controls button {
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
  }
  .message {
    min-height: 2.5rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }
}

@media (prefers-reduced-motion: reduce) {
  .value,
  .value-old,
  .value-new {
    transition: none;
    transition-delay: 0s;
  }
  [data-step="2"] .value-old,
  [data-step="1"] .value-new {
    transition-delay: 0s;
  }
  [data-step="2"] .backup {
    display: none;
    animation: none;
  }
  [data-step="2"] .card {
    animation: none;
  }
}
</style>

<script>
const messages = [
  '「この来院をキャンセルに更新する」を押してください。',
  '古い値は上書きで消えました。理由を書く列はありません。',
  '値は戻りました。誰がなぜ変えたのかは戻りません。',
];

for (
  const root of document.querySelectorAll<HTMLElement>(
    '[data-overwrite-figure]',
  )
) {
  const message = root.querySelector<HTMLElement>('[data-message]');
  const update = root.querySelector<HTMLButtonElement>(
    '[data-action="update"]',
  );
  const restore = root.querySelector<HTMLButtonElement>(
    '[data-action="restore"]',
  );
  const reset = root.querySelector<HTMLButtonElement>('[data-action="reset"]');
  if (
    message === null || update === null || restore === null || reset === null
  ) continue;

  const show = (step: number): void => {
    root.dataset.step = String(step);
    message.textContent = messages[step] ?? '';
    update.disabled = step !== 0;
    restore.disabled = step !== 1;
    reset.disabled = step === 0;
  };

  update.addEventListener('click', () => show(1));
  restore.addEventListener('click', () => show(2));
  reset.addEventListener('click', () => show(0));
}
</script>
