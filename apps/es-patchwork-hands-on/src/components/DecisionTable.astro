---
import { compiledContent } from '../../exercises/chapter-4-decision-table.md';
import { extractHtmlSection, sliceTableRows } from '../lib/extract';

interface Props {
  heading: string;
  from?: number;
  to?: number;
}

const { heading, from, to } = Astro.props;
if ((from === undefined) !== (to === undefined)) {
  throw new Error('DecisionTable の from と to は両方を指定します');
}
const section = extractHtmlSection(await compiledContent(), heading);
const html = from === undefined || to === undefined
  ? section
  : sliceTableRows(section, from, to);
---

<div class="decision-table"><Fragment set:html={html} /></div>
