<div class="grid gap-1" data-own-question>
  <textarea
    class="block w-full rounded border border-gray-400 bg-white px-2 py-1"
    rows="3"
    aria-label="自分のシステムの問いを1つ挙げる"
  ></textarea>
  <div class="min-h-5 text-sm text-gray-600" role="status" data-saved></div>
</div>

<script>
import { loadQuestion, saveQuestion } from '../playground/storage.ts';

for (
  const root of document.querySelectorAll<HTMLElement>('[data-own-question]')
) {
  const text = root.querySelector('textarea');
  const status = root.querySelector('[data-saved]');
  if (text === null || status === null) continue;
  const restore = (): void => {
    const saved = loadQuestion('chapter-1');
    if (saved !== null) {
      text.value = saved;
    }
  };
  restore();
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) restore();
  });
  text.addEventListener('input', () => {
    status.textContent = saveQuestion('chapter-1', text.value)
      ? 'このブラウザに保存しました。'
      : 'このブラウザには保存できませんでした。';
  });
}
</script>
