---
interface Props {
  name: string;
}

const { name } = Astro.props;

const figures = import.meta.glob<string>('../figures/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const html = figures[`../figures/${name}.html`];

if (html === undefined) {
  throw new Error(`Figure "${name}" not found in src/figures/`);
}
---

<Fragment set:html={html} />

<script>
document.addEventListener('change', (event) => {
  const tabs = event.target instanceof Element
    ? event.target.closest('.fig-tabs')
    : null;
  if (!tabs) return;
  for (const svg of tabs.querySelectorAll<SVGSVGElement>('.fig-panel svg')) {
    if (svg.querySelector('.fig-anim') && svg.checkVisibility()) {
      svg.setCurrentTime(0);
    }
  }
});
</script>
