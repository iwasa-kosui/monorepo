---
/**
 * 記事のタイトルの帯。紙の上の砂にタイトルを置き、その右上の隅に、トップページのヒーローと同じ波打ち際を描く。
 * 波は海から紙のほうへ寄せては引き、砂浜のドット絵のエビを少しずつ沖へ攫っていく。
 *
 * 海は帯で切らず、本文の後ろへ続ける。
 * 広い画面では、紙の右の余白に留まり、読み進めても波とエビが見える。
 * 余白のない狭い画面では、ページの上端に置き、紙の下へもぐり込む。読み進めると画面の外へ流れていく。
 *
 * BaseLayout の eyecatch スロットに置く。日付などは meta スロットで、タイトルの下に並べる操作は actions スロットで渡す。
 * 海は WebGL で描く（ShoreHero/mount.ts）。WebGL が使えない環境では、砂の地に静止したドット絵だけを見せる。
 */
import { EYE_PATH, SHELL_PATH } from '../ShoreHero/shrimp';

type Props = {
  title: string;
  /** ページをまたぐ遷移で、一覧のタイトルとつなぐ名前 */
  transitionName: string;
};

const { title, transitionName } = Astro.props;
---

<div class="title-shore">
  <div class="title-shore-sea" data-shore-hero>
    <canvas data-shore-canvas aria-hidden="true"></canvas>
    <div class="title-shore-slot" data-shore-slot>
      <button
        class="title-shore-shrimp"
        type="button"
        data-shore-shrimp
        aria-label="砂浜に打ち上げられたドット絵のエビ。波に少しずつ攫われていきます。触れると弱く跳ねます"
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 20 20"
          shape-rendering="crispEdges"
        >
          <path class="title-shore-shell" d={SHELL_PATH}></path>
          <path class="title-shore-eye" d={EYE_PATH}></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="title-shore-copy">
    <p class="title-shore-meta"><slot name="meta" /></p>
    <h1
      class="title-shore-title"
      data-pagefind-meta="title"
      transition:name={transitionName}
    >
      {title}
    </h1>
    {
      Astro.slots.has('actions') && (
        <div class="title-shore-actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</div>

<style>
/* 海と砂の配色は global.css の :root にある */
.title-shore {
  --shore-ink: #1f2740;
  --shore-muted: #4b526d;
  --shore-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
  color: var(--shore-ink);
}

@media (prefers-color-scheme: dark) {
  .title-shore {
    --shore-ink: #f3f1ee;
    --shore-muted: #b3bacb;
  }
}

/* 海。ページの上端に置く。帯より下まで続き、紙の下へもぐり込む */
.title-shore-sea {
  /* 距離の単位（波の大きさを決める正方形の 1 辺）と、そのうちエビの占める割合 */
  --shore-unit: clamp(5rem, 22vw, 6.5rem);
  --shore-shrimp: 56%;

  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  height: 32rem;
  overflow: hidden;
  pointer-events: none;
  /* 波はふつう下端まで届かない。届いた分は、ページの砂へ溶け込ませる */
  mask-image: linear-gradient(to bottom, #000 calc(100% - 8rem), transparent);
}

.title-shore-sea canvas {
  display: block;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 1.6s ease;
}

.title-shore-sea.is-live canvas {
  opacity: 1;
}

/* 海は右上の隅にあり、波はそこから左下へ寄せる。
   凪の波打ち際は、この正方形の中心から沖へ単位の 0.66 倍のところを通る。
   上端で右端より少し内側を通るように、正方形を右上の隅から少し下げて置く */
.title-shore-slot {
  position: absolute;
  top: 0;
  right: 0;
  width: var(--shore-unit);
  aspect-ratio: 1;
  transform: translate(-4%, 60%);
}

.title-shore-shrimp {
  position: absolute;
  inset: calc((100% - var(--shore-shrimp)) / 2);
  width: var(--shore-shrimp);
  height: var(--shore-shrimp);
  border-radius: 0.5rem;
  cursor: pointer;
  pointer-events: auto;
}

.title-shore-shrimp svg {
  display: block;
  width: 100%;
  height: 100%;
}

/* 海を描けているときは、エビもシェーダーが描く */
.title-shore-sea.is-live .title-shore-shrimp svg {
  visibility: hidden;
}

.title-shore-shell {
  fill: var(--shore-shell);
}

.title-shore-eye {
  fill: var(--shore-eye);
}

.title-shore-shrimp:focus-visible {
  outline: 2px solid var(--shore-eye);
  outline-offset: 4px;
}

/* タイトル。下に続く紙と同じ列（幅 48rem、左右 1rem ずつ内側）に置く */
.title-shore-copy {
  position: relative;
  max-width: 48rem;
  margin-inline: auto;
  padding: 8.5rem 1rem 0.5rem;
}

.title-shore-meta {
  font-size: 0.875rem;
  color: var(--shore-muted);
  font-variant-numeric: tabular-nums;
  animation: title-shore-up 0.9s 0.1s var(--shore-ease) both;
}

.title-shore-title {
  margin-top: 0.5rem;
  font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.5rem);
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.01em;
  overflow-wrap: anywhere;
  word-break: auto-phrase;
  text-wrap: balance;
  animation: title-shore-up 1s 0.2s var(--shore-ease) both;
}

.title-shore-actions {
  margin-top: 1rem;
  animation: title-shore-up 1s 0.3s var(--shore-ease) both;
}

@keyframes title-shore-up {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

/* 広い画面: 海を、紙（幅 48rem の列から左右 1rem ずつ内側）の右の余白に留める。
   左端は紙の下に 4rem もぐり込ませ、紙のないところではページの砂へ溶け込ませる */
@media (min-width: 68rem) {
  .title-shore-sea {
    --shore-unit: clamp(7.5rem, 40%, 15rem);
    --shore-shrimp: 48%;

    position: fixed;
    bottom: 0;
    left: calc(50% + 19rem);
    height: auto;
    mask-image: linear-gradient(to right, transparent, #000 3.5rem);
  }

  .title-shore-copy {
    padding-top: 7rem;
    padding-bottom: 1.5rem;
  }
}

@media (prefers-reduced-motion: reduce) {
  .title-shore *,
  .title-shore-sea canvas {
    animation: none;
    transition: none;
  }
}

@media print {
  .title-shore-sea {
    display: none;
  }
}
</style>

<script>
import '../ShoreHero/autoMount';
</script>
