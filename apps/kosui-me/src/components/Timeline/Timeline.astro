---
/**
 * トップページのタイムライン。ヒーローの上に重なる紙のシートに、年ごとにまとめた行として並べる。
 * シートそのもの（角の丸みと地の色）は BaseLayout が持つ。
 */
import { getTheme } from '@/config/themes';
import {
  formatMonthDay,
  groupByYear,
  KIND_LABEL,
  type TimelineEntry,
} from './timeline';

type Props = {
  entries: readonly TimelineEntry[];
};

const { entries } = Astro.props;
const groups = groupByYear(entries);
const TITLE = 'Timeline';
---

<section
  class="tl"
  id="timeline"
  data-timeline
  aria-labelledby="timeline-title"
>
  <header class="tl-head">
    {/* 見出しは 1 文字ずつ下からせり上がる。読み上げには aria-label を使う */}
    <h2
      class="tl-title"
      id="timeline-title"
      aria-label={TITLE}
      data-timeline-reveal
    >
      {
        [...TITLE].map((letter, i) => (
          <span style={`--i: ${i}`} aria-hidden="true">{letter}</span>
        ))
      }
    </h2>
    <p class="tl-count">{entries.length} 件</p>
  </header>
  {
    groups.map((group) => (
      <section class="tl-year" aria-label={`${group.year}年`}>
        <h3 class="tl-year-label">{group.year}</h3>
        <ol class="tl-rows">
          {
            group.entries.map((entry) => (
              <li class="tl-row" data-timeline-reveal>
                <time class="tl-date" datetime={entry.date}>
                  {formatMonthDay(entry.date)}
                </time>
                <div class="tl-body">
                  <h4
                    class="tl-heading"
                    transition:name={entry.transitionName}
                  >
                    <a
                      class="tl-link"
                      href={entry.href}
                      {...(entry.external
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {})}
                    >
                      <span class="tl-shift">{entry.title}</span>
                    </a>
                  </h4>
                  {
                    entry.context && (
                      <p class="tl-context tl-shift">{entry.context}</p>
                    )
                  }
                  {
                    entry.description && (
                      <p class="tl-description tl-shift">{entry.description}</p>
                    )
                  }
                </div>
                <div class="tl-meta">
                  <span class="tl-kind">{KIND_LABEL[entry.kind]}</span>
                  {
                    entry.themes.length > 0 && (
                      <ul class="tl-themes" aria-label="テーマ">
                        {
                          entry.themes.map((slug) => {
                const theme = getTheme(slug);
                return (
                            <li>
                              <a
                                href={`/themes/${slug}`}
                                style={`--tl-theme: ${
                                  theme?.color ?? 'currentColor'
                                }`}
                              >
                                {theme?.name ?? slug}
                              </a>
                            </li>
                          );
              })
                        }
                      </ul>
                    )
                  }
                </div>
                <span
                  class:list={['tl-go', entry.external && 'is-external']}
                  aria-hidden="true"
                >
                  {entry.external ? '↗' : '→'}
                </span>
              </li>
            ))
          }
        </ol>
      </section>
    ))
  }
</section>

<style>
.tl {
  --tl-ink: #1f2740;
  --tl-muted: #4b526d;
  --tl-line: rgba(31, 39, 64, 0.16);
  --tl-sand: var(--color-bg);
  --tl-go: #ee7b6f;
  --tl-title-size: clamp(1.125rem, 1.85vw, 1.625rem);
  /* 行の 1 行目の高さ。日付・種類・矢印を、タイトルの 1 行目にそろえるのに使う */
  --tl-first-line: calc(var(--tl-title-size) * 1.5);
  --tl-ease: cubic-bezier(0.2, 0.8, 0.2, 1);

  /* 「記事を読む」から飛んできたとき、シートの上端（BaseLayout の上の余白）から見せる */
  scroll-margin-top: clamp(3.5rem, 7vw, 6rem);
  color: var(--tl-ink);
}

@media (prefers-color-scheme: dark) {
  .tl {
    --tl-ink: #f3f1ee;
    --tl-muted: #b3bacb;
    --tl-line: rgba(243, 241, 238, 0.18);
    --tl-go: #f47f70;
  }
}

.tl-head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  justify-content: space-between;
  gap: 0.5rem 1.5rem;
  padding-bottom: clamp(1.75rem, 4vw, 3.25rem);
}

.tl-title {
  overflow: hidden;
  padding-bottom: 0.08em;
  font-size: clamp(3.25rem, 6.6vw, 6rem);
  font-weight: 400;
  letter-spacing: -0.04em;
  line-height: 1.05;
}

.tl-title span {
  display: inline-block;
  transition: transform 1s var(--tl-ease);
  transition-delay: calc(var(--i) * 45ms);
}

.tl-count {
  padding-bottom: 0.5rem;
  color: var(--tl-muted);
  font-variant-numeric: tabular-nums;
}

.tl-year-label {
  padding: 1.25rem 0 0.5rem;
  border-top: 1px solid var(--tl-ink);
  font-size: clamp(1.5rem, 2.4vw, 2.25rem);
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.tl-year + .tl-year {
  margin-top: clamp(2rem, 5vw, 4rem);
}

.tl-row {
  position: relative;
  isolation: isolate;
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: center;
  gap: 0.625rem 1rem;
  padding: 1.25rem 0 1.375rem;
  transition: opacity 0.9s var(--tl-ease), transform 0.9s var(--tl-ease);
  transition-delay: calc(var(--n, 0) * 90ms);
}

/* 行を区切る線。行が画面に入るとき、左から引かれる */
.tl-row::before {
  content: "";
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  height: 1px;
  background: var(--tl-line);
  transform-origin: left;
  transition: transform 1.1s var(--tl-ease);
  transition-delay: calc(var(--n, 0) * 90ms);
}

.tl-year:last-child .tl-row:last-child {
  border-bottom: 1px solid var(--tl-line);
}

/* 触れた行には、砂の色が左から広がる */
.tl-row::after {
  content: "";
  position: absolute;
  inset: 0 -0.75rem;
  z-index: -1;
  border-radius: 1.25rem;
  background: var(--tl-sand);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.5s var(--tl-ease);
}

.tl-row:hover::after,
.tl-row:focus-within::after {
  transform: scaleX(1);
}

.tl-date {
  grid-area: 1 / 1;
  color: var(--tl-muted);
  font-size: 0.9375rem;
  font-variant-numeric: tabular-nums;
}

.tl-go {
  grid-area: 1 / 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.75rem;
  height: 2.75rem;
  border-radius: 50%;
  background: var(--tl-sand);
  transition: background-color 0.3s, color 0.3s, transform 0.5s var(--tl-ease);
}

.tl-row:hover .tl-go {
  background-color: var(--tl-go);
  color: #1f2740;
  transform: rotate(-45deg);
}

/* 外へ出るリンクの矢印は、はじめから斜め上を向いているので回さない */
.tl-row:hover .tl-go.is-external {
  transform: translate(0.125rem, -0.125rem);
}

.tl-body {
  grid-column: 1 / -1;
  min-width: 0;
}

/*
 * 触れた行は、タイトルと概要が少し右へ寄る。
 * .tl-body ごと動かすと、行全体を覆うリンク（.tl-link::after）の基準が .tl-body に変わり、
 * 日付や矢印を押してもリンクにならなくなる。そのため中身を 1 つずつ動かす
 */
.tl-shift {
  transition: transform 0.5s var(--tl-ease);
}

.tl-row:hover .tl-shift {
  transform: translateX(0.625rem);
}

.tl-heading {
  font-size: var(--tl-title-size);
  font-weight: 500;
  line-height: 1.5;
  text-wrap: pretty;
}

.tl-link,
.tl-link .tl-shift {
  display: block;
}

/*
 * 行のどこを押してもリンクになるよう、タイトルのリンクを行全体へ広げる。
 * 触れた行の文字や矢印は動く間リンクより手前に描かれるので、リンク以外はポインターを素通しにする
 */
.tl-link::after {
  content: "";
  position: absolute;
  inset: 0;
}

.tl-row > * {
  pointer-events: none;
}

.tl-link,
.tl-themes a {
  pointer-events: auto;
}

.tl-link:focus-visible {
  outline: none;
}

.tl-row:has(.tl-link:focus-visible) {
  outline: 2px solid var(--tl-go);
  outline-offset: 4px;
  border-radius: 0.5rem;
}

/* 登壇したイベント名や、寄稿先の名前 */
.tl-context {
  margin-top: 0.25rem;
  font-size: 0.8125rem;
  line-height: 1.7;
}

.tl-description {
  margin-top: 0.375rem;
  max-width: 46em;
  color: var(--tl-muted);
  font-size: 0.875rem;
  line-height: 1.8;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  overflow: hidden;
}

.tl-meta {
  grid-column: 1 / -1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.125rem 0.875rem;
  font-size: 0.8125rem;
}

.tl-kind {
  display: inline-flex;
  align-items: center;
  height: 1.75rem;
  padding: 0 0.75rem;
  border: 1px solid var(--tl-line);
  border-radius: 999px;
}

/* テーマは色の点を付けず、静かな文字で並べる。狭い画面では斜線で区切る。行を覆うリンクより手前に置く */
.tl-themes {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  color: var(--tl-muted);
}

.tl-themes li + li::before {
  content: "/";
  margin: 0 0.5rem;
  opacity: 0.5;
}

.tl-themes a {
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: 2rem;
  transition: color 0.3s;
}

.tl-themes a:hover,
.tl-themes a:focus-visible {
  color: var(--tl-ink);
}

/* 画面に入ってくる行は下から少し上がり、見出しは 1 文字ずつせり上がる */
.tl.is-watching .tl-row:not(.is-in) {
  opacity: 0.2;
  transform: translateY(2.25rem);
}

.tl.is-watching .tl-row:not(.is-in)::before {
  transform: scaleX(0);
}

.tl.is-watching .tl-title:not(.is-in) span {
  transform: translateY(110%);
}

@media (min-width: 861px) {
  .tl-year {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    border-top: 1px solid var(--tl-ink);
  }

  .tl-year-label {
    position: sticky;
    top: 1.5rem;
    align-self: start;
    padding-top: 1.5rem;
    border-top: 0;
  }

  /* 日付、タイトルと概要、種類とテーマ、矢印を横に並べる */
  .tl-row {
    grid-template-columns: 4.5rem minmax(0, 1fr) auto auto;
    align-items: start;
    gap: 0 clamp(1rem, 2.8vw, 2.5rem);
    padding: clamp(1.375rem, 2.4vw, 2.125rem) 0;
  }

  .tl-row::after {
    inset: 0 -1.5rem;
  }

  /* 年の先頭の行は、年の区切りの線がすぐ上にある */
  .tl-rows > .tl-row:first-child::before {
    content: none;
  }

  .tl-date {
    grid-area: auto;
    line-height: var(--tl-first-line);
  }

  .tl-body {
    grid-column: auto;
  }

  .tl-meta {
    grid-column: auto;
    flex-direction: column;
    flex-wrap: nowrap;
    align-items: flex-end;
    gap: 0.375rem;
    min-width: 6.5rem;
    padding-top: calc((var(--tl-first-line) - 1.75rem) / 2);
  }

  .tl-themes {
    flex-direction: column;
    align-items: flex-end;
  }

  .tl-themes li + li::before {
    content: none;
  }

  .tl-themes a {
    min-height: 1.625rem;
  }

  /* テーマに触れると、ドット絵の 1 マスのような四角が、そのテーマの色で現れる */
  .tl-themes a::before {
    content: "";
    position: absolute;
    right: calc(100% + 0.5rem);
    top: 50%;
    width: 0.375rem;
    height: 0.375rem;
    margin-top: -0.1875rem;
    background: var(--tl-theme);
    transform: scale(0);
    transition: transform 0.3s var(--tl-ease);
  }

  .tl-themes a:hover::before,
  .tl-themes a:focus-visible::before {
    transform: scale(1);
  }

  .tl-go {
    grid-area: auto;
    width: 3rem;
    height: 3rem;
    margin-top: calc((var(--tl-first-line) - 3rem) / 2);
  }
}

@media (prefers-reduced-motion: reduce) {
  .tl-row,
  .tl-row::before,
  .tl-row::after,
  .tl-title span,
  .tl-shift,
  .tl-go,
  .tl-themes a::before {
    transition: none;
  }
}
</style>

<script>
const watch = (): void => {
  const timeline = document.querySelector<HTMLElement>('[data-timeline]');
  if (!timeline) return;
  if (
    !('IntersectionObserver' in window)
    || window.matchMedia('(prefers-reduced-motion: reduce)').matches
  ) {
    return;
  }
  const observer = new IntersectionObserver(
    (entries) => {
      // 同時に画面へ入った行は、上から順に少しずつ遅らせて見せる
      let order = 0;
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        if (entry.target instanceof HTMLElement) {
          entry.target.style.setProperty('--n', String(order));
          order += 1;
        }
        entry.target.classList.add('is-in');
        observer.unobserve(entry.target);
      }
    },
    { rootMargin: '0px 0px -6% 0px' },
  );
  // 戻ってきたときなど、すでに画面に入っているものや通り過ぎたものは、隠してから出し直さない
  const waiting: Element[] = [];
  timeline.querySelectorAll('[data-timeline-reveal]').forEach((target) => {
    if (target.getBoundingClientRect().top < window.innerHeight) {
      target.classList.add('is-in');
    } else {
      waiting.push(target);
    }
  });
  timeline.classList.add('is-watching');
  waiting.forEach((target) => observer.observe(target));
};

document.addEventListener('astro:page-load', watch);
</script>
