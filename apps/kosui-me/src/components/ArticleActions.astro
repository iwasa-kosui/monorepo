---
/**
 * 記事のタイトルの下に置く、控えめな操作の列。
 * はてなブックマーク（件数つき）と、Markdown の原文へのリンクだけを出す。
 * ほかのシェア先は、読み終えた位置にある ShareButtons に任せる。
 */
interface Props {
  title: string;
  url: string;
  markdownUrl: string;
  /** 限定公開の記事では、シェアの導線を出さない */
  shareable?: boolean;
}

const { title, url, markdownUrl, shareable = true } = Astro.props;
---

<div
  class="article-actions"
  data-share-buttons
  data-page-title={title}
  data-page-url={url}
>
  {
    shareable && (
      <a
        data-share="hatena"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="はてなブックマークに追加"
        class="article-action"
      >
        <span class="article-action-hatena" aria-hidden="true">B!</span>
        <span data-hatena-count class="article-action-count hidden">0</span>
        <span class="article-action-label">ブックマーク</span>
      </a>
    )
  }
  <a href={markdownUrl} class="article-action" aria-label="Markdownとして表示">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
      <polyline points="14 2 14 8 20 8" />
      <line x1="9" y1="13" x2="15" y2="13" />
      <line x1="9" y1="17" x2="15" y2="17" />
    </svg>
    <span>Markdown</span>
  </a>
</div>

<style>
.article-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.article-action {
  --action-ink: #4b526d;
  --action-line: rgb(31 39 64 / 0.14);
  --action-fill: rgb(255 255 255 / 0.5);
  --action-fill-hover: rgb(255 255 255 / 0.85);

  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  height: 2rem;
  padding: 0 0.75rem;
  border: 1px solid var(--action-line);
  border-radius: 9999px;
  background-color: var(--action-fill);
  color: var(--action-ink);
  font-size: 0.8125rem;
  font-weight: 500;
  line-height: 1;
  white-space: nowrap;
  transition: background-color 0.2s, border-color 0.2s, color 0.2s;
}

.article-action:hover {
  border-color: var(--color-accent);
  background-color: var(--action-fill-hover);
  color: var(--color-accent-dark);
}

.article-action:focus-visible {
  outline: 2px solid var(--color-accent);
  outline-offset: 2px;
}

.article-action svg {
  width: 0.875rem;
  height: 0.875rem;
}

.article-action-hatena {
  color: #008fde;
  font-weight: 800;
  letter-spacing: -0.02em;
}

.article-action-count {
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

/* 件数が出ているときは、件数がラベルの代わりになる */
.article-action-count:not(.hidden) + .article-action-label {
  display: none;
}

@media (prefers-color-scheme: dark) {
  .article-action {
    --action-ink: #b3bacb;
    --action-line: rgb(255 255 255 / 0.16);
    --action-fill: rgb(255 255 255 / 0.05);
    --action-fill-hover: rgb(255 255 255 / 0.1);
  }

  .article-action:hover {
    border-color: var(--color-accent-light);
    color: var(--color-accent-light);
  }

  .article-action-hatena {
    color: #4db8f0;
  }
}

@media print {
  .article-actions {
    display: none;
  }
}
</style>

<script>
import './shareButtonsClient';
</script>
