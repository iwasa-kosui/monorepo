---
/**
 * 記事や登壇のカードに付けるテーマの名前。トップページのタイムラインと同じ見せ方にする。
 * 色の点は付けず、静かな文字を斜線で区切って並べる。触れたときだけ、斜線の位置に
 * ドット絵の 1 マスのような四角がそのテーマの色で現れる。
 */
import { getTheme } from '@/config/themes';

interface Props {
  theme: string;
  linked?: boolean;
  size?: 'sm' | 'md';
}

const { theme, linked = true, size = 'sm' } = Astro.props;
const themeData = getTheme(theme);
const color = themeData?.color ?? 'currentColor';
const displayName = themeData?.name ?? theme;
const Tag = linked ? 'a' : 'span';
---

<Tag
  class:list={['theme-label', size === 'md' && 'is-md']}
  href={linked ? `/themes/${theme}` : undefined}
  style={`--theme-label: ${color}`}
>
  {displayName}
</Tag>

<style>
.theme-label {
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: 1.75rem;
  color: var(--color-subtle);
  font-size: 0.75rem;
  line-height: 1.5;
  transition: color 0.3s;
}

.theme-label.is-md {
  font-size: 0.875rem;
}

/* 2 つ目からは、前のテーマとの間に斜線を置く。並べる側の隙間と合わせて 1.25rem ほど空く */
.theme-label:not(:first-child) {
  padding-left: 0.875rem;
}

.theme-label:not(:first-child)::before {
  content: "/";
  position: absolute;
  left: 0;
  width: 0.5rem;
  text-align: center;
  opacity: 0.5;
  transition: opacity 0.3s;
}

@media (prefers-color-scheme: dark) {
  .theme-label {
    color: #9ca3af;
  }
}

@media (hover: hover) {
  a.theme-label::after {
    content: "";
    position: absolute;
    left: -0.6875rem;
    top: 50%;
    width: 0.375rem;
    height: 0.375rem;
    margin-top: -0.1875rem;
    background: var(--theme-label);
    transform: scale(0);
    transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* 斜線のあるところでは、斜線と入れ替わる */
  a.theme-label:not(:first-child)::after {
    left: 0.0625rem;
  }

  a.theme-label:hover,
  a.theme-label:focus-visible {
    color: var(--color-charcoal);
  }

  a.theme-label:hover::before,
  a.theme-label:focus-visible::before {
    opacity: 0;
  }

  a.theme-label:hover::after,
  a.theme-label:focus-visible::after {
    transform: scale(1);
  }
}

@media (hover: hover) and (prefers-color-scheme: dark) {
  a.theme-label:hover,
  a.theme-label:focus-visible {
    color: #f3f4f6;
  }
}

@media (prefers-reduced-motion: reduce) {
  .theme-label,
  .theme-label::before,
  .theme-label::after {
    transition: none;
  }
}
</style>
