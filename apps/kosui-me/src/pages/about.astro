---
import ShoreTitle from '@/components/ShoreTitle/ShoreTitle.astro';
import SiteIcon from '@/components/SiteIcon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { StructuredData } from '@/utils/structuredData';
import externalArticlesData from '../content/external-articles/data.json';
import talksData from '../content/talks/data.json';

type TalkMeta = {
  title: string;
  date: string;
  event: string;
  themes: string[];
  duration: string;
  description: string;
  year: string;
  name: string;
  slideType: string;
};

type ExternalArticleMeta = {
  title: string;
  url: string;
  date: string;
  publisher: string;
  description?: string;
  themes: string[];
};

const talkGroups = (talksData as TalkMeta[])
  .filter((t) => t.event !== '社内LT')
  .sort((a, b) => b.date.localeCompare(a.date))
  .reduce<{ year: string; talks: TalkMeta[] }[]>((groups, talk) => {
    const last = groups.at(-1);
    if (last && last.year === talk.year) {
      last.talks.push(talk);
    } else {
      groups.push({ year: talk.year, talks: [talk] });
    }
    return groups;
  }, []);
const externalArticles = (externalArticlesData as ExternalArticleMeta[]).slice(
  0,
  3,
);

const careers = [
  {
    period: '2022 - 現在',
    org: '株式会社カケハシ',
    role: 'テックリード',
    description:
      '認証認可・組織管理など共通基盤の設計・開発。TypeScriptと関数型プログラミングで堅牢なプラットフォームを構築。',
    highlights: [
      '全社統一の認証基盤を構築し、6つ以上のプロダクトの移行を統括して、ログイン周辺の可用性99.95%を達成。',
      '組織管理基盤で、スコープの見直しにより4ヶ月の前倒し提供を実現。',
      '端末・ライセンス管理で、運用チーム間の認識ずれに起因する障害ゼロを達成。',
    ],
  },
  {
    period: '2019 - 2022',
    org: '株式会社ディー・エヌ・エー',
    role: 'Webエンジニア',
    description: 'タクシー配車アプリ「MOV」(現: GO) の業務管理システム開発。',
  },
];

const education = [
  {
    period: '2017 - 2019',
    org: '東京農工大学大学院 工学府',
    description:
      '人工知能・マルチエージェントシステム・自然言語処理を研究。修士（工学）取得。',
  },
  {
    period: '2013 - 2017',
    org: '東京農工大学 工学部 情報工学科',
    description: '学士（工学）取得。',
  },
];

const publications = [
  {
    venue: 'EACL 2021',
    title: 'Dialogue Act-based Breakdown Detection in Negotiation Dialogues',
    authors: ['Atsuki Yamaguchi', 'Kosui Iwasa', 'Katsuhide Fujita'],
    url: 'https://aclanthology.org/2021.eacl-main.63/',
    citations: 31,
  },
  {
    venue: 'WWW 2019 (Demo)',
    title:
      'Can You Give Me a Reason?: Argument-inducing Online Forum by Argument Mining',
    authors: [
      'Makiko Ida',
      'Gaku Morio',
      'Kosui Iwasa',
      'Takaki Yasui',
      'Tomoyuki Tatsumi',
      'Katsuhide Fujita',
    ],
    url: 'https://doi.org/10.1145/3308558.3314127',
    citations: 9,
  },
  {
    venue: 'PRICAI 2018',
    title: 'Prediction of Nash Bargaining Solution in Negotiation Dialogue',
    authors: ['Kosui Iwasa', 'Katsuhide Fujita'],
    url: 'https://doi.org/10.1007/978-3-319-97304-3_60',
    citations: 5,
  },
];

const socials = [
  {
    label: 'X',
    href: 'https://x.com/kosui_me',
    path:
      'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    label: 'Fediverse',
    href: 'https://blog.kosui.me/users/kosui',
    path:
      'M23.268 5.313c-.35-2.578-2.617-4.61-5.304-5.004C17.51.242 15.792 0 11.813 0h-.03c-3.98 0-4.835.242-5.288.309C3.882.692 1.496 2.518.917 5.127.64 6.412.61 7.837.661 9.143c.074 1.874.088 3.745.26 5.611.118 1.24.325 2.47.62 3.68.55 2.237 2.777 4.098 4.96 4.857 2.336.792 4.849.923 7.256.38.265-.061.527-.132.786-.213.585-.184 1.27-.39 1.774-.753a.057.057 0 0 0 .023-.043v-1.809a.052.052 0 0 0-.02-.041.053.053 0 0 0-.046-.01 20.282 20.282 0 0 1-4.709.547c-2.73 0-3.463-1.284-3.674-1.818a5.593 5.593 0 0 1-.319-1.433.053.053 0 0 1 .066-.054 19.648 19.648 0 0 0 4.622.536c.164 0 .329 0 .494-.003.9-.024 1.848-.07 2.737-.203.027-.004.054-.01.08-.016 2.394-.436 4.674-1.774 4.907-5.228.009-.147.023-.646.023-.801 0-.245.062-2.462-.01-3.76zm-3.365 8.377h-2.291V7.886c0-1.198-.504-1.805-1.512-1.805-1.115 0-1.673.721-1.673 2.147v3.015h-2.278V8.228c0-1.426-.558-2.147-1.673-2.147-1.008 0-1.512.607-1.512 1.805v5.804H6.673V7.715c0-1.198.304-2.151.916-2.858.63-.707 1.457-1.07 2.482-1.07 1.187 0 2.087.455 2.686 1.366l.578.97.579-.97c.599-.911 1.499-1.366 2.686-1.366 1.025 0 1.852.363 2.482 1.07.612.707.916 1.66.916 2.858z',
  },
  {
    label: 'Bluesky',
    href: 'https://bsky.app/profile/kosui.me',
    path:
      'M12 10.8c-1.087-2.114-4.046-6.053-6.798-7.995C2.566.944 1.561 1.266.902 1.565.139 1.908 0 3.08 0 3.768c0 .69.378 5.65.624 6.479.785 2.627 3.584 3.493 6.173 3.16-.388.543-.247 1.596.744 2.508-2.404.26-5.098 1.408-2.36 4.928C7.307 23.942 11.3 23.17 12 20.2c.7 2.97 4.693 3.742 6.819.643 2.738-3.52.044-4.668-2.36-4.928.991-.912 1.132-1.965.744-2.508 2.59.333 5.388-.533 6.173-3.16.246-.828.624-5.79.624-6.479 0-.688-.139-1.86-.902-2.203-.659-.3-1.664-.62-4.3 1.24C16.046 4.748 13.087 8.687 12 10.8z',
  },
  {
    label: 'GitHub',
    href: 'https://github.com/iwasa-kosui',
    path:
      'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z',
  },
];

function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('ja-JP', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}

function formatMonthDay(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('en-US', {
    timeZone: 'Asia/Tokyo',
    month: 'numeric',
    day: 'numeric',
  });
}
---

<BaseLayout
  title="About - kosui"
  ogTitle="About"
  ogDescription="医療SaaSの品質要求に応えるアーキテクチャ設計とプラットフォーム構築を専門とするテックリード。"
  jsonLd={[StructuredData.person()]}
>
  <ShoreTitle slot="eyecatch" title="About" transitionName="about-title">
    <Fragment slot="meta">テックリード @ 株式会社カケハシ</Fragment>
  </ShoreTitle>

  <article class="article-paper about">
    <section class="about-profile">
      <SiteIcon
        size={72}
        alt="kosui"
        class="ring-2 ring-accent/20 flex-shrink-0"
      />
      <div>
        <h2 class="about-name">
          岩佐 幸翠 <span class="about-handle">/ kosui</span>
        </h2>
        <p class="about-text">
          医療SaaS企業にて、法令要件や顧客環境の分析からアーキテクチャ設計までを一貫して担い、認証認可・組織管理などの共通基盤をテックリードとして設計・開発しています。プロダクトチームがコアドメインに集中できるプラットフォームの構築と、関数型ドメインモデリングによる堅牢なシステム設計を実践しています。
        </p>
        <ul class="about-social">
          {
            socials.map((social) => (
              <li>
                <a
                  href={social.href}
                  target="_blank"
                  rel="noopener noreferrer me"
                  class="about-social-link"
                >
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d={social.path} />
                  </svg>
                  <span>{social.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="about-section">
      <h2 class="about-heading">経歴</h2>
      <ul>
        {
          careers.map((item) => (
            <li class="about-row">
              <span class="about-lead">{item.period}</span>
              <div class="about-body">
                <p class="about-org">{item.org}</p>
                <p class="about-role">{item.role}</p>
                <p class="about-text">{item.description}</p>
                {
                  item.highlights && (
                    <ul class="about-highlights">
                      {item.highlights.map((highlight) => <li>{highlight}</li>)}
                    </ul>
                  )
                }
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-section">
      <h2 class="about-heading">学歴</h2>
      <ul>
        {
          education.map((item) => (
            <li class="about-row">
              <span class="about-lead">{item.period}</span>
              <div class="about-body">
                <p class="about-org">{item.org}</p>
                <p class="about-text">{item.description}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="about-section">
      <h2 class="about-heading">論文</h2>
      <ul>
        {
          publications.map((publication) => (
            <li class="about-row about-row-plain">
              <p class="about-meta">
                <strong>{publication.venue}</strong>
                <span>被引用数 {publication.citations}</span>
              </p>
              <a
                href={publication.url}
                target="_blank"
                rel="noopener noreferrer"
                class="about-link"
              >
                {publication.title}
              </a>
              <p class="about-text">
                {
                  publication.authors.map((author, index) => [
                index > 0 ? ', ' : '',
                author === 'Kosui Iwasa' ? (
                    <strong>{author}</strong>
                  ) : author,
              ])
                }
              </p>
            </li>
          ))
        }
      </ul>
      <p class="about-note">
        被引用数は <a
          href="https://scholar.google.com/citations?user=DaujMhUAAAAJ&hl=ja"
          target="_blank"
          rel="noopener noreferrer"
        >Google Scholar</a> による（2026年11月時点）
      </p>
    </section>

    <section class="about-section">
      <h2 class="about-heading">登壇</h2>
      {
        talkGroups.map((group) => (
          <section class="about-year-group">
            <h3 class="about-year">{group.year}</h3>
            <ul>
              {
                group.talks.map((talk) => (
                  <li class="about-row about-row-talk">
                    <time class="about-lead" datetime={talk.date}>
                      {formatMonthDay(talk.date)}
                    </time>
                    <div class="about-body">
                      <p class="about-meta">
                        <strong>{talk.event}</strong>
                        {talk.duration && <span>{talk.duration}</span>}
                      </p>
                      <a
                        href={`/talks/${talk.year}/${talk.name}`}
                        class="about-link"
                      >
                        {talk.title}
                      </a>
                    </div>
                  </li>
                ))
              }
            </ul>
          </section>
        ))
      }
      <a href="/talks" class="about-more">すべて見る &rarr;</a>
    </section>

    <section class="about-section">
      <h2 class="about-heading">記事</h2>
      <ul>
        {
          externalArticles.map((article) => (
            <li class="about-row">
              <time class="about-lead" datetime={article.date}>
                {formatDate(article.date)}
              </time>
              <div class="about-body">
                <p class="about-meta">
                  <strong>{article.publisher}</strong>
                </p>
                <a
                  href={article.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="about-link"
                >
                  {article.title}
                </a>
              </div>
            </li>
          ))
        }
      </ul>
      <a href="/posts" class="about-more">すべて見る &rarr;</a>
    </section>
  </article>
</BaseLayout>

<style>
.about {
  --about-ink: #1f2740;
  --about-muted: #4b526d;
  --about-line: rgba(31, 39, 64, 0.16);
  --about-go: #ee7b6f;
  color: var(--about-ink);
}

@media (prefers-color-scheme: dark) {
  .about {
    --about-ink: #f3f1ee;
    --about-muted: #b3bacb;
    --about-line: rgba(243, 241, 238, 0.18);
    --about-go: #f47f70;
  }
}

.about-profile {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
}

.about-name {
  font-size: 1.5rem;
  font-weight: 500;
  letter-spacing: -0.01em;
  line-height: 1.4;
}

.about-handle {
  color: var(--about-muted);
  font-size: 1rem;
  font-weight: 400;
}

.about-social {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(9.5rem, 1fr));
  gap: 0.75rem;
  margin-top: 1.25rem;
}

.about-social-link {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  min-height: 2.75rem;
  padding: 0.5rem 0.875rem;
  border-radius: 0.5rem;
  background: color-mix(in srgb, var(--about-ink) 8%, transparent);
  font-size: 1rem;
  font-weight: 500;
  line-height: 1.4;
  transition: background-color 0.3s;
}

.about-social-link svg {
  flex-shrink: 0;
  width: 1.5rem;
  height: 1.5rem;
}

.about-social-link:hover {
  background: color-mix(in srgb, var(--about-ink) 15%, transparent);
}

.about-social-link:focus-visible {
  outline: 2px solid var(--about-go);
  outline-offset: 2px;
}

.about-section {
  margin-top: 4rem;
}

.about-heading {
  margin-bottom: 1.75rem;
  font-size: clamp(1.5rem, 1.2rem + 1.2vw, 1.875rem);
  font-weight: 500;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.about-year-group + .about-year-group {
  margin-top: 2rem;
}

.about-year {
  margin-bottom: 1.25rem;
  color: var(--about-muted);
  font-size: 1.125rem;
  font-weight: 400;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

.about-row {
  display: grid;
  grid-template-columns: 6.5rem minmax(0, 1fr);
  gap: 0 1rem;
}

.about-row + .about-row {
  margin-top: 1.25rem;
}

.about-row-talk {
  grid-template-columns: 3.5rem minmax(0, 1fr);
}

.about-row-plain {
  display: block;
}

.about-lead {
  color: var(--about-muted);
  font-size: 0.9375rem;
  font-variant-numeric: tabular-nums;
  line-height: 1.5;
}

.about-body {
  min-width: 0;
}

.about-org {
  font-size: 1rem;
  font-weight: 500;
  line-height: 1.5;
}

.about-role {
  color: var(--about-go);
  font-size: 0.8125rem;
  font-weight: 500;
}

.about-text {
  margin-top: 0.375rem;
  color: var(--about-muted);
  font-size: 0.875rem;
  line-height: 1.8;
}

.about-text strong {
  color: var(--about-ink);
  font-weight: 700;
}

.about-profile .about-text {
  margin-top: 0.5rem;
}

.about-highlights {
  margin-top: 0.5rem;
  padding-left: 1.125rem;
  list-style: disc;
  color: var(--about-muted);
  font-size: 0.8125rem;
  line-height: 1.8;
}

.about-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0 0.875rem;
  color: var(--about-muted);
  font-size: 0.8125rem;
  font-variant-numeric: tabular-nums;
  line-height: 1.7;
}

.about-meta strong {
  color: var(--about-ink);
  font-weight: 600;
}

.about-link {
  display: block;
  font-size: 1rem;
  font-weight: 500;
  line-height: 1.6;
  text-decoration: underline;
  text-decoration-color: var(--about-line);
  text-decoration-thickness: 1px;
  text-underline-offset: 0.25em;
  text-wrap: pretty;
  transition: text-decoration-color 0.3s;
}

.about-link:hover,
.about-link:focus-visible {
  text-decoration-color: var(--about-go);
}

.about-link:focus-visible,
.about-more:focus-visible,
.about-note a:focus-visible {
  outline: 2px solid var(--about-go);
  outline-offset: 4px;
  border-radius: 0.25rem;
}

.about-note {
  margin-top: 1.25rem;
  color: var(--about-muted);
  font-size: 0.75rem;
  line-height: 1.6;
}

.about-note a {
  text-decoration: underline;
  text-decoration-color: var(--about-line);
  text-underline-offset: 0.25em;
}

.about-note a:hover,
.about-note a:focus-visible {
  text-decoration-color: var(--about-go);
}

.about-more {
  display: inline-block;
  margin-top: 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  text-decoration: underline;
  text-decoration-color: var(--about-line);
  text-underline-offset: 0.25em;
}

.about-more:hover {
  text-decoration-color: var(--about-go);
}

@media (max-width: 640px) {
  .about-row,
  .about-row-talk {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.25rem;
  }

  .about-profile {
    flex-direction: column;
  }
}
</style>
