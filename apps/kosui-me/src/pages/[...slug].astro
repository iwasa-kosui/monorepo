---
import AuthorCard from '@/components/AuthorCard.astro';
import ContentWarningModal from '@/components/ContentWarningModal.astro';
import Figure from '@/components/Figure.astro';
import MarkdownSourceLink from '@/components/MarkdownSourceLink.astro';
import RelatedArticles from '@/components/RelatedArticles.astro';
import ShoreBackdrop from '@/components/ShoreBackdrop/ShoreBackdrop.astro';
import ShoreTitle from '@/components/ShoreTitle/ShoreTitle.astro';
import ShareButtons from '@/components/ShareButtons.astro';
import ThemeHubLinks from '@/components/ThemeHubLinks.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { StructuredData } from '@/utils/structuredData';
import { type CollectionEntry, getCollection, render } from 'astro:content';

type PostEntry = CollectionEntry<'posts'>;

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post: PostEntry) => ({
    params: { slug: post.data.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: PostEntry };
const { Content } = await render(post);
const isPrivate = post.data.private === true;
const isDraft = post.data.draft === true;

function formatDate(dateStr: string): string {
  const date = new Date(dateStr);
  return date.toLocaleDateString('ja-JP', {
    timeZone: 'Asia/Tokyo',
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
  });
}

const slugFileName = post.data.slug.replace(/\//g, '-');
const ogImage = `https://kosui.me/og/${slugFileName}.png`;
const pageUrl = `https://kosui.me/${post.data.slug}`;
const markdownUrl = `/${post.data.slug}.md`;
// Keystatic は空欄を空文字で保存するので、空文字は更新なしとして扱う。
const updatedDate = post.data.updatedDate || undefined;
// 公開日と同じ日の修正は、読者に「更新」として見せない。
const updatedLabel = updatedDate !== undefined
    && formatDate(updatedDate) !== formatDate(post.data.date)
  ? formatDate(updatedDate)
  : undefined;
const jsonLd = isPrivate || isDraft ? [] : [
  StructuredData.blogPosting({
    url: pageUrl,
    title: post.data.title,
    image: ogImage,
    publishedTime: post.data.date,
    ...(updatedDate ? { modifiedTime: updatedDate } : {}),
    ...(post.data.description ? { description: post.data.description } : {}),
  }),
];
---

<BaseLayout
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  ogImage={ogImage}
  ogUrl={pageUrl}
  ogType="article"
  authorUrl="https://www.hatena.ne.jp/kosui_me/"
  noindex={isPrivate || isDraft}
  publishedTime={post.data.date}
  {...(updatedDate ? { modifiedTime: updatedDate } : {})}
  jsonLd={jsonLd}
>
  <ShoreBackdrop slot="backdrop" afterHero />

  <ShoreTitle
    slot="eyecatch"
    title={post.data.title}
    transitionName={`post-title-${post.data.slug}`}
  >
    <Fragment slot="meta">
      <time datetime={post.data.date}>{formatDate(post.data.date)}</time>
      {
        updatedLabel && (
          <span class="ml-2">
            （更新:
            <time datetime={updatedDate}>{updatedLabel}</time>）
          </span>
        )
      }
    </Fragment>
  </ShoreTitle>

  <article
    class="article-paper"
    data-pagefind-body
    data-pagefind-meta={`type:post`}
    {...(isPrivate ? { 'data-pagefind-ignore': 'all' } : {})}
  >
    <header class="mb-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <AuthorCard compact />
        {!isPrivate && <ShareButtons title={post.data.title} url={pageUrl} />}
      </div>
      <div class="mt-4">
        <MarkdownSourceLink href={markdownUrl} />
      </div>
    </header>
    {
      isPrivate && (
        <div class="mb-6 px-4 py-3 bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-700/50 rounded-clay shadow-clay dark:shadow-clay-dark">
          <p class="text-sm text-amber-800 dark:text-amber-200">
            この記事は限定公開です。検索エンジンやRSSフィードには掲載されません。
          </p>
        </div>
      )
    }
    <div class="prose">
      <Content components={{ Figure }} />
    </div>
    {
      !isPrivate && (
        <section class="mt-12 flex flex-col items-center gap-4">
          <ShareButtons title={post.data.title} url={pageUrl} />
          <MarkdownSourceLink href={markdownUrl} />
        </section>
      )
    }
    {
      isPrivate && (
        <section class="mt-12 flex justify-center">
          <MarkdownSourceLink href={markdownUrl} />
        </section>
      )
    }
  </article>

  {
    !isPrivate && post.data.themes && post.data.themes.length > 0
      && (
      <section class="mt-8 mb-8">
        <ThemeHubLinks themes={post.data.themes} />
      </section>
    )
  }

  {
    !isPrivate && post.data.themes && post.data.themes.length > 0
      && (
      <RelatedArticles currentSlug={post.data.slug} themes={post.data.themes} />
    )
  }

  <section class="p-4 bg-card dark:bg-[#1f2435] rounded-clay shadow-clay dark:shadow-clay-dark">
    <AuthorCard />
  </section>

  <ContentWarningModal isDraft={isDraft} />

  <script>
  document.addEventListener('astro:page-load', async () => {
    const mermaidElements = document.querySelectorAll<HTMLPreElement>(
      'pre.mermaid',
    );
    if (mermaidElements.length > 0) {
      const { default: mermaid } = await import('mermaid');
      mermaid.initialize({ startOnLoad: false, theme: 'neutral' });
      await mermaid.run({ nodes: mermaidElements });
    }
  });
  </script>
</BaseLayout>
