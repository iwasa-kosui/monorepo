---
import type { AdrOption } from './adr-options';
import AdrOptionTabs from './AdrOptionTabs.astro';

type Props = {
  readonly criteria: readonly string[];
  readonly options: readonly AdrOption[];
  readonly choosable?: boolean;
};

const { criteria, options, choosable = false } = Astro.props;
if (choosable && options.some((option) => option.id === undefined)) {
  throw new Error('選べる案の一覧では、すべての案に id が必要です');
}

const initial = choosable ? 0 : Math.max(
  0,
  options.findIndex((option) => option.adopted === true),
);
---

<div class="adr-options" data-adr-options>
  <AdrOptionTabs
    options={options}
    criteria={criteria}
    choosable={choosable}
    mode="document"
    label="検討した案"
    initial={initial}
  />
</div>

<style>
.adr-options {
  container-type: inline-size;
  margin-top: var(--space-1);
  font-size: var(--text-code);
  line-height: var(--leading-tight);
}
</style>
