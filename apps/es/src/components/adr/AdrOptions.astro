---
import { reviewLabels } from '../../workspace/choice';
import { richHtml } from '../figures/rich';

type Mark = '○' | '△' | '×';
type Option = {
  readonly id?: string;
  readonly name: string;
  readonly adopted?: boolean;
  readonly marks: readonly Mark[];
  readonly merit: string;
  readonly demerit: string;
};
type Reviewer = {
  readonly name: string;
  readonly avatar: string;
  readonly tone: string;
};
type Props = {
  readonly id: string;
  readonly criteria: readonly string[];
  readonly options: readonly Option[];
  readonly choosable?: boolean;
  readonly reviews?: Readonly<Record<string, readonly string[]>>;
  readonly reviewer?: Reviewer;
};

const { id, criteria, options, choosable = false, reviews, reviewer } =
  Astro.props;
if (choosable && options.some((option) => option.id === undefined)) {
  throw new Error('選べる案の一覧では、すべての案に id が必要です');
}
if (
  choosable
  && (reviewer === undefined
    || options.some((option) => reviews?.[option.id ?? ''] === undefined))
) {
  throw new Error(
    '選べる案の一覧では、すべての案にレビューと、レビューした人が必要です',
  );
}

const headRem = 1;
const emWidth = (text: string): number =>
  text.split('`').reduce(
    (sum, part, index) => sum + part.length * (index % 2 === 1 ? 0.6 : 1),
    0,
  );
const columnRem = (text: string): number =>
  Math.max(4, Math.ceil((emWidth(text) / 2 + 1) * headRem * 4) / 4);
const columns = criteria.map((criterion) => `${columnRem(criterion)}rem`).join(
  ' ',
);

const selected = choosable ? -1 : Math.max(
  0,
  options.findIndex((option) => option.adopted === true),
);
const meaning: Record<Mark, string> = {
  '○': '満たす',
  '△': '一部だけ満たす',
  '×': '満たさない',
};
---

<div class="adr-options" data-adr-options style={`--adr-columns:${columns}`}>
  {
    options.map((option, index) => (
      <input
        class="adr-sr"
        type="radio"
        name={`${id}-option`}
        id={`${id}-option-${index}`}
        checked={index === selected}
        data-option={choosable ? option.id : undefined}
        data-adopted={choosable && option.adopted === true ? 'true' : undefined}
      />
    ))
  }
  <div class="adr-body">
    <div class="adr-list">
      <div class="adr-head">
        <span>案</span>
        {criteria.map((criterion) => <span set:html={richHtml(criterion)} />)}
      </div>
      {
        options.map((option, index) => (
          <label
            class="adr-row"
            for={`${id}-option-${index}`}
            data-option-row={choosable ? '' : undefined}
          >
            <span class="adr-name">
              <span set:html={richHtml(option.name)} />
              {option.adopted === true && <span class="adr-badge">採用</span>}
              {
                choosable && (
                  <span class="adr-requested">{
                    reviewLabels['changes-requested']
                  }</span>
                )
              }
              {choosable && <span class="adr-badge adr-own">あなたの選択</span>}
            </span>
            {
              option.marks.map((mark) => (
                <span class="adr-mark" data-mark={mark}>
                  <span aria-hidden="true">{mark}</span>
                  <span class="adr-sr">{meaning[mark]}</span>
                </span>
              ))
            }
          </label>
        ))
      }
    </div>
    <div class="adr-detail">
      {
        options.map((option) => (
          <div class="adr-detail-item">
            <div class="adr-detail-row">
              <span class="adr-tag" data-kind="merit">利点</span>
              <span set:html={richHtml(option.merit)} />
            </div>
            <div class="adr-detail-row">
              <span class="adr-tag" data-kind="demerit">欠点</span>
              <span set:html={richHtml(option.demerit)} />
            </div>
          </div>
        ))
      }
    </div>
    {
      choosable && (
        <button type="button" class="adr-choose" data-choose disabled>
          この案でレビューを依頼する
        </button>
      )
    }
    {
      choosable && reviewer !== undefined && (
        <div class="adr-reviews-live" aria-live="polite">
          <ol class="adr-reviews" role="list" data-reviews>
            {
              options.map((option) => (
                <li
                  class="adr-review"
                  data-review-option={option.id}
                  hidden
                >
                  <div class="adr-review-head">
                    <span
                      class="adr-review-avatar"
                      data-tone={reviewer.tone}
                      aria-hidden="true"
                    >
                      {reviewer.avatar}
                    </span>
                    <span class="adr-review-who">{reviewer.name}</span>
                    <span
                      class="adr-review-state"
                      data-state={option.adopted === true
                      ? 'approved'
                      : 'changes-requested'}
                    >
                      {
                        reviewLabels[
                  option.adopted === true
                    ? 'approved'
                    : 'changes-requested'
                ]
                      }
                    </span>
                    <span
                      class="adr-review-target"
                      set:html={richHtml(option.name)}
                    />
                  </div>
                  {
                    (reviews?.[option.id ?? ''] ?? []).map((
              paragraph,
            ) => (
                      <p class="adr-review-text">{paragraph}</p>
                    ))
                  }
                </li>
              ))
            }
          </ol>
        </div>
      )
    }
  </div>
</div>

<style>
.adr-sr {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}
.adr-options {
  container-type: inline-size;
  margin-top: var(--space-1);
  font-size: var(--text-code);
  line-height: var(--leading-tight);
}
.adr-body {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  align-items: start;
  gap: var(--space-2);
}
.adr-list {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}
.adr-head,
.adr-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) var(--adr-columns);
  align-items: center;
  gap: var(--space-1);
}
.adr-head {
  align-items: end;
  padding-inline: var(--space-2);
  color: var(--role-muted);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
  text-align: center;
  text-wrap: balance;
  word-break: auto-phrase;
}
.adr-head > :first-child {
  text-align: left;
}
.adr-head :global(code) {
  font-size: inherit;
}
.adr-row {
  border-radius: var(--radius-md);
  padding: 0.125rem var(--space-2);
  cursor: pointer;
}
.adr-row:hover {
  background: var(--role-sunken);
}
.adr-name {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-1);
  word-break: auto-phrase;
}
.adr-badge {
  border-radius: var(--radius-sm);
  background: var(--role-ink-sub);
  padding: 0 var(--space-1);
  color: var(--role-on-strong);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.adr-own {
  display: none;
  background: var(--role-accent-soft);
  color: var(--role-accent-strong);
}
.adr-row[data-chosen] .adr-own {
  display: inline;
}
.adr-requested {
  display: none;
  border-radius: var(--radius-sm);
  background: var(--role-warning-soft);
  padding: 0 var(--space-1);
  color: var(--role-warning);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.adr-row[data-requested] .adr-requested {
  display: inline;
}
.adr-reviews {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin: 0;
  padding: 0;
  list-style: none;
}
.adr-review {
  border-radius: var(--radius-lg);
  background: var(--role-sunken);
  padding: var(--space-3) var(--space-4);
}
.adr-review[hidden] {
  display: none;
}
.adr-review-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-1) var(--space-2);
}
.adr-review-avatar {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: var(--radius-md);
  background: #4a5568;
  color: #ffffff;
  font-size: var(--text-note);
  font-weight: var(--weight-bold);
}
.adr-review-avatar[data-tone="rose"] {
  background: #c2344d;
}
.adr-review-avatar[data-tone="blue"] {
  background: #1264a3;
}
.adr-review-avatar[data-tone="green"] {
  background: #2e7d32;
}
.adr-review-avatar[data-tone="amber"] {
  background: #8a5a00;
}
.adr-review-avatar[data-tone="violet"] {
  background: #6b3fa0;
}
.adr-review-who {
  font-weight: var(--weight-bold);
}
.adr-review-state {
  border-radius: var(--radius-pill);
  background: var(--role-warning-soft);
  padding: 0 var(--space-3);
  color: var(--role-warning);
  font-size: var(--text-note);
  font-weight: var(--weight-bold);
  line-height: var(--leading-normal);
}
.adr-review-state[data-state="approved"] {
  background: var(--role-success);
  color: var(--role-on-accent);
}
.adr-review-target {
  flex-basis: 100%;
  color: var(--role-muted);
  font-size: var(--text-note);
  line-height: var(--leading-normal);
  word-break: auto-phrase;
}
.adr-review-text {
  margin: var(--space-2) 0 0;
  line-height: var(--leading-normal);
  overflow-wrap: anywhere;
}
:global(.panel[data-choice="pending"]) .adr-head,
:global(.panel[data-choice="pending"]) .adr-badge,
:global(.panel[data-choice="pending"]) .adr-mark {
  display: none;
}
:global(.panel[data-choice="pending"]) .adr-row {
  grid-template-columns: minmax(0, 1fr);
}
.adr-choose {
  justify-self: start;
  min-height: var(--tap-min);
  border: 0;
  border-radius: var(--radius-md);
  background: var(--role-accent);
  color: var(--role-on-accent);
  padding: 0 var(--space-4);
  font: inherit;
  font-size: var(--text-code);
  font-weight: var(--weight-bold);
  line-height: 1;
  cursor: pointer;
}
.adr-choose:disabled {
  background: var(--role-sunken);
  color: var(--role-muted);
  cursor: not-allowed;
}
.adr-mark {
  text-align: center;
  font-size: var(--text-code);
  line-height: 1.1;
}
.adr-mark[data-mark="○"] {
  color: var(--role-success);
}
.adr-mark[data-mark="△"] {
  color: var(--role-ink-sub);
}
.adr-mark[data-mark="×"] {
  color: var(--role-danger);
}
.adr-detail-item {
  display: none;
}
.adr-detail-row {
  margin-top: var(--space-1);
  line-height: var(--leading-normal);
}
.adr-tag {
  margin-right: var(--space-1);
  border-radius: var(--radius-sm);
  padding: 0 var(--space-1);
  font-size: var(--text-note);
}
.adr-tag[data-kind="merit"] {
  background: var(--role-success-soft);
  color: var(--role-success);
}
.adr-tag[data-kind="demerit"] {
  background: var(--role-danger-soft);
  color: var(--role-danger);
}
:global(.content)
  :global(.scene[data-scenario])
  :global(.doc-paper)
  .adr-options
  :global(code) {
  font-size: 0.9em;
}
.adr-options
  > input:nth-of-type(1):checked
  ~ .adr-body
  .adr-list
  > label:nth-of-type(1),
.adr-options
  > input:nth-of-type(2):checked
  ~ .adr-body
  .adr-list
  > label:nth-of-type(2),
.adr-options
  > input:nth-of-type(3):checked
  ~ .adr-body
  .adr-list
  > label:nth-of-type(3),
.adr-options
  > input:nth-of-type(4):checked
  ~ .adr-body
  .adr-list
  > label:nth-of-type(4),
.adr-options
  > input:nth-of-type(5):checked
  ~ .adr-body
  .adr-list
  > label:nth-of-type(5),
.adr-options
  > input:nth-of-type(6):checked
  ~ .adr-body
  .adr-list
  > label:nth-of-type(6),
.adr-options
  > input:nth-of-type(7):checked
  ~ .adr-body
  .adr-list
  > label:nth-of-type(7),
.adr-options
  > input:nth-of-type(8):checked
  ~ .adr-body
  .adr-list
  > label:nth-of-type(8) {
  background: var(--role-accent-soft);
}
.adr-options
  > input:nth-of-type(1):focus-visible
  ~ .adr-body
  .adr-list
  > label:nth-of-type(1),
.adr-options
  > input:nth-of-type(2):focus-visible
  ~ .adr-body
  .adr-list
  > label:nth-of-type(2),
.adr-options
  > input:nth-of-type(3):focus-visible
  ~ .adr-body
  .adr-list
  > label:nth-of-type(3),
.adr-options
  > input:nth-of-type(4):focus-visible
  ~ .adr-body
  .adr-list
  > label:nth-of-type(4),
.adr-options
  > input:nth-of-type(5):focus-visible
  ~ .adr-body
  .adr-list
  > label:nth-of-type(5),
.adr-options
  > input:nth-of-type(6):focus-visible
  ~ .adr-body
  .adr-list
  > label:nth-of-type(6),
.adr-options
  > input:nth-of-type(7):focus-visible
  ~ .adr-body
  .adr-list
  > label:nth-of-type(7),
.adr-options
  > input:nth-of-type(8):focus-visible
  ~ .adr-body
  .adr-list
  > label:nth-of-type(8) {
  outline: 2px solid var(--role-accent);
  outline-offset: 1px;
}
.adr-options
  > input:nth-of-type(1):checked
  ~ .adr-body
  .adr-detail
  > :nth-child(1),
.adr-options
  > input:nth-of-type(2):checked
  ~ .adr-body
  .adr-detail
  > :nth-child(2),
.adr-options
  > input:nth-of-type(3):checked
  ~ .adr-body
  .adr-detail
  > :nth-child(3),
.adr-options
  > input:nth-of-type(4):checked
  ~ .adr-body
  .adr-detail
  > :nth-child(4),
.adr-options
  > input:nth-of-type(5):checked
  ~ .adr-body
  .adr-detail
  > :nth-child(5),
.adr-options
  > input:nth-of-type(6):checked
  ~ .adr-body
  .adr-detail
  > :nth-child(6),
.adr-options
  > input:nth-of-type(7):checked
  ~ .adr-body
  .adr-detail
  > :nth-child(7),
.adr-options
  > input:nth-of-type(8):checked
  ~ .adr-body
  .adr-detail
  > :nth-child(8) {
  display: block;
}
@media (prefers-reduced-motion: no-preference) {
  .adr-detail-item {
    animation: adr-detail-in 0.2s ease-out both;
  }
}
@keyframes adr-detail-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}
</style>
