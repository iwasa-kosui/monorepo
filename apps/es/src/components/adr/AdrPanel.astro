---
import { richHtml } from '../figures/rich';

type Props = {
  readonly heading: string;
  readonly lead?: string;
  readonly locked?: boolean;
};

const { heading, lead, locked = false } = Astro.props;
---

<section class="adr-panel" data-locked={locked ? '' : undefined}>
  <h2 class="adr-heading">{heading}</h2>
  {lead !== undefined && <p class="adr-lead" set:html={richHtml(lead)} />}
  <slot />
</section>

<style>
.adr-panel + .adr-panel {
  margin-top: var(--space-5);
}
:global(.panel[data-choice="pending"]) .adr-panel[data-locked] {
  display: none;
}
:global(.content)
  :global(.scene[data-scenario])
  :global(.doc-paper)
  .adr-heading {
  margin-block: 0 var(--space-2);
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
  line-height: var(--leading-normal);
}
:global(.content) :global(.scene[data-scenario]) :global(.doc-paper) .adr-lead {
  margin-block: 0 var(--space-1);
  font-size: var(--text-code);
  line-height: var(--leading-tight);
}
:global(.content)
  :global(.scene[data-scenario])
  :global(.doc-paper)
  .adr-lead
  :global(code) {
  font-size: 0.9em;
}
:global(.content)
  :global(.scene[data-scenario])
  :global(.doc-paper)
  .adr-panel
  > :global(p:not(.adr-lead)) {
  margin-block: var(--space-1) 0;
  font-size: var(--text-code);
  line-height: var(--leading-normal);
}
:global(.content)
  :global(.scene[data-scenario])
  :global(.doc-paper)
  .adr-panel
  :global(.cfig) {
  margin-block: var(--space-1);
  padding-block: 0;
}
</style>
