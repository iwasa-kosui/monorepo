---
import { richHtml } from '../figures/rich';

type Props = {
  readonly purpose: string;
};

const { purpose } = Astro.props;
---

<div class="adr-purpose">
  <span class="adr-purpose-label">目的</span>
  <span class="adr-purpose-text" set:html={richHtml(purpose)} />
</div>

<style>
.adr-purpose {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: baseline;
  gap: var(--space-2);
  margin-top: var(--space-3);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.adr-purpose-label {
  color: var(--role-muted);
  font-size: var(--text-note);
  white-space: nowrap;
}
:global(.content)
  :global(.scene[data-scenario])
  :global(.doc-paper)
  .adr-purpose
  :global(code) {
  background: var(--role-bg);
  font-size: 0.9em;
}
</style>
