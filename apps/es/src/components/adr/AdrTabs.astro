---
type Props = {
  readonly id: string;
  readonly labels: readonly string[];
};

const { id, labels } = Astro.props;
---

<div class="adr-tabs" data-adr-tabs>
  {
    labels.map((_, index) => (
      <input
        class="adr-sr"
        type="radio"
        name={`${id}-tab`}
        id={`${id}-tab-${index}`}
        checked={index === 0}
      />
    ))
  }
  <div class="adr-tablist">
    {
      labels.map((label, index) => (
        <label for={`${id}-tab-${index}`}>{label}</label>
      ))
    }
  </div>
  <div class="adr-panels"><slot /></div>
</div>

<style>
.adr-tabs {
  word-break: auto-phrase;
}
.adr-sr {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}
.adr-tablist {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  min-height: 2.5rem;
  background: var(--role-bg);
}
.adr-tablist label {
  display: inline-flex;
  align-items: center;
  border-radius: var(--radius-md);
  padding: var(--space-1) var(--space-3);
  color: var(--role-muted);
  font-size: var(--text-note);
  font-weight: var(--weight-regular);
  line-height: var(--leading-tight);
  white-space: nowrap;
  cursor: pointer;
}
.adr-tablist label:hover {
  background: var(--role-sunken);
}
.adr-panels > :global(*) {
  display: none;
}
.adr-tabs > input:nth-of-type(1):checked ~ .adr-panels > :global(:nth-child(1)),
.adr-tabs > input:nth-of-type(2):checked ~ .adr-panels > :global(:nth-child(2)),
.adr-tabs > input:nth-of-type(3):checked ~ .adr-panels > :global(:nth-child(3)),
.adr-tabs > input:nth-of-type(4):checked ~ .adr-panels > :global(:nth-child(4)),
.adr-tabs > input:nth-of-type(5):checked ~ .adr-panels > :global(:nth-child(5)),
.adr-tabs
  > input:nth-of-type(6):checked
  ~ .adr-panels
  > :global(:nth-child(6)) {
  display: block;
}
.adr-tabs > input:nth-of-type(1):checked ~ .adr-tablist > label:nth-child(1),
.adr-tabs > input:nth-of-type(2):checked ~ .adr-tablist > label:nth-child(2),
.adr-tabs > input:nth-of-type(3):checked ~ .adr-tablist > label:nth-child(3),
.adr-tabs > input:nth-of-type(4):checked ~ .adr-tablist > label:nth-child(4),
.adr-tabs > input:nth-of-type(5):checked ~ .adr-tablist > label:nth-child(5),
.adr-tabs > input:nth-of-type(6):checked ~ .adr-tablist > label:nth-child(6) {
  background: var(--role-accent-soft);
  color: var(--role-accent-strong);
  font-weight: var(--weight-bold);
}
.adr-tabs
  > input:nth-of-type(1):focus-visible
  ~ .adr-tablist
  > label:nth-child(1),
.adr-tabs
  > input:nth-of-type(2):focus-visible
  ~ .adr-tablist
  > label:nth-child(2),
.adr-tabs
  > input:nth-of-type(3):focus-visible
  ~ .adr-tablist
  > label:nth-child(3),
.adr-tabs
  > input:nth-of-type(4):focus-visible
  ~ .adr-tablist
  > label:nth-child(4),
.adr-tabs
  > input:nth-of-type(5):focus-visible
  ~ .adr-tablist
  > label:nth-child(5),
.adr-tabs
  > input:nth-of-type(6):focus-visible
  ~ .adr-tablist
  > label:nth-child(6) {
  outline: 2px solid var(--role-accent);
  outline-offset: 2px;
}
@media (prefers-reduced-motion: no-preference) {
  .adr-tablist label {
    transition: background-color 150ms ease, color 150ms ease;
  }
}
</style>
