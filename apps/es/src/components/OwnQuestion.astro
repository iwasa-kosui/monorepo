---
interface Props {
  id?: string;
  label?: string;
  showLabel?: boolean;
  rows?: number;
}
const {
  id = 'chapter-1',
  label = 'DB を見ても分からなかった質問',
  showLabel = false,
  rows = 3,
} = Astro.props;
const inputId = `own-question-${id}`;
---

<div class="own-question" data-own-question data-question-id={id}>
  {showLabel && <label for={inputId} class="own-question-label">{label}</label>}
  <textarea
    id={inputId}
    class="own-question-input"
    rows={rows}
    aria-label={showLabel ? undefined : label}
  ></textarea>
  <div class="own-question-status" role="status" data-saved></div>
</div>

<style>
.own-question {
  display: grid;
  gap: var(--space-1);
}
.own-question-label {
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
}
.own-question-input {
  display: block;
  width: 100%;
  min-height: var(--tap-min);
  border-radius: var(--radius-lg);
  background: var(--role-surface);
  padding: var(--space-2) var(--space-3);
  font-size: var(--text-body);
  line-height: var(--leading-normal);
}
.own-question-status {
  min-height: 1.5rem;
  color: var(--role-ink-sub);
  font-size: var(--text-note);
}
</style>

<script>
import { loadQuestion, saveQuestion } from '../playground/storage.ts';

for (
  const root of document.querySelectorAll<HTMLElement>('[data-own-question]')
) {
  const text = root.querySelector('textarea');
  const status = root.querySelector('[data-saved]');
  const id = root.dataset.questionId;
  if (text === null || status === null || id === undefined) continue;
  const restore = (): void => {
    const saved = loadQuestion(id);
    if (saved !== null) {
      text.value = saved;
    }
  };
  restore();
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) restore();
  });
  text.addEventListener('input', () => {
    status.textContent = saveQuestion(id, text.value)
      ? 'このブラウザに保存しました。'
      : 'このブラウザには保存できませんでした。';
  });
}
</script>
