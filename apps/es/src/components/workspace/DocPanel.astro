---
import {
  expectTab,
  panelIdOf,
  type PanelProps,
  tabIdOf,
} from '../../workspace/panel-props';

type Props = PanelProps;

const { scenario, tab: definition, hidden } = Astro.props;
const tab = expectTab(definition, 'doc');
const config = tab.config;
const approvable = config.approvable === true;
const { updatedAt, updatedBy } = config;
---

<div
  class="panel"
  role="tabpanel"
  id={panelIdOf(scenario, tab.key)}
  aria-labelledby={tabIdOf(scenario, tab.key)}
  data-tool={tab.key}
  data-kind="doc"
  hidden={hidden}
>
  <div class="doc">
    <div class="doc-head">
      <div class="doc-head-text">
        <p class="doc-space" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5a1 1 0 0 1 0-5H20">
            </path>
          </svg>
          <span>社内ドキュメント</span>
        </p>
        <p class="doc-title">{config.title}</p>
        {
          !approvable && updatedAt !== undefined
            && updatedBy !== undefined
            && (
            <p class="doc-updated">
              <span class="doc-avatar" aria-hidden="true">{
                [...updatedBy][0]
              }</span>
              最終更新 <time datetime={updatedAt}>{updatedAt}</time>・{
                updatedBy
              }
            </p>
          )
        }
      </div>
      {
        approvable && (
          <button
            class="doc-approve"
            type="button"
            aria-pressed="false"
            data-approve
          >
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12.5l4.5 4.5L19 7.5"></path>
            </svg>
            <span data-approve-label>Approve</span>
          </button>
        )
      }
    </div>
    <div
      class="doc-scroll"
      tabindex="0"
      role="region"
      aria-label={config.title}
    >
      <article class="doc-paper"><slot /></article>
    </div>
  </div>
  {tab.note !== undefined && <p class="panel-note">{tab.note}</p>}
</div>

<style>
:global(.scene[data-scenario]) .panel[data-kind="doc"] {
  --dc-bg: #f4f5f7;
  --dc-head: #ffffff;
  --dc-paper: #ffffff;
  --dc-fg: #172b4d;
  --dc-muted: #5e6c84;
  --dc-rule: #dfe1e6;
  --dc-edge: #7a869a;
  --dc-accent: #0c5fd3;
  --dc-accent-strong: #0747a6;
  --dc-accent-soft: #deebff;
  --dc-on-accent: #ffffff;
  --dc-sunken: #f4f5f7;
  --dc-quote: #f1f3f6;
  --dc-code: #ebecf0;
  --dc-success: #1b6b3a;
  --dc-success-soft: #e3fcef;
  --dc-success-line: #36b37e;
  --dc-danger: #ae2a19;
  --dc-danger-soft: #ffebe6;
  --dc-warning: #7a4b00;
  --dc-warning-soft: #fff7d6;
  --dc-warning-line: #d97706;
  --pn-bg: var(--dc-sunken);
  --pn-fg: var(--dc-fg);
  --pn-rule: var(--dc-rule);
  --ring: #0c5fd3;
  --role-bg: var(--dc-paper);
  --role-sunken: var(--dc-sunken);
  --role-fg: var(--dc-fg);
  --role-muted: var(--dc-muted);
  --role-border: var(--dc-edge);
  --role-rule: var(--dc-rule);
  --role-accent: var(--dc-accent);
  --role-accent-soft: var(--dc-accent-soft);
  --role-accent-strong: var(--dc-accent-strong);
  --role-on-accent: var(--dc-on-accent);
  --role-success: var(--dc-success);
  --role-success-soft: var(--dc-success-soft);
  --role-success-line: var(--dc-success-line);
  --role-danger: var(--dc-danger);
  --role-danger-soft: var(--dc-danger-soft);
  --role-warning: var(--dc-warning);
  --role-warning-soft: var(--dc-warning-soft);
  --role-warning-line: var(--dc-warning-line);
  background: var(--dc-paper);
  color: var(--dc-fg);
}
:global(.scene[data-scenario]) .doc {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
}
:global(.scene[data-scenario]) .doc-head {
  display: flex;
  flex: none;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2) var(--space-4);
  background: var(--dc-paper);
  padding: var(--space-3)
    max(var(--space-5), calc(50% - 24rem + var(--space-4))) var(--space-2);
}
:global(.scene[data-scenario]) .doc-head-text {
  flex: 1 1 24rem;
  min-width: 0;
}
:global(.scene[data-scenario]) .doc-head p {
  margin: 0;
}
:global(.scene[data-scenario]) .doc-space {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: var(--dc-muted);
  font-size: var(--text-note);
  line-height: var(--leading-normal);
}
:global(.scene[data-scenario]) .doc-space svg {
  flex: none;
  width: 1rem;
  height: 1rem;
}
:global(.scene[data-scenario]) .doc-avatar {
  display: inline-grid;
  place-items: center;
  width: 1.5rem;
  height: 1.5rem;
  flex: none;
  border-radius: 50%;
  background: var(--dc-accent);
  color: var(--dc-on-accent);
  font-size: var(--text-note);
  font-weight: var(--weight-bold);
  line-height: 1;
}
:global(.scene[data-scenario]) .doc-title {
  color: var(--dc-fg);
  font-size: var(--text-lead);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
}
:global(.scene[data-scenario]) .doc-updated {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  color: var(--dc-muted);
  font-size: var(--text-note);
  line-height: var(--leading-normal);
}
:global(.scene[data-scenario]) .doc-approve {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  gap: var(--space-2);
  margin-left: auto;
  border: 0;
  border-radius: var(--radius-md);
  background: var(--dc-accent);
  color: var(--dc-on-accent);
  padding: 0 1.25rem;
  min-height: var(--tap-min);
  font: inherit;
  font-size: var(--text-code);
  font-weight: var(--weight-bold);
  line-height: 1;
  cursor: pointer;
}
:global(.scene[data-scenario]) .doc-approve svg {
  flex: none;
  width: 1.25rem;
  height: 1.25rem;
}
:global(.scene[data-scenario]) .doc-approve[aria-pressed="false"] svg {
  display: none;
}
:global(.scene[data-scenario]) .doc-approve[aria-pressed="true"] {
  background: var(--role-success);
}
:global(.scene[data-scenario]) .doc-approve:focus-visible {
  outline: 3px solid var(--ring);
  outline-offset: 2px;
}
@media (prefers-reduced-motion: no-preference) {
  :global(.scene[data-scenario]) .doc-approve {
    transition: background-color 150ms ease;
  }
}
:global(.scene[data-scenario]) .doc-scroll {
  position: relative;
  flex: 1 1 0;
  min-height: 0;
  overflow: auto;
  padding: var(--space-3) var(--space-4);
}
:global(.scene[data-scenario]) .doc-scroll:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: -2px;
}
:global(.scene[data-scenario]) .doc-paper {
  max-width: 48rem;
  margin: 0 auto;
  border-top: 1px solid var(--dc-rule);
  background: var(--dc-paper);
  padding: var(--space-3) var(--space-4) var(--space-5);
  font-size: var(--text-body);
  line-height: var(--leading-loose);
  overflow-wrap: anywhere;
}
:global(.scene[data-scenario]) .doc-scroll:has(.adr-tabs) {
  padding-block: var(--space-1);
}
:global(.scene[data-scenario]) .doc-paper:has(.adr-tabs) {
  padding-block: var(--space-1) var(--space-2);
}
:global(.scene[data-scenario]) .doc-paper > :global(:first-child) {
  margin-top: 0;
}
:global(.scene[data-scenario]) .doc-paper > :global(:last-child) {
  margin-bottom: 0;
}
:global(.content) :global(.scene[data-scenario]) .doc-paper :global(h2),
:global(.content) :global(.scene[data-scenario]) .doc-paper :global(h3) {
  margin-block: var(--space-5) var(--space-2);
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
  line-height: var(--leading-normal);
}
:global(.content) :global(.scene[data-scenario]) .doc-paper :global(h4) {
  margin-block: var(--space-4) var(--space-1);
  color: var(--dc-muted);
  font-size: var(--text-note);
  font-weight: var(--weight-bold);
  line-height: var(--leading-normal);
}
:global(.content) :global(.scene[data-scenario]) .doc-paper :global(p),
:global(.content) :global(.scene[data-scenario]) .doc-paper :global(ul),
:global(.content) :global(.scene[data-scenario]) .doc-paper :global(ol),
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(table:not(.playground-console-table)),
:global(.content) :global(.scene[data-scenario]) .doc-paper :global(details) {
  margin-block: var(--space-2);
}
:global(.scene[data-scenario]) .doc-paper :global(li + li) {
  margin-top: var(--space-1);
}
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(table:not(.playground-console-table)) {
  font-size: var(--text-body);
  line-height: var(--leading-normal);
}
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(th:not(.playground-console-table th)),
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(td:not(.playground-console-table td)) {
  padding: var(--space-1) var(--space-3);
}
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(thead th:not(.playground-console-table th)) {
  font-size: var(--text-note);
  font-weight: var(--weight-bold);
}
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(:not(pre) > code) {
  background: var(--dc-code);
  font-size: var(--text-code);
}
:global(.content) :global(.scene[data-scenario]) .doc-paper :global(h4 code) {
  font-size: inherit;
}
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(.axis-buttons button code) {
  background: transparent;
}
:global(.content) :global(.scene[data-scenario]) .doc-paper :global(pre) {
  margin-block: var(--space-2);
  font-size: var(--text-code);
  line-height: var(--leading-normal);
}
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(.code-block pre) {
  margin: 0;
}
:global(.content) :global(.scene[data-scenario]) .doc-paper :global(pre code) {
  background: transparent;
  padding: 0;
  font-size: var(--text-code);
}
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(.detail-row) {
  margin-block: var(--space-2);
}
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(figure.quote) {
  margin-block: var(--space-3);
  border-radius: var(--radius-lg);
  background: var(--dc-quote);
  padding: var(--space-4);
  font-size: var(--text-body);
  line-height: var(--leading-loose);
}
:global(.content)
  :global(.scene[data-scenario])
  .doc-paper
  :global(figure.quote figcaption) {
  margin-top: var(--space-2);
  border-left: 0;
  padding-left: 0;
  font-size: var(--text-note);
  line-height: var(--leading-normal);
}
:global(.scene[data-scenario]) .doc-paper :global(.cfig) {
  margin-block: var(--space-3);
}
:global(.scene[data-scenario]) .doc-paper :global(.adr-tablist) {
  position: sticky;
  top: 0;
  z-index: 1;
  background: var(--dc-paper);
  box-shadow: 0 calc(-1 * var(--space-3)) 0 var(--dc-paper);
}
@media (max-width: 767px) {
  :global(.content)
    :global(.scene[data-scenario])
    .doc-paper
    :global([data-alternatives-table] table) {
    overflow-x: visible;
  }
  :global(.content)
    :global(.scene[data-scenario])
    .doc-paper
    :global([data-alternatives-table] thead) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  :global(.content)
    :global(.scene[data-scenario])
    .doc-paper
    :global([data-alternatives-table] tbody),
  :global(.content)
    :global(.scene[data-scenario])
    .doc-paper
    :global([data-alternatives-table] tr) {
    display: block;
  }
  :global(.content)
    :global(.scene[data-scenario])
    .doc-paper
    :global([data-alternatives-table] tr + tr) {
    margin-top: var(--space-4);
  }
  :global(.content)
    :global(.scene[data-scenario])
    .doc-paper
    :global([data-alternatives-table] td) {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-3);
    padding-inline: 0;
  }
  :global(.content)
    :global(.scene[data-scenario])
    .doc-paper
    :global([data-alternatives-table] td:first-child) {
    display: block;
    font-weight: var(--weight-bold);
  }
  :global(.content)
    :global(.scene[data-scenario])
    .doc-paper
    :global([data-alternatives-table] td:not(:first-child))::before {
    content: attr(data-label);
    content: attr(data-label) / "";
    color: var(--role-muted);
    text-wrap: balance;
  }
}
</style>
