---
import { clockOf } from '../../workspace/clock';
import type { TabKind, WorkspaceScenario } from '../../workspace/scenario';
import { assertScenario } from '../../workspace/validate';
import '../figures/figure.css';
import AgentPanel from './AgentPanel.astro';
import ChatWindow from './ChatWindow.astro';
import DbConsolePanel from './DbConsolePanel.astro';
import DocPanel from './DocPanel.astro';
import EditorPanel from './EditorPanel.astro';
import LogExplorerPanel from './LogExplorerPanel.astro';
import PrPanel from './PrPanel.astro';
import RepoPanel from './RepoPanel.astro';
import SlotPanel from './SlotPanel.astro';
import TabButton from './TabButton.astro';

interface Props {
  scenario: WorkspaceScenario;
}

const { scenario } = Astro.props;
assertScenario(scenario);

const panelComponents = {
  console: DbConsolePanel,
  logs: LogExplorerPanel,
  repo: RepoPanel,
  agent: AgentPanel,
  slot: SlotPanel,
  editor: EditorPanel,
  doc: DocPanel,
  pr: PrPanel,
} satisfies Record<TabKind, unknown>;

const timed = scenario.mode === 'timed';
const firstTab = scenario.tabs.find((tab) => tab.initial !== false);
if (firstTab === undefined) {
  throw new Error('最初から表示するタブがありません');
}
const { status } = scenario;
const counter = status.counter;
const collapsed = scenario.chat.collapsed === true;
const chatHidden = collapsed
  && scenario.history.length === 0
  && scenario.timeline.every((event) => event.kind !== 'post');
const showStatus = timed;
const hasComposer = Astro.slots.has('composer');
---

<section
  class="cfig scene"
  data-investigation
  data-scenario={JSON.stringify(scenario)}
  data-opened=""
  data-selected={firstTab.key}
  data-view={timed ? 'chat' : 'tools'}
  data-phase={timed ? 'idle' : 'running'}
  data-ready="false"
  aria-label={scenario.label}
>
  {
    showStatus && (
      <div class="status-bar" role="group" aria-label={status.label}>
        {
          timed && (
            <>
              <p
                class="status-item status-elapsed"
                role="timer"
                aria-live="off"
              >
                <span class="status-label">{status.elapsed}</span>
                <span data-elapsed>00:00</span>
              </p>
              <p class="status-item status-clock">
                <span class="cfig-sr">画面内の現在時刻</span>
                <time data-clock>{clockOf(scenario.startedAt)}</time>
              </p>
            </>
          )
        }
        {
          counter !== undefined && (
            <p class="status-item status-affected">
              <span class="status-label" data-short={counter.short}>{
                counter.label
              }</span>
              <strong data-affected>{counter.initial}{counter.unit}</strong>
            </p>
          )
        }
        <div class="status-actions">
          {
            timed && (
              <button
                type="button"
                class="btn btn--text"
                data-action="pause"
                disabled
              >
                一時停止
              </button>
            )
          }
          <button
            type="button"
            class="btn btn--text"
            data-action="reset"
            disabled={timed}
          >
            最初からやり直す
          </button>
        </div>
      </div>
    )
  }

  <div
    class="workspace"
    data-workspace
    data-chat-collapsed={collapsed && !chatHidden ? '' : undefined}
    data-chat-hidden={chatHidden ? '' : undefined}
  >
    {
      hasComposer
        ? (
        <ChatWindow scenario={scenario} composer={true}>
          <slot name="composer" slot="composer" />
        </ChatWindow>
      )
        : <ChatWindow scenario={scenario} />
    }

    <div
      class="win browser"
      role="group"
      aria-label="ブラウザ"
      data-window
      inert={timed}
    >
      <div class="win-bar tab-strip">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="tabs" role="tablist" aria-label="開くツール">
          <TabButton scenario={scenario} chat={true} />
          {
            scenario.tabs.map((tab) =>
              tab.initial === false
                ? (
              <template data-tab-button={tab.key}>
                <TabButton scenario={scenario} tab={tab} selected={false} />
              </template>
            )
                : (
              <TabButton
                scenario={scenario}
                tab={tab}
                selected={tab.key === firstTab.key}
              />
            )
            )
          }
        </div>
      </div>
      <p class="address">
        <span class="nav" aria-hidden="true"><i>←</i><i>→</i><i>↻</i></span>
        <span class="url-pill">
          <span class="cfig-sr">アドレス</span>
          <span class="lock" aria-hidden="true"></span>
          <span class="address-text" data-address>{firstTab.url}</span>
        </span>
      </p>

      <div class="pages">
        {
          scenario.tabs.map((tab) => {
            const Panel = panelComponents[tab.kind];
            return tab.initial === false
              ? (
            <template data-tab-panel={tab.key}>
              <Panel scenario={scenario} tab={tab} hidden={true}>
                <slot name={tab.key} />
              </Panel>
            </template>
          )
              : (
            <Panel
              scenario={scenario}
              tab={tab}
              hidden={tab.key !== firstTab.key}
            >
              <slot name={tab.key} />
            </Panel>
          );
          })
        }
      </div>
    </div>

    {
      timed && (
        <div
          class="start"
          role="group"
          aria-labelledby={`${scenario.id}-start`}
          data-start
        >
          <div class="start-card">
            <p class="start-text" id={`${scenario.id}-start`}>
              {scenario.startGuide.join('')}
            </p>
            <button type="button" class="btn" data-action="start">
              {status.start}
            </button>
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
:global(.content) :global(.cfig).scene {
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: var(--space-2);
  border: 0;
  background: transparent;
  padding: 0;
}
.scene > * {
  min-width: 0;
}

.scene .status-bar {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  flex: none;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 var(--space-6);
  min-height: var(--tap-min);
  background: var(--role-surface);
  font-size: var(--text-note);
  line-height: var(--leading-normal);
}
.scene .status-item {
  margin: 0;
  font-variant-numeric: tabular-nums;
}
.scene .status-elapsed,
.scene .status-affected {
  display: inline-flex;
  align-items: baseline;
  gap: var(--space-2);
}
.scene .status-elapsed [data-elapsed],
.scene .status-clock time {
  font-family: var(--font-code);
  font-size: var(--text-code);
  font-weight: var(--weight-bold);
}
.scene .status-affected {
  color: var(--role-danger);
  font-weight: var(--weight-bold);
}
.scene .status-actions {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  margin-left: auto;
}
.scene .status-actions .btn:disabled {
  background: none;
  cursor: not-allowed;
}

.scene .workspace {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
  min-width: 0;
  min-height: 0;
}
.scene .start {
  position: absolute;
  inset: 0;
  z-index: 10;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  overflow: auto;
  border-radius: var(--radius-xl);
  background: color-mix(in srgb, var(--role-surface) 80%, transparent);
  padding: var(--space-5) var(--space-3);
  backdrop-filter: blur(2px);
}
.scene .start-card {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--space-4);
  max-width: 36rem;
  border-radius: var(--radius-xl);
  background: var(--role-ground);
  box-shadow: var(--shadow-raised);
  padding: var(--space-5);
}
.scene .start-text {
  margin: 0;
  font-size: var(--text-body);
  line-height: var(--leading-normal);
}
.scene .start .btn {
  height: var(--space-7);
  background: var(--role-accent);
  color: var(--role-on-accent);
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
}
.scene .start .btn:hover {
  opacity: 0.9;
}
.scene :global([hidden]:not(.playground *)) {
  display: none;
}

.scene :global(.win[data-window]) {
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  border-radius: var(--radius-xl);
  background: var(--role-surface);
  overflow: hidden;
}
.scene .win-bar {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  background: var(--role-sunken);
  padding: var(--space-1) var(--space-3);
}
.scene :global(.dots) {
  display: inline-flex;
  flex: none;
  gap: var(--space-1);
}
.scene :global(.dots i) {
  width: 0.75rem;
  height: 0.75rem;
  border-radius: 50%;
  background: var(--dot, var(--role-ink-sub));
}
:global(:where(.scene) :where(button:not(.playground *))) {
  font: inherit;
}
.scene :global(button:not(.playground *):focus-visible),
.scene :global(input:not(.playground *):focus-visible) {
  outline: 2px solid var(--ring);
  outline-offset: -2px;
}

.scene .browser {
  --br-strip: #dee1e6;
  --br-chrome: #ffffff;
  --br-pill: #f1f3f4;
  --br-text: #202124;
  --br-tab: #3c4043;
  --br-tab-hover: #eceff3;
  --br-nav: #5f6368;
  --br-rule: #dadce0;
  --br-dot: #9aa0ab;
  --br-unseen-bg: #fff1c2;
  --br-unseen: #6b4300;
  --br-unseen-line: #b7791f;
  --br-fav-teal: #0e8f8a;
  --br-fav-violet: #632ca6;
  --br-fav-ink: #1f2328;
  --br-fav-coral: #d97757;
  --br-fav-blue: #2f6fed;
  --br-fav-azure: #007acc;
  --br-fav-plum: #4a154b;
  --ring: #1a5fc8;
  --dot: var(--br-dot);
  background: var(--br-chrome);
  color: var(--br-text);
}
.scene .tab-strip {
  align-items: flex-end;
  gap: var(--space-2);
  border-bottom: 0;
  background: var(--br-strip);
  padding: var(--space-2) var(--space-2) 0;
}
.scene .tab-strip .dots {
  align-self: center;
}
.scene .tabs {
  display: flex;
  flex: 1 1 0;
  flex-wrap: nowrap;
  align-items: flex-end;
  gap: 0 var(--space-1);
  min-width: 0;
}
.scene .address {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  margin: 0;
  background: var(--br-chrome);
  padding: var(--space-2) var(--space-3);
}
.scene .nav {
  display: inline-flex;
  flex: none;
  gap: var(--space-3);
  color: var(--br-nav);
  font-size: var(--text-note);
  line-height: var(--leading-normal);
}
.scene .nav i {
  font-style: normal;
}
.scene .url-pill {
  display: flex;
  flex: 1 1 auto;
  align-items: center;
  gap: var(--space-2);
  min-width: 0;
  border-radius: var(--radius-pill);
  background: var(--br-pill);
  padding: 0 var(--space-4);
  color: var(--role-ink-sub);
}
.scene .lock {
  position: relative;
  flex: none;
  width: 0.5625rem;
  height: 0.4375rem;
  margin-top: 0.25rem;
  border-radius: 1px;
  background: var(--br-nav);
}
.scene .lock::before {
  content: "";
  position: absolute;
  bottom: 100%;
  left: 50%;
  width: 0.3125rem;
  height: 0.25rem;
  transform: translateX(-50%);
  border: 1.5px solid var(--br-nav);
  border-bottom: 0;
  border-radius: 0.1875rem 0.1875rem 0 0;
}
.scene .address-text {
  flex: 1 1 auto;
  min-width: 0;
  overflow: hidden;
  font-family: var(--font-code);
  font-size: var(--text-note);
  line-height: var(--leading-normal);
  text-overflow: ellipsis;
  white-space: nowrap;
}

.scene .pages {
  display: flex;
  flex-direction: column;
  height: 26rem;
  min-height: 0;
}
.scene :global(.panel[role="tabpanel"]) {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
}
.scene :global(.panel[role="tabpanel"][hidden]) {
  display: none;
}
.scene :global(.panel-note) {
  position: relative;
  z-index: 1;
  flex: none;
  margin: 0;
  border-top: 1px solid var(--pn-rule);
  background: var(--pn-bg);
  padding: var(--space-1) var(--space-3);
  color: var(--pn-fg);
  font-size: var(--text-note);
  line-height: var(--leading-normal);
}

.scene .workspace[data-chat-hidden] :global(.win.chat),
.scene .workspace[data-chat-hidden] :global(.chat-tab) {
  display: none;
}

@media (max-width: 639px) {
  .scene .status-bar {
    gap: 0 var(--space-4);
  }
  .scene .status-actions {
    margin-left: 0;
  }
  .scene .start {
    padding: var(--space-4) var(--space-3);
  }
  .scene .workspace {
    gap: var(--space-2);
    overflow-x: clip;
  }
  .scene .browser {
    order: -1;
  }
  .scene .tab-strip .dots {
    display: none;
  }
  .scene .tabs {
    flex-wrap: nowrap;
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  .scene .address {
    display: none;
  }
  .scene .pages {
    height: max(
      20rem,
      calc(
        var(--ws-height, 100dvh) - var(--ws-top, 0px) -
          var(--ws-strip, 3.75rem) -
          var(--space-2)
      )
    );
  }
  .scene[data-view="chat"] .pages {
    display: none;
  }
  .scene[data-view="chat"] :global(.win.chat) {
    min-height: max(
      20rem,
      calc(
        var(--ws-height, 100dvh) - var(--ws-top, 0px) -
          var(--ws-strip, 3.75rem) -
          var(--space-2)
      )
    );
  }
  .scene[data-view="tools"] :global(.win.chat) {
    display: none;
  }
}

@media (min-width: 1024px) {
  :global(.content) :global(.chapter-body) > .scene {
    flex: 1 1 0;
    min-height: 26rem;
  }
  :global(.content .chapter-body > .scene:has(.memo-list)) {
    min-height: 32rem;
  }
  .scene .workspace {
    flex: 1 1 0;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    grid-template-rows: minmax(0, 1fr);
  }
  .scene .workspace[data-chat-collapsed] {
    grid-template-columns: 3.5rem minmax(0, 1fr);
  }
  .scene .workspace[data-chat-hidden] {
    grid-template-columns: minmax(0, 1fr);
  }
  .scene .start {
    align-items: center;
  }
  .scene .pages {
    flex: 1 1 0;
    height: auto;
  }
}

@media (max-height: 720px) {
  .scene .address {
    padding-block: var(--space-1);
  }
}
</style>

<script>
import { bootWorkspaces } from '../../workspace/boot';

bootWorkspaces();
</script>
