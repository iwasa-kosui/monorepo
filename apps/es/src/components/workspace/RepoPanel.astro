---
import { Code } from 'astro:components';

import { snapshotFiles } from '../../lib/snapshots';
import {
  expectTab,
  panelIdOf,
  type PanelProps,
  tabIdOf,
} from '../../workspace/panel-props';

type Props = PanelProps;

const { scenario, tab: definition, hidden } = Astro.props;
const tab = expectTab(definition, 'repo');
const config = tab.config;

const source = snapshotFiles(config.snapshot)[config.file];
if (source === undefined) {
  throw new Error(`${config.snapshot} に ${config.file} がありません`);
}
const code = source.trimEnd();
const codeLines = code.split('\n').length;
const crumbs = [config.name, ...config.path];
---

<div
  class="panel"
  role="tabpanel"
  id={panelIdOf(scenario, tab.key)}
  aria-labelledby={tabIdOf(scenario, tab.key)}
  data-tool={tab.key}
  data-kind="repo"
  hidden={hidden}
>
  <div class="repo-body">
    <div class="repo-top">
      <p class="repo-path">
        <span>{config.owner}</span>
        <span class="sep">/</span>
        <strong>{config.name}</strong>
      </p>
      <span class="repo-badge">{config.visibility}</span>
    </div>
    <p class="repo-tabs" aria-hidden="true">
      <span class="on">Code</span>
      <span>Issues</span>
      <span>Pull requests</span>
    </p>
    <div class="repo-nav">
      <span class="branch">{config.branch}</span>
      <p class="crumbs">
        {
          crumbs.map((crumb, index) => (
            <>
              {index > 0 && <span class="sep">/</span>}
              {index > 0 && ' '}
              {
                index === crumbs.length - 1 ? <strong>{crumb}</strong> : (
                  <span>{crumb}</span>
                )
              }
              {' '}
            </>
          ))
        }
      </p>
    </div>
    <div class="repo-code">
      <div class="repo-bar">
        <span class="seg" aria-hidden="true"><span class="on">Code</span><span
          >Blame</span></span>
        <span class="repo-lines">{codeLines} lines</span>
      </div>
      <Code
        code={code}
        lang="ts"
        themes={{
          light: 'github-light-default',
          dark: 'github-dark-default',
        }}
        defaultColor={false}
      />
    </div>
  </div>
  {tab.note !== undefined && <p class="panel-note">{tab.note}</p>}
</div>

<style>
:global(.scene[data-scenario]) .panel[data-kind="repo"] {
  --gh-bg: #ffffff;
  --gh-band: #f6f8fa;
  --gh-fg: #1f2328;
  --gh-muted: #59636e;
  --gh-rule: #d1d9e0;
  --gh-link: #0969da;
  --gh-tab-line: #fd8c73;
  --gh-select: #ddf4ff;
  --pn-bg: var(--gh-band);
  --pn-fg: var(--gh-fg);
  --pn-rule: var(--gh-rule);
  --ring: #0969da;
  background: var(--gh-bg);
  color: var(--gh-fg);
}
:global(.scene[data-scenario]) .repo-body {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  gap: 0.375rem;
  min-height: 0;
  padding: 0.5rem 0.625rem;
}
:global(.scene[data-scenario]) .repo-top {
  display: flex;
  flex: none;
  align-items: center;
  gap: 0.5rem;
}
:global(.scene[data-scenario]) .repo-path {
  margin: 0;
  font-size: 0.9375rem;
  line-height: 1.4;
}
:global(.scene[data-scenario]) .repo-path .sep,
:global(.scene[data-scenario]) .crumbs .sep {
  color: var(--gh-muted);
}
:global(.scene[data-scenario]) .repo-path > span:first-child {
  color: var(--gh-link);
}
:global(.scene[data-scenario]) .repo-path strong {
  color: var(--gh-link);
  font-weight: 700;
}
:global(.scene[data-scenario]) .repo-badge {
  border: 1px solid var(--gh-rule);
  border-radius: 999px;
  padding: 0 0.5rem;
  color: var(--gh-muted);
  font-size: 0.75rem;
  font-weight: 500;
  line-height: 1.5;
}
:global(.scene[data-scenario]) .repo-tabs {
  display: flex;
  flex: none;
  gap: 0.25rem;
  margin: 0;
  border-bottom: 1px solid var(--gh-rule);
  font-size: 0.8125rem;
}
:global(.scene[data-scenario]) .repo-tabs span {
  margin-bottom: -1px;
  border-bottom: 2px solid transparent;
  padding: 0.125rem 0.5rem;
  color: var(--gh-muted);
  line-height: 1.5;
}
:global(.scene[data-scenario]) .repo-tabs span.on {
  border-bottom-color: var(--gh-tab-line);
  color: var(--gh-fg);
  font-weight: 700;
}
:global(.scene[data-scenario]) .repo-nav {
  display: flex;
  flex: none;
  align-items: center;
  gap: 0.625rem;
}
:global(.scene[data-scenario]) .branch {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  border: 1px solid var(--gh-rule);
  border-radius: var(--radius-md);
  background: var(--gh-band);
  padding: 0 0.5rem;
  font-size: 0.75rem;
  font-weight: 700;
  line-height: 1.6;
}
:global(.scene[data-scenario]) .branch::after {
  content: "▾" / "";
  color: var(--gh-muted);
  font-weight: 400;
}
:global(.scene[data-scenario]) .crumbs {
  margin: 0;
  font-size: 0.8125rem;
  line-height: 1.5;
}
:global(.scene[data-scenario]) .crumbs span:not(.sep) {
  color: var(--gh-link);
}
:global(.scene[data-scenario]) .repo-code {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
  border: 1px solid var(--gh-rule);
  border-radius: var(--radius-lg);
  overflow: hidden;
}
:global(.scene[data-scenario]) .repo-bar {
  display: flex;
  flex: none;
  align-items: center;
  gap: 0.75rem;
  border-bottom: 1px solid var(--gh-rule);
  background: var(--gh-band);
  padding: 0.1875rem 0.625rem;
  font-size: 0.75rem;
}
:global(.scene[data-scenario]) .seg {
  display: inline-flex;
  border: 1px solid var(--gh-rule);
  border-radius: var(--radius-md);
  background: var(--gh-bg);
  overflow: hidden;
  line-height: 1.5;
}
:global(.scene[data-scenario]) .seg span {
  padding: 0 0.5rem;
  color: var(--gh-muted);
}
:global(.scene[data-scenario]) .seg span.on {
  background: var(--gh-select);
  color: var(--gh-fg);
  font-weight: 700;
}
:global(.scene[data-scenario]) .repo-lines {
  color: var(--gh-muted);
}
:global(.scene[data-scenario]) :global(pre.astro-code) {
  flex: 1 1 0;
  min-height: 0;
  max-height: 20rem;
  margin: 0;
  overflow: auto;
  border-radius: 0;
  padding: 0.375rem 0;
  background-color: var(--gh-bg) !important;
  color: var(--gh-fg);
  font-size: 0.75rem;
  line-height: 1.6;
}
:global(.scene[data-scenario]) :global(pre.astro-code span) {
  color: var(--shiki-light);
}
:global(.scene[data-scenario]) :global(pre.astro-code code) {
  display: grid;
  width: max-content;
  min-width: 100%;
  background: transparent;
  counter-reset: line;
}
:global(.scene[data-scenario]) :global(pre.astro-code .line) {
  padding: 0 0.625rem;
}
:global(.scene[data-scenario]) :global(pre.astro-code .line::before) {
  content: counter(line);
  counter-increment: line;
  display: inline-block;
  width: 1.5rem;
  margin-right: 1rem;
  color: var(--gh-muted);
  text-align: right;
}

:global(.scene[data-scenario]) :global(pre.astro-code:focus-visible) {
  outline: 2px solid var(--ring);
  outline-offset: -2px;
}
@media (min-width: 1024px) {
  :global(.scene[data-scenario]) :global(pre.astro-code) {
    max-height: none;
  }
}
@media (prefers-color-scheme: dark) {
  :global(.scene[data-scenario]) .panel[data-kind="repo"] {
    --gh-bg: #0d1117;
    --gh-band: #151b23;
    --gh-fg: #e6edf3;
    --gh-muted: #9198a1;
    --gh-rule: #3d444d;
    --gh-link: #4493f8;
    --gh-tab-line: #f78166;
    --gh-select: #1a2a44;
    --ring: #4493f8;
  }
  :global(.scene[data-scenario]) :global(pre.astro-code span) {
    color: var(--shiki-dark);
  }
}
</style>
