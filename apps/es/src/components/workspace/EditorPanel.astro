---
import {
  expectTab,
  panelIdOf,
  type PanelProps,
  tabIdOf,
} from '../../workspace/panel-props';

type Props = PanelProps;

const { scenario, tab: definition, hidden } = Astro.props;
const tab = expectTab(definition, 'editor');
const config = tab.config;
---

<div
  class="panel"
  role="tabpanel"
  id={panelIdOf(scenario, tab.key)}
  aria-labelledby={tabIdOf(scenario, tab.key)}
  data-tool={tab.key}
  data-kind="editor"
  hidden={hidden}
>
  <div class="ide">
    <div class="ide-tree" aria-hidden="true">
      <p class="ide-tree-title">EXPLORER</p>
      <p class="ide-project">{config.project}</p>
      <ul class="ide-files">
        {
          config.files.map((file) => (
            <li class={file === config.active ? 'on' : undefined}>{file}</li>
          ))
        }
      </ul>
    </div>
    <div class="ide-main">
      <div class="ide-tabs" aria-hidden="true">
        <span class="ide-file">{config.active}</span>
      </div>
      <div class="ide-work"><slot /></div>
      <div class="ide-terminal" aria-hidden="true">
        <p>
          <span class="ide-term-title">TERMINAL</span>
          <span class="ide-prompt">{config.project} %</span>
        </p>
      </div>
    </div>
  </div>
  {tab.note !== undefined && <p class="panel-note">{tab.note}</p>}
</div>

<style>
:global(.scene[data-scenario]) .panel[data-kind="editor"] {
  --ed-bg: #1e1e1e;
  --ed-side: #252526;
  --ed-tab-off: #2d2d2d;
  --ed-fg: #d4d4d4;
  --ed-muted: #a0a0a0;
  --ed-rule: #3c3c3c;
  --ed-edge: #8a8a8a;
  --ed-accent: #4aa3ff;
  --ed-on-accent: #06121f;
  --ed-soft: #04395e;
  --ed-strong: #9cdcfe;
  --ed-success: #89d185;
  --ed-success-soft: #1d3a24;
  --ed-success-line: #4caf50;
  --ed-danger: #f48771;
  --ed-danger-soft: #4b1f1c;
  --ed-warning: #e5c07b;
  --ed-warning-soft: #3a3118;
  --ed-warning-line: #d7ba7d;
  --ed-highlight: #d7ba7d;
  --ed-console: #181818;
  --pn-bg: var(--ed-side);
  --pn-fg: var(--ed-fg);
  --pn-rule: var(--ed-rule);
  --ring: #4aa3ff;
  --role-bg: var(--ed-bg);
  --role-surface: var(--ed-bg);
  --role-sunken: var(--ed-side);
  --role-fg: var(--ed-fg);
  --role-muted: var(--ed-muted);
  --role-border: var(--ed-edge);
  --role-rule: var(--ed-rule);
  --role-faint: #6b6b6b;
  --role-accent: var(--ed-accent);
  --role-accent-soft: var(--ed-soft);
  --role-accent-strong: var(--ed-strong);
  --role-on-accent: var(--ed-on-accent);
  --role-on-strong: var(--ed-bg);
  --role-success: var(--ed-success);
  --role-success-soft: var(--ed-success-soft);
  --role-success-line: var(--ed-success-line);
  --role-danger: var(--ed-danger);
  --role-danger-soft: var(--ed-danger-soft);
  --role-warning: var(--ed-warning);
  --role-warning-soft: var(--ed-warning-soft);
  --role-warning-line: var(--ed-warning-line);
  --role-highlight: var(--ed-highlight);
  --role-highlight-soft: var(--ed-warning-soft);
  --role-on-highlight: var(--ed-bg);
  --role-console: var(--ed-console);
  --role-on-console: var(--ed-fg);
  --role-code-keyword: #c586c0;
  --role-code-string: #ce9178;
  --role-code-number: #b5cea8;
  --role-code-comment: #8fb07f;
  --role-code-function: #dcdcaa;
  --role-code-type: #4ec9b0;
  container-type: inline-size;
  container-name: ide;
  background: var(--ed-bg);
  color: var(--ed-fg);
  color-scheme: dark;
}
:global(.scene[data-scenario]) .ide {
  display: flex;
  flex: 1 1 0;
  min-height: 0;
}
:global(.scene[data-scenario]) .ide-tree {
  display: none;
  flex: none;
  flex-direction: column;
  width: 9rem;
  overflow: hidden;
  border-right: 1px solid var(--ed-rule);
  background: var(--ed-side);
  padding: 0.375rem 0;
  font-size: 0.75rem;
  line-height: 1.6;
}
:global(.scene[data-scenario]) .ide-tree p {
  margin: 0;
}
:global(.scene[data-scenario]) .ide-tree-title {
  padding: 0 0.75rem 0.25rem;
  color: var(--ed-muted);
  font-size: 0.6875rem;
  letter-spacing: 0.04em;
}
:global(.scene[data-scenario]) .ide-project {
  padding: 0 0.75rem;
  color: var(--ed-strong);
  font-weight: 700;
}
:global(.scene[data-scenario]) .ide-project::before {
  content: "▾ " / "";
}
:global(.scene[data-scenario]) .ide-files {
  margin: 0;
  padding: 0;
  list-style: none;
}
:global(.scene[data-scenario]) .ide-files li {
  overflow: hidden;
  margin: 0;
  padding: 0 0.75rem 0 1.5rem;
  font-family: var(--font-code);
  text-overflow: ellipsis;
  white-space: nowrap;
}
:global(.scene[data-scenario]) .ide-files li.on {
  background: var(--ed-soft);
  color: #ffffff;
}
:global(.scene[data-scenario]) .ide-main {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
}
:global(.scene[data-scenario]) .ide-tabs {
  display: flex;
  flex: none;
  background: var(--ed-side);
}
:global(.scene[data-scenario]) .ide-file {
  border-top: 1px solid var(--ed-accent);
  background: var(--ed-bg);
  padding: 0.125rem 0.875rem;
  color: #ffffff;
  font-family: var(--font-code);
  font-size: 0.75rem;
  line-height: 1.5;
}
:global(.scene[data-scenario]) .ide-main:has(.playground-tabs) > .ide-tabs {
  display: none;
}
:global(.scene[data-scenario]) .ide-work {
  position: relative;
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
  overflow: auto;
  padding: 0.25rem 0.5rem;
}
:global(.scene[data-scenario]) .ide-terminal {
  flex: none;
  border-top: 1px solid var(--ed-rule);
  background: var(--ed-bg);
  padding: 0 0.625rem;
  font-size: 0.6875rem;
  line-height: 1.5;
}
:global(.scene[data-scenario]) .ide-terminal p {
  margin: 0;
}
:global(.scene[data-scenario]) .ide-term-title {
  margin-right: 0.75rem;
  border-bottom: 1px solid var(--ed-accent);
  color: #ffffff;
  letter-spacing: 0.04em;
}
:global(.scene[data-scenario]) .ide-prompt {
  color: var(--ed-muted);
  font-family: var(--font-code);
}
@container ide (min-width: 40rem) {
  :global(.scene[data-scenario]) .ide-tree {
    display: flex;
  }
}
@container ide (max-width: 79.99rem) {
  :global(.scene[data-scenario]) .ide:has(.play) .ide-tree {
    display: none;
  }
}

:global(.scene[data-scenario]) .panel[data-kind="editor"] :global(.playground) {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  padding: 0;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-status),
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-toolbar) {
  margin-bottom: 0.25rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground button) {
  padding: 0.125rem 0.625rem;
  font-size: 0.8125rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-tabs) {
  gap: 0;
  background: var(--ed-side);
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-tabs button) {
  border: 0;
  border-top: 1px solid transparent;
  border-radius: 0;
  background: var(--ed-tab-off);
  padding: 0.125rem 0.875rem;
  color: var(--ed-muted);
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-tabs button[aria-selected="true"]) {
  border-top-color: var(--ed-accent);
  background: var(--ed-bg);
  color: #ffffff;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-panes) {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  gap: 0.375rem;
  min-height: 0;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-pane-editor) {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 6rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-editor) {
  position: relative;
  flex: 1 1 0;
  min-height: 0;
  overflow: hidden;
  border: 1px solid var(--ed-rule);
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-editor .cm-editor) {
  height: 100%;
  max-height: none;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-results),
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-results:empty) {
  flex: 0 1 45%;
  max-height: none;
  min-height: 0;
  margin: 0;
  border: 1px solid var(--ed-rule);
  background: var(--ed-console);
  padding: 0.375rem 0.625rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-results:empty) {
  display: none;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.playground-log) {
  background: transparent;
  padding: 0;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.cm-editor.cm-focused) {
  outline: 2px solid var(--ring);
  outline-offset: -2px;
}

:global(.scene[data-scenario]) .panel[data-kind="editor"] :global(.play) {
  flex: 1 1 auto;
  gap: 0.375rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play-inquiry) {
  gap: 0.125rem 0.75rem;
  padding: 0.125rem 0.625rem;
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play .play-inquiry h2) {
  font-size: 1rem;
  line-height: 1.5;
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play .play-next) {
  min-height: 0;
  padding: 0.125rem 0.625rem;
  font-size: 0.8125rem;
  line-height: 1.25;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play button) {
  padding-block: 0.1875rem;
  font-size: 0.8125rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play button.play-quiet) {
  padding-block: 0.0625rem;
  font-size: 0.8125rem;
}
:global(.scene[data-scenario]) .panel[data-kind="editor"] :global(.play-panel) {
  padding: 0.25rem 0.5rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play-panel > h2),
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play-panel-head h2) {
  font-size: 0.9375rem;
  line-height: 1.4;
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play .play-table th),
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play .play-table td) {
  padding-block: 0.0625rem;
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play .play-answer th) {
  font-size: 0.8125rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play-caption) {
  font-size: 0.8125rem;
  line-height: 1.3;
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play .play-hint) {
  font-size: 0.8125rem;
  line-height: 1.3;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play-hint-step summary) {
  padding-block: 0;
}
:global(.scene[data-scenario]) .panel[data-kind="editor"] :global(.play-tests) {
  min-height: 4.5rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play-editor .cm-editor) {
  font-size: 0.75rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play-editor .cm-line) {
  line-height: 1.3;
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play .play-event th),
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play .play-event td) {
  padding-block: 0;
  font-size: 0.75rem;
  line-height: 1.4;
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play .play-event th) {
  width: 5.25rem;
}
:global(.scene[data-scenario])
  .panel[data-kind="editor"]
  :global(.play-events) {
  gap: 0.25rem;
  margin-top: 0.125rem;
}
@media (min-width: 1100px) {
  :global(.scene[data-scenario])
    .panel[data-kind="editor"]
    :global(.play-hint-step[open] > .play-hint-body) {
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    line-height: 1.3;
  }
  :global(.content)
    :global(.scene[data-scenario])
    .panel[data-kind="editor"]
    :global(.play .play-hint-body .play-changes) {
    font-size: 0.75rem;
    line-height: 1.3;
  }
  :global(.scene[data-scenario])
    .panel[data-kind="editor"]
    :global(.play-hint-step[open] > .play-hint-body .play-hint-head strong) {
    font-size: 0.9375rem;
  }
}
@media (max-width: 1099px) {
  :global(.scene[data-scenario]) .panel[data-kind="editor"] :global(.play),
  :global(.scene[data-scenario])
    .panel[data-kind="editor"]
    :global(.play-columns),
  :global(.scene[data-scenario]) .panel[data-kind="editor"] :global(.play-col) {
    flex: none;
    min-height: auto;
  }
}
</style>
