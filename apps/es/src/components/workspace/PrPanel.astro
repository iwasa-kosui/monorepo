}
:global(.scene[data-scenario]) .pr-line.pr-add td {
  background: var(--gh-add-bg);
}
:global(.scene[data-scenario]) .pr-line.pr-add td.pr-num {
  background: var(--gh-add-num);
}
:global(.scene[data-scenario]) .pr-line.pr-add .pr-code {
  color: var(--gh-add-text);
}
:global(.scene[data-scenario]) .pr-line.pr-del td {
  background: var(--gh-del-bg);
}
:global(.scene[data-scenario]) .pr-line.pr-del td.pr-num {
  background: var(--gh-del-num);
}
:global(.scene[data-scenario]) .pr-line.pr-del .pr-code {
  color: var(--gh-del-text);
}
:global(.scene[data-scenario]) .panel[data-kind="pr"] {
  --dc-paper: var(--gh-bg);
  --dc-rule: var(--gh-rule);
  --dc-muted: var(--gh-muted);
  --dc-fg: var(--gh-fg);
  --dc-code: #eff1f3;
  --dc-quote: var(--gh-band);
  --role-accent-soft: #ddf4ff;
  --role-accent-strong: #0550ae;
  --role-ground: var(--gh-bg);
}
:global(.scene[data-scenario]) .pr-author {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  margin-left: var(--space-2);
}
:global(.scene[data-scenario]) .pr-author-label {
  color: var(--gh-muted);
}
:global(.scene[data-scenario]) .pr-avatar {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 50%;
  background: #4a5568;
  color: #ffffff;
  font-size: var(--text-note);
  font-weight: var(--weight-bold);
  line-height: 1;
}
:global(.scene[data-scenario]) .pr-avatar[data-tone="rose"] {
  background: #c2344d;
}
:global(.scene[data-scenario]) .pr-avatar[data-tone="blue"] {
  background: #1264a3;
}
:global(.scene[data-scenario]) .pr-avatar[data-tone="green"] {
  background: #2e7d32;
}
:global(.scene[data-scenario]) .pr-avatar[data-tone="amber"] {
  background: #8a5a00;
}
:global(.scene[data-scenario]) .pr-avatar[data-tone="violet"] {
  background: #6b3fa0;
}
:global(.scene[data-scenario]) .pr-section[data-pr-section="conversation"] {
