---
import { snapshotFiles } from '../../lib/snapshots';
import { diffFiles } from '../../workspace/diff';
import {
  expectTab,
  panelIdOf,
  type PanelProps,
  tabIdOf,
} from '../../workspace/panel-props';

type Props = PanelProps;

const { scenario, tab: definition, hidden } = Astro.props;
const tab = expectTab(definition, 'pr');
const config = tab.config;

const sourceOf = (
  snapshot: string,
  file: string,
): string => {
  const source = snapshotFiles(snapshot)[file];
  if (source === undefined) {
    throw new Error(`${snapshot} に ${file} がありません`);
  }
  return source;
};
const change = config.diff;
const diff = change === undefined ? undefined : diffFiles(
  sourceOf(change.before, change.file),
  sourceOf(change.after, change.file),
  change.context,
);
const review = config.review;
const author = review === undefined
  ? undefined
  : scenario.actors[review.author];
const reviewer = review === undefined
  ? undefined
  : scenario.actors[review.reviewer];
if (review !== undefined && (author === undefined || reviewer === undefined)) {
  throw new Error(
    'プルリクエストの作成者かレビューした人が actors にありません',
  );
}
const signOf = { add: '+', del: '−', same: ' ' } as const;
const wordOf = { add: '追加', del: '削除', same: '変更なし' } as const;
const sectionId = (name: string): string =>
  `${panelIdOf(scenario, tab.key)}-${name}`;
---

<div
  class="panel"
  role="tabpanel"
  id={panelIdOf(scenario, tab.key)}
  aria-labelledby={tabIdOf(scenario, tab.key)}
  data-tool={tab.key}
  data-kind="pr"
  data-choice={review === undefined ? undefined : 'pending'}
  hidden={hidden}
>
  <div class="pr">
    <div class="pr-head">
      <p class="pr-repo">
        <span>{config.owner}</span>
        <span class="sep">/</span>
        <strong>{config.name}</strong>
      </p>
      <p class="pr-title">
        <span class="pr-title-text">{config.title}</span>
        <span class="pr-number">#{config.number}</span>
      </p>
      <p class="pr-meta">
        <span class="pr-state">{config.status}</span>
        {
          diff !== undefined && (
            <span class="pr-stat" data-pr-stat>
              <span class="pr-add">+{diff.added}</span>
              <span class="pr-del">−{diff.deleted}</span>
            </span>
          )
        }
        {
          author !== undefined && (
            <span class="pr-author">
              <span class="pr-author-label">作成者</span>
              <span
                class="pr-avatar"
                data-tone={author.tone}
                aria-hidden="true"
              >{author.avatar}</span>
              <strong>{author.name}</strong>
            </span>
          )
        }
      </p>
    </div>
    <div class="pr-tabs" role="tablist" aria-label="プルリクエストの表示">
      <button
        type="button"
        role="tab"
        id={sectionId('conversation-tab')}
        aria-controls={sectionId('conversation')}
        aria-selected="true"
        data-pr-view="conversation"
      >
        Conversation
      </button>
      <button
        type="button"
        role="tab"
        id={sectionId('files-tab')}
        aria-controls={sectionId('files')}
        aria-selected="false"
        tabindex="-1"
        data-pr-view="files"
      >
        Files changed <span class="pr-count">1</span>
      </button>
    </div>
    <div class="pr-body">
      <section
        class="pr-section"
        id={sectionId('conversation')}
        role="tabpanel"
        aria-labelledby={sectionId('conversation-tab')}
        data-pr-section="conversation"
      >
        {
          review === undefined ? (
            <div class="pr-comment">
              <slot />
            </div>
          ) : (
            author !== undefined && reviewer !== undefined
            && (
            <div class="pr-conversation">
              <aside class="pr-side" aria-label="Reviewers">
                <p class="pr-side-title">Reviewers</p>
                <p class="pr-reviewer">
                  <span
                    class="pr-avatar"
                    data-tone={reviewer.tone}
                    aria-hidden="true"
                  >{reviewer.avatar}</span>
                  <strong>{reviewer.name}</strong>
                  <span
                    class="pr-reviewer-state"
                    role="status"
                    data-pr-reviewer-state
                    data-state="requested"
                  >Review requested</span>
                </p>
              </aside>
              <div class="pr-main">
                <div class="pr-comment pr-first">
                  <p class="pr-card-head">
                    <span
                      class="pr-avatar"
                      data-tone={author.tone}
                      aria-hidden="true"
                    >{author.avatar}</span>
                    <strong>{author.name}</strong>
                  </p>
                  <p class="pr-first-text" data-pr-description>
                    {review.description}
                  </p>
                  <p class="pr-draft" data-pr-draft>{review.draftLabel}</p>
                </div>
                <ol
                  class="pr-timeline"
                  role="list"
                  aria-label="タイムライン"
                  aria-live="polite"
                  data-pr-timeline
                >
                </ol>
              </div>
            </div>
          )
          )
        }
      </section>
      <section
        class="pr-section"
        id={sectionId('files')}
        role="tabpanel"
        aria-labelledby={sectionId('files-tab')}
        data-pr-section="files"
        hidden
      >
        {
          review === undefined && change !== undefined
              && diff !== undefined
            ? (
            <div class="pr-file">
              <p class="pr-file-head">
                <code>{change.file}</code>
                <span class="pr-stat">
                  <span class="pr-add">+{diff.added}</span>
                  <span class="pr-del">−{diff.deleted}</span>
                </span>
              </p>
              <div
                class="pr-diff-scroll"
                tabindex="0"
                role="region"
                aria-label={`${change.file} の差分`}
              >
                {
                  diff.hunks.map((hunk) => (
                    <table class="pr-diff">
                      <caption class="pr-hunk">{hunk.header}</caption>
                      <tbody>
                        {
                          hunk.lines.map((line) => (
                            <tr class={`pr-line pr-${line.kind}`}>
                              <td class="pr-num">{line.oldNumber}</td>
                              <td class="pr-num">{line.newNumber}</td>
                              <td class="pr-code">
                                <span class="pr-sr">{wordOf[line.kind]}:</span>
                                <span class="pr-sign" aria-hidden="true">
                                  {signOf[line.kind]}
                                </span>{line.text}
                              </td>
                            </tr>
                          ))
                        }
                      </tbody>
                    </table>
                  ))
                }
              </div>
            </div>
          )
            : (
              review !== undefined && (
            <div class="pr-file">
              <p class="pr-file-head">
                <code>{review.file}</code>
              </p>
              <article class="pr-doc doc-paper">
                <p class="pr-doc-title" data-pr-doc-title>
                  {review.pendingTitle}
                </p>
                <slot />
              </article>
            </div>
          )
            )
        }
      </section>
    </div>
  </div>
  {tab.note !== undefined && <p class="panel-note">{tab.note}</p>}
  {
    review !== undefined && author !== undefined && reviewer !== undefined
      && (
      <template data-pr-parts>
        <li class="pr-event" data-part="request">
          <span class="pr-event-icon" aria-hidden="true"></span>
          <span>
            <strong>{author.name}</strong>が<strong>{
              reviewer.name
            }</strong>にレビューを依頼しました
          </span>
        </li>
        <li class="pr-event" data-part="commit">
          <span class="pr-event-icon" aria-hidden="true"></span>
          <span>
            <strong>{author.name}</strong>がコミットしました:
            <code data-text></code>
          </span>
        </li>
        <li class="pr-comment pr-review" data-part="review">
          <p class="pr-card-head">
            <span
              class="pr-avatar"
              data-tone={reviewer.tone}
              aria-hidden="true"
            >{reviewer.avatar}</span>
            <strong>{reviewer.name}</strong>
            <span class="pr-review-state" data-label></span>
          </p>
          <p class="pr-review-target" data-target></p>
          <div data-body></div>
        </li>
      </template>
    )
  }
</div>

<style>
:global(.scene[data-scenario]) .panel[data-kind="pr"] {
  --gh-bg: #ffffff;
  --gh-band: #f6f8fa;
  --gh-fg: #1f2328;
  --gh-muted: #59636e;
  --gh-rule: #d1d9e0;
  --gh-link: #0969da;
  --gh-tab-line: #fd8c73;
  --gh-open: #1a7f37;
  --gh-open-text: #ffffff;
  --gh-add-bg: #dafbe1;
  --gh-add-num: #aceebb;
  --gh-add-text: #116329;
  --gh-del-bg: #ffebe9;
  --gh-del-num: #ffcecb;
  --gh-del-text: #82071e;
  --gh-hunk: #ddf4ff;
  --pn-bg: var(--gh-band);
  --pn-fg: var(--gh-fg);
  --pn-rule: var(--gh-rule);
  --ring: #0969da;
  --role-bg: var(--gh-bg);
  --role-surface: var(--gh-bg);
  --role-sunken: var(--gh-band);
  --role-fg: var(--gh-fg);
  --role-muted: var(--gh-muted);
  --role-rule: var(--gh-rule);
  --role-accent: var(--gh-link);
  background: var(--gh-bg);
  color: var(--gh-fg);
}
:global(.scene[data-scenario]) .pr {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
}
:global(.scene[data-scenario]) .pr p {
  margin: 0;
}
:global(.scene[data-scenario]) .pr-head {
  display: flex;
  flex: none;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-1) var(--space-4);
  padding: var(--space-3) var(--space-4) var(--space-2);
}
:global(.scene[data-scenario]) .pr-repo {
  color: var(--gh-muted);
  font-size: var(--text-note);
}
:global(.scene[data-scenario]) .pr-repo span:first-child,
:global(.scene[data-scenario]) .pr-repo strong {
  color: var(--gh-link);
}
:global(.scene[data-scenario]) .pr-title {
  flex: 1 1 14rem;
  min-width: 0;
  font-size: var(--text-lead);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
}
:global(.scene[data-scenario]) .pr-number {
