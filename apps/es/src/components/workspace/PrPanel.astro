}
:global(.scene[data-scenario]) .pr-tabs button:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: -2px;
}
:global(.scene[data-scenario]) .pr-count {
  margin-left: var(--space-1);
  border-radius: var(--radius-pill);
  background: var(--gh-rule);
  padding: 0 var(--space-2);
  color: var(--gh-fg);
  font-size: var(--text-note);
}
:global(.scene[data-scenario]) .pr-body {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
}
:global(.scene[data-scenario]) .pr-section {
  position: relative;
  flex: 1 1 0;
  min-height: 0;
  overflow: auto;
  padding: var(--space-3) var(--space-4) var(--space-4);
}
:global(.scene[data-scenario]) .pr-section[hidden] {
  display: none;
}
:global(.scene[data-scenario]) .pr-comment {
  max-width: 48rem;
  border: 1px solid var(--gh-rule);
  border-radius: var(--radius-lg);
  background: var(--gh-bg);
  padding: var(--space-3) var(--space-4) var(--space-4);
  font-size: var(--text-body);
  line-height: var(--leading-normal);
  overflow-wrap: anywhere;
}
:global(.scene[data-scenario]) .pr-comment > :global(:first-child) {
  margin-top: 0;
}
:global(.scene[data-scenario]) .pr-comment > :global(:last-child) {
  margin-bottom: 0;
}
:global(.content) :global(.scene[data-scenario]) .pr-comment :global(h2) {
  margin-block: var(--space-3) var(--space-2);
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
}
:global(.content) :global(.scene[data-scenario]) .pr-comment :global(p),
:global(.content) :global(.scene[data-scenario]) .pr-comment :global(ul),
:global(.content) :global(.scene[data-scenario]) .pr-comment :global(ol) {
  margin-block: var(--space-2);
}
:global(.scene[data-scenario]) .pr-comment :global(li + li) {
  margin-top: var(--space-1);
}
:global(.content)
  :global(.scene[data-scenario])
  .pr-comment
  :global(:not(pre) > code) {
  background: var(--gh-band);
  font-size: var(--text-code);
}
:global(.content)
  :global(.scene[data-scenario])
  .pr-comment
  :global(figure.quote) {
  margin-block: var(--space-2);
  border-radius: var(--radius-lg);
  background: var(--gh-band);
  padding: var(--space-3) var(--space-4);
  font-size: var(--text-body);
  line-height: var(--leading-normal);
}
:global(.content)
  :global(.scene[data-scenario])
  .pr-comment
  :global(figure.quote figcaption) {
  margin-top: var(--space-2);
  border-left: 0;
  padding-left: 0;
  font-size: var(--text-note);
  line-height: var(--leading-normal);
}
:global(.scene[data-scenario]) .pr-file {
  overflow: hidden;
  border: 1px solid var(--gh-rule);
  border-radius: var(--radius-lg);
}
:global(.scene[data-scenario]) .pr-file-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  border-bottom: 1px solid var(--gh-rule);
  background: var(--gh-band);
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-code);
}
:global(.scene[data-scenario]) .pr-file-head code {
  background: transparent;
  padding: 0;
  font-family: var(--font-code);
  font-size: var(--text-code);
  font-weight: var(--weight-bold);
}
:global(.scene[data-scenario]) .pr-diff-scroll {
  overflow-x: auto;
}
:global(.scene[data-scenario]) .pr-diff-scroll:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: -2px;
}
:global(.content) :global(.scene[data-scenario]) .pr-diff {
  display: table;
  width: max-content;
  min-width: 100%;
  margin: 0;
  border-collapse: collapse;
  font-family: var(--font-code);
  font-size: var(--text-code);
  line-height: var(--leading-normal);
}
:global(.scene[data-scenario]) .pr-hunk {
  background: var(--gh-hunk);
  padding: 0 var(--space-3);
  color: var(--gh-muted);
  font-size: var(--text-code);
  text-align: left;
  caption-side: top;
}
:global(.content) :global(.scene[data-scenario]) .pr-diff td {
  border: 0;
  padding: 0;
}
:global(.scene[data-scenario]) .pr-num {
  width: 3.25rem;
  min-width: 3.25rem;
  padding: 0 var(--space-2);
  color: var(--gh-muted);
  font-size: var(--text-code);
