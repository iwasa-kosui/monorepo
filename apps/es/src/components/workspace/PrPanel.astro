:global(.scene[data-scenario]) .pr-draft[hidden] {
  display: none;
}
:global(.scene[data-scenario]) .pr-timeline {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  margin: 0;
  padding: 0;
  list-style: none;
}
:global(.scene[data-scenario]) .pr-event {
  display: flex;
  align-items: flex-start;
  gap: var(--space-2);
  margin: 0;
  padding-left: var(--space-3);
  font-size: var(--text-code);
  line-height: var(--leading-normal);
