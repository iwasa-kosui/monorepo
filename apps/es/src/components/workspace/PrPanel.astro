}
:global(.scene[data-scenario]) .pr-conversation {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  gap: var(--space-4);
}
:global(.scene[data-scenario]) .pr-main {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  min-width: 0;
}
@container (min-width: 40rem) {
  :global(.scene[data-scenario]) .pr-conversation {
    grid-template-columns: minmax(0, 1fr) 14rem;
