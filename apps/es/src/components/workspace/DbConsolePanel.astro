---
import { snapshotFiles } from '../../lib/snapshots';
import { resolveDbSetup } from '../../workspace/db-setup';
import {
  expectTab,
  panelIdOf,
  type PanelProps,
  tabIdOf,
} from '../../workspace/panel-props';
import SqlPlayground from '../SqlPlayground.astro';

type Props = PanelProps;

const { scenario, tab: definition, hidden } = Astro.props;
const tab = expectTab(definition, 'console');
const config = tab.config;

const resolved = resolveDbSetup(config.setup, (snapshot, file) => {
  const source = snapshotFiles(snapshot)[file];
  if (source === undefined) {
    throw new Error(`${snapshot} に ${file} がありません`);
  }
  return source;
});
---

<div
  class="panel"
  role="tabpanel"
  id={panelIdOf(scenario, tab.key)}
  aria-labelledby={tabIdOf(scenario, tab.key)}
  data-tool={tab.key}
  data-kind="console"
  data-controls={config.controls === true ? 'shown' : undefined}
  hidden={hidden}
>
  <div class="console">
    <div class="db-conn">
      <span class="db-dot" aria-hidden="true"></span>
      <span class="db-name">{config.connection.name}</span>
      <span class="db-kind">{config.connection.engine}</span>
    </div>
    <div class="db-body">
      <div class="tables" role="group" aria-label="テーブルの一覧">
        <p class="side-title">Tables</p>
        {
          resolved.tables.map((table) => (
            <>
              <button type="button" class="table-item" data-table={table.name}>
                <span class="tbl-icon" aria-hidden="true"></span>{table.name}
              </button>
              <ul class="columns" aria-label={`${table.name} の列`}>
                {
                  table.columns.map((column) => (
                    <li>
                      <code>{column.name}</code>
                      <span>{column.type}</span>
                    </li>
                  ))
                }
              </ul>
            </>
          ))
        }
      </div>
      {
        resolved.kind === 'sql'
          ? (
          <SqlPlayground
            id={config.storageId}
            setup={resolved.sql}
            initial={config.initialSql}
          />
        )
          : (
          <SqlPlayground
            id={config.storageId}
            script={{
              exercise: resolved.setup.exercise,
              entry: resolved.setup.entry,
              ...(resolved.setup.own === undefined
                ? {}
                : { own: resolved.setup.own }),
            }}
            initial={config.initialSql}
          />
        )
      }
    </div>
  </div>
  {tab.note !== undefined && <p class="panel-note">{tab.note}</p>}
</div>

<style>
:global(.scene[data-scenario])
  .panel[data-kind="console"]:not([data-controls])
  :global([data-role="reset"]),
:global(.scene[data-scenario])
  .panel[data-kind="console"]:not([data-controls])
  :global([data-role="reset-sql"]),
:global(.scene[data-scenario])
  .panel[data-kind="console"]:not([data-controls])
  :global([data-role="restore"]) {
  display: none !important;
}
:global(.scene[data-scenario]) .panel[data-kind="console"] {
  --db-bg: #ffffff;
  --db-band: #eef2f5;
  --db-side: #f5f7fa;
  --db-head: #e4e9ee;
  --db-fg: #1f2933;
  --db-muted: #52606d;
  --db-rule: #d5dbe1;
  --db-grid: #c9d1d9;
  --db-edge: #7b8794;
  --db-accent: #0b7a75;
  --db-accent-strong: #09625e;
  --db-online: #1f9d55;
  --db-on-accent: #ffffff;
  --db-soft: #d7f0ee;
  --db-danger: #b42318;
  --db-danger-soft: #fdecea;
  --db-keyword: #7a2e9e;
  --db-string: #1e6b3a;
  --db-number: #9a4a00;
  --db-comment: #5a6772;
  --db-func: #0b6b8f;
  --pn-bg: var(--db-band);
  --pn-fg: var(--db-fg);
  --pn-rule: var(--db-rule);
  --ring: #0b7a75;
  --role-surface: var(--db-bg);
  --role-sunken: var(--db-side);
  --role-fg: var(--db-fg);
  --role-muted: var(--db-muted);
  --role-rule: var(--db-rule);
  --role-border: var(--db-edge);
  --role-accent: var(--db-accent);
  --role-accent-soft: var(--db-soft);
  --role-on-accent: var(--db-on-accent);
  --role-danger: var(--db-danger);
  --role-danger-soft: var(--db-danger-soft);
  --role-code-keyword: var(--db-keyword);
  --role-code-string: var(--db-string);
  --role-code-number: var(--db-number);
  --role-code-comment: var(--db-comment);
  --role-code-function: var(--db-func);
  --role-code-type: var(--db-func);
  background: var(--db-bg);
  color: var(--db-fg);
}
:global(.scene[data-scenario]) .console {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
}
:global(.scene[data-scenario]) .db-conn {
  display: flex;
  flex: none;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2) var(--space-4);
  background: var(--db-accent);
  padding: var(--space-3) var(--space-5);
  color: var(--db-on-accent);
  line-height: var(--leading-tight);
}
:global(.scene[data-scenario]) .db-dot {
  flex: none;
  width: 0.75rem;
  height: 0.75rem;
  border-radius: 50%;
  background: var(--db-on-accent);
}
:global(.scene[data-scenario]) .db-name {
  min-width: 0;
  overflow: hidden;
  font-family: var(--font-code);
  font-size: var(--text-code);
  font-weight: var(--weight-bold);
  text-overflow: ellipsis;
  white-space: nowrap;
}
:global(.scene[data-scenario]) .db-kind {
  flex: none;
  margin-left: auto;
  font-size: var(--text-note);
}
:global(.scene[data-scenario]) .db-body {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
}
:global(.scene[data-scenario]) .tables {
  flex: none;
  max-height: 9rem;
  overflow: auto;
  background: var(--db-side);
  padding: var(--space-3) var(--space-4);
  font-family: var(--font-code);
}
:global(.scene[data-scenario]) .side-title {
  margin: 0 0 var(--space-1);
  color: var(--db-muted);
  font-family: var(--font-body);
  font-size: var(--text-note);
  line-height: var(--leading-normal);
}
:global(.scene[data-scenario]) .side-title::before {
  content: "▾" / "";
  margin-right: var(--space-1);
}
:global(.scene[data-scenario]) .table-item {
  display: flex;
  align-items: center;
  gap: var(--space-2);
  width: 100%;
  min-height: var(--tap-min);
  border: 0;
  border-radius: var(--radius-md);
  background: transparent;
  padding: 0 var(--space-2);
  color: var(--db-fg);
  font-family: var(--font-code);
  font-size: var(--text-code);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  text-align: left;
  cursor: pointer;
}
:global(.scene[data-scenario]) .table-item:hover {
  background: var(--db-soft);
}
:global(.scene[data-scenario]) .table-item:focus-visible {
  outline: 2px solid var(--ring);
  outline-offset: -2px;
}
:global(.scene[data-scenario]) .tbl-icon {
  flex: none;
  width: 0.75rem;
  height: 0.625rem;
  border: 1.5px solid var(--db-accent);
  border-top-width: 3px;
  border-radius: 1px;
  background: linear-gradient(
    to right,
    transparent calc(50% - 0.5px),
    var(--db-accent) calc(50% - 0.5px),
    var(--db-accent) calc(50% + 0.5px),
    transparent calc(50% + 0.5px)
  );
}
:global(.scene[data-scenario]) .columns {
  margin: 0;
  padding: 0 0 var(--space-2) var(--space-5);
  list-style: none;
  font-size: var(--text-note);
  line-height: var(--leading-normal);
}
:global(.scene[data-scenario]) .columns li {
  margin: 0;
}
:global(.scene[data-scenario]) .columns code {
  background: transparent;
  padding: 0;
  font-size: var(--text-note);
}
:global(.scene[data-scenario]) .columns span {
  color: var(--db-muted);
  font-family: var(--font-code);
}

:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground) {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  margin: 0;
  overflow-y: auto;
  border: 0;
  border-radius: 0;
  background: var(--db-bg);
  padding: var(--space-4) var(--space-5);
  font-size: var(--text-note);
  line-height: var(--leading-normal);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-status),
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-toolbar) {
  margin-bottom: var(--space-3);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-status) {
  color: var(--db-muted);
  font-size: var(--text-note);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-origin) {
  font-size: var(--text-note);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-toolbar) {
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-3) var(--space-4);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground button) {
  min-width: var(--tap-min);
  min-height: var(--tap-min);
  border: 0;
  border-radius: var(--radius-lg);
  background: var(--db-soft);
  padding: 0 var(--space-4);
  color: var(--db-accent);
  font-size: var(--text-code);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground button:disabled) {
  background: var(--db-head);
  color: var(--db-muted);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground button[data-role="run"]),
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground button[data-role="run"]:hover:not(:disabled)) {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  min-height: 3.25rem;
  background: var(--db-accent);
  padding: 0 var(--space-5);
  color: var(--db-on-accent);
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground button[data-role="run"]:hover:not(:disabled)) {
  background: var(--db-accent-strong);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground button[data-role="run"])::before {
  content: "";
  border-top: 0.375rem solid transparent;
  border-bottom: 0.375rem solid transparent;
  border-left: 0.625rem solid currentColor;
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground button[data-role="run"]:disabled) {
  background: var(--db-head);
  color: var(--db-muted);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-hint) {
  color: var(--db-muted);
  font-size: var(--text-note);
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-panes) {
  display: flex;
  flex: 1 0 auto;
  flex-direction: column;
  gap: var(--space-4);
  min-width: 0;
  min-height: 0;
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-pane-editor) {
  display: block;
  flex: none;
  min-height: 0;
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-editor) {
  position: static;
  height: 5.5rem;
  min-height: 0;
  overflow: hidden;
  border: 2px solid var(--db-rule);
  border-radius: var(--radius-lg);
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="console"][data-controls]
  :global(.playground-editor) {
  height: 9rem;
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-editor .cm-editor) {
  height: 100%;
  max-height: none;
  font-size: var(--text-body);
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-editor .cm-scroller) {
  font-family: var(--font-code);
  line-height: var(--leading-normal);
}
:global(.content)
  :global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-results) {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 9rem;
  max-height: none;
  margin-top: 0;
  overflow: auto;
  border: 1px solid var(--db-grid);
  background: var(--db-bg);
  padding: 0;
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-results > *) {
  flex: none;
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-results > .playground-note) {
  margin: 0;
  padding: var(--space-3) var(--space-4);
  color: var(--db-muted);
  font-size: var(--text-body);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-results > .playground-result) {
  display: flex;
  flex: 1 0 auto;
  flex-direction: column;
  margin: 0;
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result + .playground-result) {
  border-top: 2px solid var(--db-grid);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result .playground-statement) {
  margin: 0;
  border-bottom: 1px solid var(--db-grid);
  background: var(--db-band);
  padding: var(--space-1) var(--space-3);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result .playground-statement code) {
  background: transparent;
  padding: 0;
  color: var(--db-muted);
  font-size: var(--text-note);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result table) {
  margin: 0;
  border-collapse: collapse;
  font-family: var(--font-code);
  font-size: var(--text-code);
  line-height: var(--leading-normal);
  counter-reset: row;
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result th),
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result td) {
  border: 1px solid var(--db-grid);
  padding: var(--space-1) var(--space-3);
  text-align: left;
  white-space: nowrap;
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result th) {
  background: var(--db-head);
  color: var(--db-muted);
  font-size: var(--text-note);
  font-weight: var(--weight-bold);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result tr)::before {
  content: "";
  display: table-cell;
  width: 2rem;
  border: 1px solid var(--db-grid);
  background: var(--db-head);
  padding: var(--space-1) var(--space-2);
  color: var(--db-muted);
  font-size: var(--text-note);
  text-align: right;
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result tbody tr) {
  counter-increment: row;
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result tbody tr)::before {
  content: counter(row);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-result > .playground-note) {
  position: sticky;
  bottom: 0;
  margin: auto 0 0;
  border-top: 1px solid var(--db-grid);
  background: var(--db-band);
  padding: var(--space-1) var(--space-3);
  color: var(--db-muted);
  font-size: var(--text-note);
}
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-label),
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground-error),
:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.playground pre) {
  font-size: var(--text-code);
}

:global(.scene[data-scenario])
  .panel[data-kind="console"]
  :global(.cm-editor.cm-focused) {
  outline: 2px solid var(--ring);
  outline-offset: -2px;
}
@media (max-width: 639px) {
  :global(.scene[data-scenario]) .db-body {
    overflow-y: auto;
  }
  :global(.scene[data-scenario])
    .panel[data-kind="console"]
    :global(.playground) {
    flex: 1 0 auto;
    overflow: visible;
  }
  :global(.scene[data-scenario])
    .panel[data-kind="console"]
    :global(.playground-hint) {
    display: none;
  }
  :global(.content)
    :global(.scene[data-scenario])
    .panel[data-kind="console"]
    :global(.playground-results) {
    flex: 1 0 auto;
  }
}
@media (min-width: 640px) {
  :global(.scene[data-scenario]) .db-body {
    flex-direction: row;
  }
  :global(.scene[data-scenario]) .tables {
    width: 12rem;
    max-height: none;
  }
}
@media (prefers-reduced-motion: no-preference) {
  :global(.scene[data-scenario]) .table-item {
    transition: background-color 0.1s;
  }
}
</style>
