---
import type { PanelProps } from '../../workspace/panel-props';
import {
  chatPanelIdOf,
  chatTabIdOf,
  panelIdOf,
  shortTitleOf,
  tabIdOf,
} from '../../workspace/panel-props';

type Props =
  | (Pick<PanelProps, 'scenario' | 'tab'> & { selected: boolean })
  | (Pick<PanelProps, 'scenario'> & { chat: true });

const props = Astro.props;

const icons = {
  chat:
    '<path d="M20.5 11.5a8 8 0 0 1-11.7 7.1L4 20l1.3-4.4A8 8 0 1 1 20.5 11.5z"/>',
  console:
    '<ellipse cx="12" cy="6" rx="7" ry="3"/><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6"/>',
  logs:
    '<path d="M9 6h11M9 12h11M9 18h11"/><path d="M4.5 6h.01M4.5 12h.01M4.5 18h.01"/>',
  repo: '<path d="M9 7.5 4.5 12 9 16.5M15 7.5l4.5 4.5-4.5 4.5"/>',
  agent:
    '<path d="M11 3.5l1.9 5.1L18 10.5l-5.1 1.9L11 17.5l-1.9-5.1L4 10.5l5.1-1.9z"/><path d="M18.5 15.5v5M16 18h5"/>',
  slot:
    '<rect x="3.5" y="5" width="17" height="14" rx="2"/><path d="M3.5 9.5h17"/>',
  editor: '<path d="M4 20h4L19.5 8.5l-4-4L4 16z"/><path d="M13.5 6.5l4 4"/>',
  doc:
    '<path d="M6.5 3.5h7.5l4 4v13h-11.5z"/><path d="M14 3.5v4h4M9.5 12.5h5M9.5 16h5"/>',
  pr:
    '<circle cx="6" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="18" r="2"/><path d="M6 8v8M18 16v-5.5a3 3 0 0 0-3-3h-3.5"/><path d="M13.5 5 11 7.5l2.5 2.5"/>',
} as const;
const icon = 'chat' in props ? icons.chat : icons[props.tab.kind];
---

{
  'chat' in props
    ? (
    <button
      type="button"
      class="tab chat-tab"
      role="tab"
      id={chatTabIdOf(props.scenario)}
      data-chat-tab
      aria-selected="false"
      aria-controls={chatPanelIdOf(props.scenario)}
      tabindex="-1"
    >
      <span
        class="fav"
        aria-hidden="true"
        data-tone="plum"
        data-shape="rounded"
      ></span>
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={icon}
      />
      <span class="tab-title">チャット</span>
      <span class="cfig-sr" data-chat-unread-label></span>
      <span class="chat-unread" data-chat-unread hidden aria-hidden="true"
      >0</span>
    </button>
  )
    : (
    <button
      type="button"
      class="tab"
      role="tab"
      id={tabIdOf(props.scenario, props.tab.key)}
      data-tool={props.tab.key}
      data-url={props.tab.url}
      aria-selected={props.selected ? 'true' : 'false'}
      aria-controls={panelIdOf(props.scenario, props.tab.key)}
      tabindex={props.selected ? 0 : -1}
    >
      <span
        class="fav"
        aria-hidden="true"
        data-tone={props.tab.favicon.tone}
        data-shape={props.tab.favicon.shape}
      ></span>
      <svg
        class="tab-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={icon}
      />
      <span class="tab-title">{props.tab.title}</span>
      <span class="tab-short" aria-hidden="true">{
        shortTitleOf(props.tab)
      }</span>
      <span class="cfig-sr">（{props.tab.label}）</span>
      <span class="unseen" data-unseen hidden={props.tab.seen === undefined}
      >未確認</span>
    </button>
  )
}

<style>
:global(.scene[data-scenario]) .tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  gap: 0.4375rem;
  min-width: 0;
  max-width: 100%;
  margin: 0;
  border: 0;
  border-radius: 0.5rem 0.5rem 0 0;
  background: transparent;
  padding: 0.375rem 0.75rem;
  color: var(--br-tab);
  font-size: 0.8125rem;
  cursor: pointer;
}
:global(.scene[data-scenario]) .tab:hover:not([aria-selected="true"]) {
  background: var(--br-tab-hover);
}
:global(.scene[data-scenario]) .tab[aria-selected="true"] {
  background: var(--br-chrome);
  color: var(--br-text);
}
:global(.scene[data-scenario]) .tab[aria-selected="true"]::before,
:global(.scene[data-scenario]) .tab[aria-selected="true"]::after {
  content: "";
  position: absolute;
  bottom: 0;
  width: 0.5rem;
  height: 0.5rem;
}
:global(.scene[data-scenario]) .tab[aria-selected="true"]::before {
  left: -0.5rem;
  background: radial-gradient(
    circle at 0 0,
    transparent 0.5rem,
    var(--br-chrome) calc(0.5rem + 0.5px)
  );
}
:global(.scene[data-scenario]) .tab[aria-selected="true"]::after {
  right: -0.5rem;
  background: radial-gradient(
    circle at 100% 0,
    transparent 0.5rem,
    var(--br-chrome) calc(0.5rem + 0.5px)
  );
}
:global(.scene[data-scenario]) .tab:focus-visible {
  z-index: 1;
}
:global(.scene[data-scenario]) .tab-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
:global(.scene[data-scenario]) .unseen {
  flex: none;
  border: 1px solid var(--br-unseen-line);
  border-radius: 999px;
  background: var(--br-unseen-bg);
  padding: 0 0.375rem;
  color: var(--br-unseen);
  font-size: 0.75rem;
  font-weight: 700;
  line-height: 1.4;
}
:global(.scene[data-scenario]) .fav {
  flex: none;
  width: 0.75rem;
  height: 0.75rem;
  border-radius: 50%;
}
:global(.scene[data-scenario]) .fav[data-shape="square"] {
  border-radius: 0.1875rem;
}
:global(.scene[data-scenario]) .fav[data-shape="rounded"] {
  border-radius: 0.25rem;
}
:global(.scene[data-scenario]) .fav[data-tone="teal"] {
  background: var(--br-fav-teal);
}
:global(.scene[data-scenario]) .fav[data-tone="violet"] {
  background: var(--br-fav-violet);
}
:global(.scene[data-scenario]) .fav[data-tone="ink"] {
  background: var(--br-fav-ink);
}
:global(.scene[data-scenario]) .fav[data-tone="coral"] {
  background: var(--br-fav-coral);
}
:global(.scene[data-scenario]) .fav[data-tone="blue"] {
  background: var(--br-fav-blue);
}
:global(.scene[data-scenario]) .fav[data-tone="azure"] {
  background: var(--br-fav-azure);
}
:global(.scene[data-scenario]) .fav[data-tone="plum"] {
  background: var(--br-fav-plum);
}
:global(.scene[data-scenario]) .chat-tab {
  display: none;
}
:global(.scene[data-scenario]) .chat-unread {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: 1.125rem;
  height: 1.125rem;
  border-radius: 999px;
  background: #e01e5a;
  padding: 0 0.3125rem;
  color: #ffffff;
  font-size: 0.75rem;
  font-weight: 700;
  line-height: 1;
}
:global(.scene[data-scenario]) .chat-unread[hidden] {
  display: none;
}
:global(.scene[data-scenario]) .tab-short {
  display: none;
}
:global(.scene[data-scenario]) .tab-icon {
  display: none;
}
@media (prefers-reduced-motion: no-preference) {
  :global(.scene[data-scenario]) .tab {
    transition: background-color 0.1s;
  }
}
@media (max-width: 639px) {
  :global(.scene[data-scenario]) .chat-tab {
    display: inline-flex;
  }
  :global(.scene[data-scenario]) .tab-short {
    display: inline;
    white-space: nowrap;
  }
  :global(.scene[data-scenario]) .tab[data-tool] .tab-title {
    position: absolute;
    width: 1px;
    height: 1px;
    clip-path: inset(50%);
  }
  :global(.scene[data-scenario]) .tab,
  :global(.scene[data-scenario]) .tab:hover:not([aria-selected="true"]),
  :global(.scene[data-scenario]) .tab[aria-selected="true"] {
    background: transparent;
  }
  :global(.scene[data-scenario]) .tab {
    z-index: 1;
    flex: 1 1 0;
    flex-direction: column;
    justify-content: center;
    gap: 0.0625rem;
    min-width: 3.25rem;
    min-height: 2.875rem;
    max-width: none;
    border-radius: 999px;
    padding: 0.25rem 0.25rem 0.1875rem;
    color: var(--dock-fg);
    font-size: 0.625rem;
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.02em;
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  :global(.scene[data-scenario]) .tab[aria-selected="true"] {
    color: var(--dock-on);
    font-weight: 700;
  }
  :global(.scene[data-scenario]) .tab .fav {
    display: none;
  }
  :global(.scene[data-scenario]) .tab-icon {
    display: block;
    width: 1.25rem;
    height: 1.25rem;
  }
  :global(.scene[data-scenario]) .unseen {
    position: absolute;
    top: 0.3125rem;
    left: calc(50% + 0.5rem);
    width: 0.375rem;
    height: 0.375rem;
    border: 0;
    background: var(--br-unseen-dot);
    padding: 0;
    overflow: hidden;
    color: transparent;
    font-size: 0;
  }
  :global(.scene[data-scenario]) .chat-unread {
    position: absolute;
    top: 0.125rem;
    left: calc(50% + 0.3125rem);
    min-width: 0.9375rem;
    height: 0.9375rem;
    padding: 0 0.25rem;
    font-size: 0.625rem;
    letter-spacing: 0;
  }
  :global(.scene[data-scenario]) .tab[aria-selected="true"]::before,
  :global(.scene[data-scenario]) .tab[aria-selected="true"]::after {
    display: none;
  }
}
@media (max-width: 639px) and (prefers-reduced-motion: no-preference) {
  :global(.scene[data-scenario]) .tab {
    transition: color 0.2s;
  }
  :global(.scene[data-scenario]) .tab-icon {
    transition: transform 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  :global(.scene[data-scenario]) .tab[aria-selected="true"] .tab-icon {
    animation: tab-pop 0.42s cubic-bezier(0.2, 0.9, 0.3, 1);
  }
  :global(.scene[data-scenario]) .tab:active .tab-icon {
    transform: scale(0.84);
  }
}
@keyframes tab-pop {
  0% {
    transform: scale(0.82);
  }
  55% {
    transform: scale(1.12);
  }
  100% {
    transform: scale(1);
  }
}
</style>
