---
import { titleOf } from '../../workspace/choice';
import type { PanelProps } from '../../workspace/panel-props';
import {
  chatPanelIdOf,
  chatTabIdOf,
  panelIdOf,
  tabIdOf,
} from '../../workspace/panel-props';

type Props =
  | (Pick<PanelProps, 'scenario' | 'tab'> & { selected: boolean })
  | (Pick<PanelProps, 'scenario'> & { chat: true });

const props = Astro.props;
const shownTitle = 'chat' in props
  ? ''
  : props.tab.kind === 'doc'
  ? titleOf(props.tab.title, props.tab.config.choice, false)
  : props.tab.title;
---

{
  'chat' in props
    ? (
    <button
      type="button"
      class="tab chat-tab"
      role="tab"
      id={chatTabIdOf(props.scenario)}
      data-chat-tab
      aria-selected="false"
      aria-controls={chatPanelIdOf(props.scenario)}
      tabindex="-1"
    >
      <span
        class="fav"
        aria-hidden="true"
        data-tone="plum"
        data-shape="rounded"
      ></span>
      <span class="tab-title">チャット</span>
      <span class="cfig-sr" data-chat-unread-label></span>
      <span class="chat-unread" data-chat-unread hidden aria-hidden="true"
      >0</span>
    </button>
  )
    : (
    <button
      type="button"
      class="tab"
      role="tab"
      id={tabIdOf(props.scenario, props.tab.key)}
      data-tool={props.tab.key}
      data-url={props.tab.url}
      aria-selected={props.selected ? 'true' : 'false'}
      aria-controls={panelIdOf(props.scenario, props.tab.key)}
      tabindex={props.selected ? 0 : -1}
      style={`--title-chars: ${shownTitle.length}`}
    >
      <span
        class="fav"
        aria-hidden="true"
        data-tone={props.tab.favicon.tone}
        data-shape={props.tab.favicon.shape}
      ></span>
      <span class="tab-title">{shownTitle}</span>
      <span class="cfig-sr">（{props.tab.label}）</span>
      <span class="unseen" data-unseen hidden={props.tab.seen === undefined}
      >未確認</span>
    </button>
  )
}

<style>
:global(.scene[data-scenario]) .tab {
  position: relative;
  display: inline-flex;
  align-items: center;
  flex: 0 clamp(0, calc(var(--title-chars, 0) - 14), 1) auto;
  gap: var(--space-2);
  min-width: 0;
  max-width: 100%;
  min-height: var(--tap-min);
  margin: 0;
  border: 0;
  border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  background: transparent;
  padding: 0 var(--space-3);
  color: var(--br-tab);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
  cursor: pointer;
}
:global(.scene[data-scenario]) .tab:hover:not([aria-selected="true"]) {
  background: var(--br-tab-hover);
}
:global(.scene[data-scenario]) .tab[aria-selected="true"] {
  background: var(--br-chrome);
  color: var(--br-text);
  font-weight: var(--weight-bold);
}
:global(.scene[data-scenario]) .tab[aria-selected="true"]::before,
:global(.scene[data-scenario]) .tab[aria-selected="true"]::after {
  content: "";
  position: absolute;
  bottom: 0;
  width: 0.5rem;
  height: 0.5rem;
}
:global(.scene[data-scenario]) .tab[aria-selected="true"]::before {
  left: -0.5rem;
  background: radial-gradient(
    circle at 0 0,
    transparent 0.5rem,
    var(--br-chrome) calc(0.5rem + 0.5px)
  );
}
:global(.scene[data-scenario]) .tab[aria-selected="true"]::after {
  right: -0.5rem;
  background: radial-gradient(
    circle at 100% 0,
    transparent 0.5rem,
    var(--br-chrome) calc(0.5rem + 0.5px)
  );
}
:global(.scene[data-scenario]) .tab:focus-visible {
  z-index: 1;
}
:global(.scene[data-scenario]) .tab-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
:global(.scene[data-scenario]) .unseen {
  flex: none;
  border: 1px solid var(--br-unseen-line);
  border-radius: var(--radius-pill);
  background: var(--br-unseen-bg);
  padding: 0 var(--space-2);
  color: var(--br-unseen);
  font-size: var(--text-note);
  font-weight: var(--weight-bold);
  line-height: var(--leading-normal);
}
:global(.scene[data-scenario]) .fav {
  flex: none;
  width: 0.75rem;
  height: 0.75rem;
  border-radius: 50%;
}
:global(.scene[data-scenario]) .fav[data-shape="square"] {
  border-radius: var(--radius-sm);
}
:global(.scene[data-scenario]) .fav[data-shape="rounded"] {
  border-radius: var(--radius-sm);
}
:global(.scene[data-scenario]) .fav[data-tone="teal"] {
  background: var(--br-fav-teal);
}
:global(.scene[data-scenario]) .fav[data-tone="violet"] {
  background: var(--br-fav-violet);
}
:global(.scene[data-scenario]) .fav[data-tone="ink"] {
  background: var(--br-fav-ink);
}
:global(.scene[data-scenario]) .fav[data-tone="coral"] {
  background: var(--br-fav-coral);
}
:global(.scene[data-scenario]) .fav[data-tone="blue"] {
  background: var(--br-fav-blue);
}
:global(.scene[data-scenario]) .fav[data-tone="azure"] {
  background: var(--br-fav-azure);
}
:global(.scene[data-scenario]) .fav[data-tone="plum"] {
  background: var(--br-fav-plum);
}
:global(.scene[data-scenario]) .chat-tab {
  display: none;
}
:global(.scene[data-scenario]) .chat-unread {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  min-width: 1.5rem;
  height: 1.5rem;
  border-radius: var(--radius-pill);
  background: #e01e5a;
  padding: 0 var(--space-1);
  color: #ffffff;
  font-size: var(--text-note);
  font-weight: var(--weight-bold);
  line-height: 1;
}
:global(.scene[data-scenario]) .chat-unread[hidden] {
  display: none;
}
@media (prefers-reduced-motion: no-preference) {
  :global(.scene[data-scenario]) .tab {
    transition: background-color 0.1s;
  }
}
@media (max-width: 639px) {
  :global(.scene[data-scenario]) .chat-tab {
    display: inline-flex;
  }
  :global(.scene[data-scenario]) .tab {
    flex: none;
  }
}
</style>
