---
interface Props {
  id?: string;
  label?: string;
  emptyLabel?: string;
  emptyText?: string;
  hideWhenEmpty?: boolean;
}
const {
  id = 'chapter-1',
  label = '第1章で挙げた問い',
  emptyLabel = '題材の問い',
  emptyText = 'この来院がキャンセルになっているのはなぜですか。',
  hideWhenEmpty = false,
} = Astro.props;
---

<div
  class="my-2 flex min-w-0"
  data-own-question-view
  data-question-id={id}
  data-filled-label={label}
  data-hide-when-empty={hideWhenEmpty ? 'true' : undefined}
  hidden={hideWhenEmpty}
>
  <span class="flex-none"><strong data-label>{emptyLabel}</strong>：</span>
  <span class="min-w-0 truncate" data-text>{emptyText}</span>
</div>

<script>
import { loadQuestion } from '../playground/storage.ts';

for (
  const root of document.querySelectorAll<HTMLElement>(
    '[data-own-question-view]',
  )
) {
  const label = root.querySelector<HTMLElement>('[data-label]');
  const text = root.querySelector<HTMLElement>('[data-text]');
  const id = root.dataset.questionId;
  if (label === null || text === null || id === undefined) continue;
  const filledLabel = root.dataset.filledLabel ?? '';
  const hideWhenEmpty = root.dataset.hideWhenEmpty === 'true';
  const initialLabel = label.textContent;
  const initialText = text.textContent;
  const show = (): void => {
    const question = loadQuestion(id)?.trim() ?? '';
    label.textContent = question === '' ? initialLabel : filledLabel;
    text.textContent = question === '' ? initialText : question;
    root.hidden = hideWhenEmpty && question === '';
    if (question === '') {
      text.removeAttribute('title');
    } else {
      text.title = question;
    }
  };
  show();
  window.addEventListener('pageshow', (event) => {
    if (event.persisted) show();
  });
}
</script>
