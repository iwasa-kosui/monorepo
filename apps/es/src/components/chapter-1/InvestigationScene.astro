---
import { Code } from 'astro:components';

import { cancelVisitOf, snapshotFiles } from '../../lib/snapshots';
import '../figures/figure.css';
import SqlPlayground from '../SqlPlayground.astro';

interface Props {
  id?: string;
}

const { id = 'investigation' } = Astro.props;

const files = snapshotFiles('chapter-1-start');
const sourceOf = (name: string): string => {
  const source = files[name];
  if (source === undefined) {
    throw new Error(`chapter-1-start に ${name} がありません`);
  }
  return source;
};

const tools = [
  {
    key: 'console',
    label: 'DB コンソール',
    url: 'https://db.internal.example/console',
  },
  {
    key: 'logs',
    label: 'ログの検索',
    url: 'https://logs.internal.example/logs',
  },
  {
    key: 'repo',
    label: 'リポジトリ',
    url: 'https://code.internal.example/clinic/visits.ts',
  },
] as const;

const unknownText = 'まだ分からない';
const memos = [
  { key: 'who', label: '誰が', text: 'どこにも残っていない' },
  { key: 'when', label: 'いつ', text: '2026-11-06 18:11:58' },
  { key: 'what', label: '何を', text: 'status が cancelled' },
  { key: 'why', label: 'なぜ', text: 'どこにも残っていない' },
] as const;
const memoResult = {
  who: 'missing',
  when: 'found',
  what: 'found',
  why: 'missing',
} as const;

const createVisits = /CREATE TABLE visits \([\s\S]*?\n\s*\);/.exec(
  sourceOf('db.ts'),
)?.[0];
if (createVisits === undefined) {
  throw new Error('db.ts から visits の CREATE TABLE 文を切り出せません');
}
const columns = createVisits.split('\n').slice(1, -1).map((line) => {
  const match = /^\s*(\w+)\s+(\w+)/.exec(line);
  if (match === null) {
    throw new Error(`visits の列の定義を読めません: ${line}`);
  }
  return { name: match[1] ?? '', type: match[2] ?? '' };
});
const setupSql = `${createVisits}
INSERT INTO visits (id, pet_name, status) VALUES
  ('visit-pochi', 'ポチ', 'cancelled'),
  ('visit-tama', 'タマ', 'cancelled');`;

const rawLogs = [
  '09:12:04.118Z INFO  POST /visits 201 15ms',
  '09:12:04.170Z INFO  GET /visits/visit-pochi 200 6ms',
  '10:31:47.902Z INFO  GET /visits 200 9ms',
  '11:05:13.356Z INFO  GET /visits/visit-tama 200 5ms',
  '12:48:30.611Z WARN  GET /visits/visit-9999 404 4ms',
  '13:20:09.045Z INFO  GET /visits 200 8ms',
  '14:02:55.730Z INFO  GET /visits/visit-pochi 200 5ms',
  '15:36:41.287Z INFO  GET /visits 200 7ms',
  '16:19:02.664Z INFO  GET /visits/visit-tama 200 6ms',
  '17:44:18.509Z INFO  GET /visits 200 8ms',
  '18:10:41.203Z INFO  GET /visits 200 8ms',
  '18:11:52.117Z INFO  GET /visits/visit-pochi 200 5ms',
  '18:11:58.846Z INFO  POST /visits/visit-pochi/cancel 200 12ms',
  '18:11:58.901Z INFO  GET /visits 200 7ms',
  '18:14:20.455Z INFO  GET /visits/visit-tama 200 5ms',
  '18:30:06.392Z INFO  GET /visits 200 9ms',
  '19:02:47.815Z INFO  GET /visits/visit-pochi 200 5ms',
  '19:45:33.076Z INFO  GET /visits 200 8ms',
  '20:10:59.248Z INFO  GET /visits 200 7ms',
  '21:03:12.530Z INFO  GET /visits/visit-tama 200 6ms',
];

const logs = rawLogs.map((line) => {
  const match =
    /^(\d{2}):(\d{2}):(\d{2}\.\d{3})Z (INFO|WARN)\s+(GET|POST) (\S+) (\d{3}) (\d+)ms$/
      .exec(line);
  if (match === null) {
    throw new Error(`ログの行を読めません: ${line}`);
  }
  const [
    ,
    hour = '',
    minute = '',
    second = '',
    level = '',
    method = '',
    path = '',
    status = '',
    duration = '',
  ] = match;
  const content = `${method} ${path} ${status} ${duration}ms`;
  const date = `Nov 06 ${hour}:${minute}:${second}`;
  return {
    iso: `2026-11-06T${hour}:${minute}:${second}Z`,
    date,
    hour: Number(hour),
    level: level.toLowerCase(),
    levelLabel: level,
    method,
    content,
    text: `${date} ${content}`.toLowerCase(),
    cancel: method === 'POST' && path === '/visits/visit-pochi/cancel',
    attrs: [
      ['http.method', method],
      ['http.url', path],
      ['http.status_code', status],
      ['duration', duration],
      ['network.client.ip', '10.0.3.21'],
      ['http.useragent', 'Mozilla/5.0'],
    ],
  };
});

const countBy = (pick: (log: (typeof logs)[number]) => string, value: string) =>
  logs.filter((log) => pick(log) === value).length;
const facets = [
  {
    key: 'service',
    label: 'Service',
    items: [{ value: 'clinic-api', label: 'clinic-api', count: logs.length }],
  },
  {
    key: 'status',
    label: 'Status',
    items: [
      {
        value: 'info',
        label: 'Info',
        count: countBy((log) => log.level, 'info'),
      },
      {
        value: 'warn',
        label: 'Warn',
        count: countBy((log) => log.level, 'warn'),
      },
    ],
  },
  {
    key: 'method',
    label: 'HTTP Method',
    items: [
      {
        value: 'GET',
        label: 'GET',
        count: countBy((log) => log.method, 'GET'),
      },
      {
        value: 'POST',
        label: 'POST',
        count: countBy((log) => log.method, 'POST'),
      },
    ],
  },
] as const;

const hours = Array.from({ length: 24 }, (_, hour) => ({
  hour,
  count: logs.filter((log) => log.hour === hour).length,
  warn: logs.some((log) => log.hour === hour && log.level === 'warn'),
}));
const maxCount = Math.max(...hours.map((hour) => hour.count));
const chartLabel = `1時間ごとのログ件数。合計 ${logs.length} 件。最も多いのは ${
  hours.find((hour) => hour.count === maxCount)?.hour ?? 0
} 時台の ${maxCount} 件。Warn を含む時間帯は ${
  hours.filter((hour) => hour.warn).map((hour) => `${hour.hour} 時台`).join(
    '、',
  )
}。`;

const code = sourceOf('visits.ts').trimEnd();

const tabId = (key: string): string => `${id}-tab-${key}`;
const panelId = (key: string): string => `${id}-panel-${key}`;

const cancelLog = logs.find((log) => log.cancel);
if (cancelLog === undefined) {
  throw new Error('キャンセルのログがありません');
}
const cancelVisitCode = cancelVisitOf('chapter-1-start');
const agentUrl = 'https://agent.internal.example/sessions/1';
const agentConclusion = [
  { label: 'いつ', text: '2026-11-06 18:11:58' },
  { label: '何を', text: 'status を cancelled に更新' },
  { label: '誰が', text: '特定できません' },
  { label: 'なぜ', text: '特定できません' },
] as const;
---

<section
  class="cfig scene"
  data-investigation
  data-opened=""
  data-selected="console"
  data-phase="initial"
  aria-label="来院のキャンセル理由の調査"
>
  <div class="win chat" role="group" aria-label="チャット">
    <div class="win-bar">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <p class="channel"># 問い合わせ対応</p>
    </div>

    <ol
      class="feed"
      aria-live="polite"
      aria-label="チャットの投稿"
      tabindex="0"
      data-feed
    >
      <li class="post">
        <span class="avatar" aria-hidden="true">カ</span>
        <div class="post-main">
          <p class="post-head">
            <strong>カスタマーサポート</strong>
            <time>10:02</time>
          </p>
          <p class="post-text">
            動物病院から問い合わせが来ています。『この来院がキャンセルになっているのはなぜですか。』ポチの来院（visit-pochi）です。誰が、いつ、なぜキャンセルしたのか、調べてもらえますか。
          </p>
        </div>
      </li>
    </ol>

    <template data-replies>
      <li class="post is-you" data-reply>
        <span class="avatar" aria-hidden="true">あ</span>
        <div class="post-main">
          <p class="post-head"><strong>あなた</strong></p>
          <p class="post-text">
            2026-11-06 18:11:58
            にキャンセルの操作がありました。誰が、なぜキャンセルしたのかは、どこにも残っていませんでした。
          </p>
        </div>
      </li>
      <li class="post" data-reply>
        <span class="avatar" aria-hidden="true">カ</span>
        <div class="post-main">
          <p class="post-head"><strong>カスタマーサポート</strong></p>
          <p class="post-text">なんで記録取ってないんですか</p>
        </div>
      </li>
    </template>

    <div class="composer">
      <p class="memo-title" id={`${id}-memo`}>返信の下書き（調査メモ）</p>
      <dl
        class="memo-list"
        aria-labelledby={`${id}-memo`}
        data-unknown={unknownText}
      >
        {
          memos.map((memo) => (
            <div class="memo-row">
              <dt>{memo.label}</dt>
              <dd
                data-memo={memo.key}
                data-state="unknown"
                data-result={memoResult[memo.key]}
                data-text={memo.text}
              >
                {unknownText}
              </dd>
            </div>
          ))
        }
      </dl>
      <p class="reason" id={`${id}-reason`} data-reason>
        3つのツールをすべて開くと返信できます。
      </p>
      <div class="actions">
        <button
          type="button"
          class="primary"
          data-action="reply"
          aria-describedby={`${id}-reason`}
          disabled
        >
          調査結果を返信する
        </button>
        <button type="button" data-action="answer">答えを見る</button>
      </div>
    </div>
  </div>

  <div class="win browser" role="group" aria-label="ブラウザ">
    <div class="win-bar tab-strip">
      <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <div class="tabs" role="tablist" aria-label="開くツール">
        {
          tools.map((tool) => (
            <button
              type="button"
              class="tab"
              role="tab"
              id={tabId(tool.key)}
              data-tool={tool.key}
              data-url={tool.url}
              aria-selected={tool.key === 'console' ? 'true' : 'false'}
              aria-controls={panelId(tool.key)}
              tabindex={tool.key === 'console' ? 0 : -1}
            >
              {tool.label} <span class="unseen" data-unseen>未確認</span>
            </button>
          ))
        }
      </div>
    </div>
    <p class="address">
      <span class="cfig-sr">アドレス</span>
      <span class="address-text" data-address>{tools[0].url}</span>
    </p>

    <div class="pages">
      <div
        class="panel"
        role="tabpanel"
        id={panelId('console')}
        aria-labelledby={tabId('console')}
        data-tool="console"
      >
        <div class="console">
          <div class="tables" role="group" aria-label="テーブルの一覧">
            <p class="side-title">Tables</p>
            <button type="button" class="table-item" data-table="visits">
              visits
            </button>
            <ul class="columns" aria-label="visits の列">
              {
                columns.map((column) => (
                  <li>
                    <code>{column.name}</code>
                    <span>{column.type}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <SqlPlayground
            id="chapter-1-console"
            setup={setupSql}
            initial="SELECT * FROM visits;"
          />
        </div>
        <p class="panel-note">いまの状態だけが入っています。</p>
      </div>

      <div
        class="panel"
        role="tabpanel"
        id={panelId('logs')}
        aria-labelledby={tabId('logs')}
        data-tool="logs"
        hidden
      >
        <div class="logs">
          <div class="facets" role="group" aria-label="ログの絞り込み">
            {
              facets.map((facet) => (
                <fieldset class="facet">
                  <legend>{facet.label}</legend>
                  {
                    facet.items.map((item) => (
                      <label class="facet-item">
                        <input
                          type="checkbox"
                          data-facet={facet.key}
                          value={item.value}
                        />
                        <span class="facet-name">{item.label}</span>
                        <span class="facet-count" data-facet-count>{
                          item.count
                        }</span>
                      </label>
                    ))
                  }
                </fieldset>
              ))
            }
          </div>

          <div class="logs-main">
            <div class="search-row">
              <label class="cfig-sr" for={`${id}-query`}
              >ログの検索クエリ</label>
              <input
                type="search"
                class="query"
                id={`${id}-query`}
                value="service:clinic-api"
                spellcheck="false"
                autocomplete="off"
                data-query
                data-initial="service:clinic-api"
              />
              <span class="range">Nov 6, 2026 00:00 – 23:59</span>
            </div>

            <div class="chart" role="img" aria-label={chartLabel} data-chart>
              <div class="bars" aria-hidden="true">
                {
                  hours.map((hour) => (
                    <span
                      class="bar"
                      data-warn={hour.warn ? 'true' : 'false'}
                      style={`height: ${
                        hour.count === 0
                          ? 0
                          : Math.max(
                            8,
                            Math.round(
                              hour.count / maxCount * 100,
                            ),
                          )
                      }%`}
                    >
                    </span>
                  ))
                }
              </div>
              <div class="axis" aria-hidden="true">
                <span>00:00</span>
                <span>06:00</span>
                <span>12:00</span>
                <span>18:00</span>
                <span>24:00</span>
              </div>
            </div>

            <p class="log-count" data-log-count>
              {logs.length}件中 {logs.length}件
            </p>

            <div
              class="log-scroll"
              role="region"
              aria-label="ログの一覧"
              data-log-scroll
            >
              <table class="log-table">
                <thead>
                  <tr>
                    <th scope="col">DATE</th>
                    <th scope="col">HOST</th>
                    <th scope="col">SERVICE</th>
                    <th scope="col">CONTENT</th>
                  </tr>
                </thead>
                <tbody>
                  {
                    logs.map((log) => (
                      <tr
                        class="log-row"
                        tabindex="0"
                        data-log-row
                        data-level={log.level}
                        data-method={log.method}
                        data-hour={log.hour}
                        data-text={log.text}
                        data-cancel={log.cancel ? 'true' : 'false'}
                        data-date={log.iso}
                        data-content={log.content}
                        data-attrs={JSON.stringify(log.attrs)}
                      >
                        <td class="col-date">
                          <time datetime={log.iso}>{log.date}</time>
                        </td>
                        <td>clinic-api-1</td>
                        <td>clinic-api</td>
                        <td class="col-content">
                          <span class="level" data-level={log.level}>{
                            log.levelLabel
                          }</span>
                          <span>{log.content}</span>
                        </td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
              <p class="log-empty" data-empty hidden>
                条件に合うログはありません。
              </p>
            </div>

            <div
              class="detail"
              role="region"
              aria-label="ログの詳細"
              data-detail
              hidden
            >
              <div class="detail-head">
                <p class="detail-title">Log</p>
                <button
                  type="button"
                  data-detail-close
                  aria-label="ログの詳細を閉じる"
                >
                  閉じる
                </button>
              </div>
              <div class="detail-body">
                <p class="detail-message" data-detail-field="message"></p>
                <dl class="detail-summary">
                  <div>
                    <dt>Date</dt>
                    <dd data-detail-field="date"></dd>
                  </div>
                  <div>
                    <dt>Status</dt>
                    <dd data-detail-field="status"></dd>
                  </div>
                  <div>
                    <dt>Service</dt>
                    <dd>clinic-api</dd>
                  </div>
                  <div>
                    <dt>Host</dt>
                    <dd>clinic-api-1</dd>
                  </div>
                </dl>
                <p class="detail-section">Event Attributes</p>
                <dl class="detail-attrs">
                  <div>
                    <dt>http.method</dt>
                    <dd data-detail-attr="http.method"></dd>
                  </div>
                  <div>
                    <dt>http.url</dt>
                    <dd data-detail-attr="http.url"></dd>
                  </div>
                  <div>
                    <dt>http.status_code</dt>
                    <dd data-detail-attr="http.status_code"></dd>
                  </div>
                  <div>
                    <dt>duration</dt>
                    <dd data-detail-attr="duration"></dd>
                  </div>
                  <div>
                    <dt>network.client.ip</dt>
                    <dd data-detail-attr="network.client.ip"></dd>
                  </div>
                  <div>
                    <dt>http.useragent</dt>
                    <dd data-detail-attr="http.useragent"></dd>
                  </div>
                </dl>
              </div>
            </div>
          </div>
        </div>
        <p class="panel-note">
          キャンセルの操作があった時刻は分かります。理由と操作した人は、ログの属性にありません。
        </p>
      </div>

      <div
        class="panel"
        role="tabpanel"
        id={panelId('repo')}
        aria-labelledby={tabId('repo')}
        data-tool="repo"
        hidden
      >
        <div class="repo-head">
          <span class="repo-path">clinic / <strong>visits.ts</strong></span>
        </div>
        <Code code={code} lang="ts" />
        <p class="panel-note">
          status
          を書き換えるだけで、理由と操作した人はどこにも保存していません。
        </p>
      </div>
    </div>
  </div>

  <div class="scene-foot">
    <button type="button" data-action="reset">最初からやり直す</button>
  </div>

  <template data-agent-tab>
    <button
      type="button"
      class="tab"
      role="tab"
      id={tabId('agent')}
      data-tool="agent"
      data-url={agentUrl}
      aria-selected="false"
      aria-controls={panelId('agent')}
      tabindex="-1"
    >
      エージェント
    </button>
  </template>

  <template data-agent-panel>
    <div
      class="panel"
      role="tabpanel"
      id={panelId('agent')}
      aria-labelledby={tabId('agent')}
      data-tool="agent"
      hidden
    >
      <div class="agent-bar">
        <span class="agent-brand">Coding Agent</span>
        <span class="agent-session">visit-pochi のキャンセルの調査</span>
        <span class="agent-status" data-agent-status data-state="running"
        >実行中</span>
      </div>
      <div
        class="agent-log"
        role="log"
        aria-label="エージェントの会話"
        tabindex="0"
        data-agent-log
      >
        <ol class="turns" data-agent-list></ol>
      </div>
      <div class="agent-composer">
        <label class="cfig-sr" for={`${id}-agent-input`}
        >エージェントへの依頼</label>
        <textarea
          class="agent-input"
          id={`${id}-agent-input`}
          rows="2"
          placeholder="依頼を入力"
          data-agent-input
        ></textarea>
        <button type="button" class="agent-send" data-agent-send disabled>
          送信
        </button>
      </div>
    </div>
  </template>

  <template data-agent-parts>
    <li class="turn user" data-part="user">
      <p class="bubble" data-text></p>
    </li>
    <li class="turn agent" data-part="reply">
      <p data-text></p>
    </li>
    <li class="thinking" data-part="thinking" data-thinking>
      <span class="thinking-mark" aria-hidden="true"></span>考え中…
    </li>
  </template>

  <template data-agent-steps>
    <li class="turn user" data-kind="user">
      <p class="bubble">
        visit-pochi
        の来院がキャンセルになっています。誰が、いつ、なぜキャンセルしたのかを調べてください。
      </p>
    </li>
    <li class="turn agent" data-kind="agent">
      <p>データベース、ログ、コードの順に調べます。</p>
    </li>
    <li class="turn tool" data-kind="tool" data-state="done">
      <details>
        <summary>
          <span class="tool-state" aria-hidden="true"></span>
          <span class="cfig-sr" data-tool-state-text>完了</span>
          <span class="tool-name">SQL</span>
          <code class="tool-target"
          >SELECT * FROM visits WHERE id = 'visit-pochi';</code>
        </summary>
        <div class="tool-body" data-tool-body>
          <table class="tool-table">
            <thead>
              <tr>
                <th scope="col">id</th>
                <th scope="col">pet_name</th>
                <th scope="col">status</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>visit-pochi</td>
                <td>ポチ</td>
                <td>cancelled</td>
              </tr>
            </tbody>
          </table>
          <button type="button" data-open-tool="console">
            この画面を開く<span class="cfig-sr">（DB コンソール）</span>
          </button>
        </div>
      </details>
    </li>
    <li class="turn agent" data-kind="agent">
      <p>
        status は cancelled です。キャンセルした人、理由、日時の列はありません。
      </p>
    </li>
    <li class="turn tool" data-kind="tool" data-state="done">
      <details>
        <summary>
          <span class="tool-state" aria-hidden="true"></span>
          <span class="cfig-sr" data-tool-state-text>完了</span>
          <span class="tool-name">Logs</span>
          <code class="tool-target">service:clinic-api visit-pochi</code>
        </summary>
        <div class="tool-body" data-tool-body>
          <p class="tool-line">
            <code>{cancelLog.iso} {cancelLog.content}</code>
          </p>
          <dl class="tool-attrs">
            {
              cancelLog.attrs.map(([key, value]) => (
                <div>
                  <dt>{key}</dt>
                  <dd>{value}</dd>
                </div>
              ))
            }
          </dl>
          <button type="button" data-open-tool="logs">
            この画面を開く<span class="cfig-sr">（ログの検索）</span>
          </button>
        </div>
      </details>
    </li>
    <li class="turn agent" data-kind="agent">
      <p>
        2026-11-06 18:11:58
