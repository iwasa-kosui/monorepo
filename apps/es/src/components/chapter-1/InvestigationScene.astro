</style>

<script>
import { clockOf, describeLog, minuteOf } from './incident-log';
import {
  actors,
  earlierLogs,
  heartbeat,
  initialAffected,
  interim,
  reply,
  startedAt,
  timeline,
  visibleFromMinutes,
} from './incident-scenario';
import type { LogEntry, Post, TimedEvent } from './incident-scenario';

const tools = ['console', 'logs', 'repo'] as const;
type Tool = (typeof tools)[number];
const isTool = (value: string | undefined): value is Tool =>
  tools.some((tool) => tool === value);

type LogRow = {
  element: HTMLTableRowElement;
  level: string;
  method: string;
  time: number;
  text: string;
  cancel: boolean;
  date: string;
  content: string;
  attrs: Map<string, string>;
  dynamic: boolean;
};

type Status = 'idle' | 'running' | 'paused' | 'ended';
type Pending = { at: number; run: () => void };

const minuteMs = 60_000;
const tickMs = 250;
const maxDynamicRows = 600;

const formatElapsed = (ms: number): string => {
  const total = Math.floor(ms / 1000);
  const pad = (value: number): string => String(value).padStart(2, '0');
  return `${pad(Math.floor(total / 60))}:${pad(total % 60)}`;
};

for (
  const root of document.querySelectorAll<HTMLElement>('[data-investigation]')
) {
  const must = <T extends Element>(selector: string): T => {
    const found = root.querySelector<T>(selector);
    if (found === null) {
      throw new Error(`要素が見つかりません: ${selector}`);
    }
    return found;
  };

  const tabList = must<HTMLElement>('[role="tablist"]');
  const pages = must<HTMLElement>('.pages');
  const tabsOf = (): HTMLButtonElement[] => [
    ...root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
  ];
  const panelsOf = (): HTMLElement[] => [
    ...root.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
  ];
  const agentTab = must<HTMLTemplateElement>('template[data-agent-tab]');
  const agentPanel = must<HTMLTemplateElement>('template[data-agent-panel]');
  const agentSteps = must<HTMLTemplateElement>('template[data-agent-steps]');
  const agentParts = must<HTMLTemplateElement>('template[data-agent-parts]');
  const postTemplate = must<HTMLTemplateElement>('template[data-post]');
  const rowTemplate = must<HTMLTemplateElement>(
    'template[data-log-row-template]',
  );
  const address = must<HTMLElement>('[data-address]');
  const feed = must<HTMLElement>('[data-feed]');
  const reason = must<HTMLElement>('[data-reason]');
  const memoList = must<HTMLElement>('[data-unknown]');
  const memos = [...root.querySelectorAll<HTMLElement>('[data-memo]')];
  const replyButton = must<HTMLButtonElement>('[data-action="reply"]');
  const interimButton = must<HTMLButtonElement>('[data-action="interim"]');
  const answerButton = must<HTMLButtonElement>('[data-action="answer"]');
  const resetButton = must<HTMLButtonElement>('[data-action="reset"]');
  const pauseButton = must<HTMLButtonElement>('[data-action="pause"]');
  const startButton = must<HTMLButtonElement>('[data-action="start"]');
  const startPanel = must<HTMLElement>('[data-start]');
  const elapsedText = must<HTMLElement>('[data-elapsed]');
  const clockText = must<HTMLElement>('[data-clock]');
  const affectedText = must<HTMLElement>('[data-affected]');
  const live = must<HTMLElement>('[data-live]');
  const windows = [...root.querySelectorAll<HTMLElement>('[data-window]')];
  const unknownText = memoList.dataset.unknown ?? '';

  const playground = must<HTMLElement>('[data-playground="sql"]');
  const results = must<HTMLElement>('[data-role="results"]');
  const resetSql = must<HTMLButtonElement>('[data-role="reset-sql"]');
  const restoreSql = must<HTMLButtonElement>('[data-role="restore"]');

  const query = must<HTMLInputElement>('[data-query]');
  const logCount = must<HTMLElement>('[data-log-count]');
  const logEmpty = must<HTMLElement>('[data-empty]');
  const logBody = must<HTMLElement>('[data-log-body]');
  const chart = must<HTMLElement>('[data-chart]');
  const bars = [...chart.querySelectorAll<HTMLElement>('.bar')];
  const axes = [...chart.querySelectorAll<HTMLElement>('[data-tick]')];
  const facetInputs = [
    ...root.querySelectorAll<HTMLInputElement>('[data-facet]'),
  ];
  const detail = must<HTMLElement>('[data-detail]');
  const detailClose = must<HTMLButtonElement>('[data-detail-close]');

  const parseRow = (): HTMLTableRowElement => {
    const element = rowTemplate.content.querySelector('tr')?.cloneNode(true);
    if (!(element instanceof HTMLTableRowElement)) {
      throw new Error('ログの行の部品が見つかりません');
    }
    return element;
  };

  const rows: LogRow[] = [];
  const state = {
    selected: 'console' as string,
    opened: new Set<Tool>(),
    agent: false,
    revealed: false,
    replied: false,
    current: null as LogRow | null,
    status: 'idle' as Status,
    affected: initialAffected,
  };

  let startedMs = 0;
  let pausedAt: number | null = null;
  let pausedTotal = 0;
  let frozenMs: number | null = null;
  let intervalId: number | undefined;
  let queue: Pending[] = [];
  let nextBeat = 1;
  let shownMinute = -1;

  const elapsedMs = (): number => {
    if (state.status === 'idle') return 0;
    if (frozenMs !== null) return frozenMs;
    return Math.max(0, (pausedAt ?? Date.now()) - startedMs - pausedTotal);
  };

  const facetValue = (row: LogRow, facet: string): string =>
    facet === 'status'
      ? row.level
      : facet === 'method'
      ? row.method
      : 'clinic-api';

  const matchesToken = (row: LogRow, token: string): boolean => {
    const pair = /^(@?[\w.]+):(.+)$/.exec(token);
    if (pair !== null) {
      const key = pair[1] ?? '';
      const value = (pair[2] ?? '').toLowerCase();
      if (key === 'service') return value === 'clinic-api';
      if (key === 'host') return value === 'clinic-api-1';
      if (key === 'status') return row.level === value;
      if (key.startsWith('@')) {
        const attr = row.attrs.get(key.slice(1));
        if (attr !== undefined) return attr.toLowerCase() === value;
      }
    }
    return row.text.includes(token.toLowerCase());
  };

  const showsPochiStatus = (): boolean => {
    for (const result of results.querySelectorAll('.playground-result')) {
      const heads = [...result.querySelectorAll('thead th')].map((cell) =>
        cell.textContent
      );
      if (!heads.includes('status')) continue;
      const body = [...result.querySelectorAll('tbody tr')];
      const statement =
        result.querySelector('.playground-statement code')?.textContent ?? '';
      const named = body.some((row) =>
        [...row.querySelectorAll('td')].some((cell) =>
          cell.textContent === 'visit-pochi'
        )
      );
      if (named || (body.length > 0 && statement.includes('visit-pochi'))) {
        return true;
      }
    }
    return false;
  };

  const refreshLogs = (): void => {
    const tokens = query.value.split(/\s+/).filter((token) => token !== '');
    const byQuery = rows.filter((row) =>
      tokens.every((token) => matchesToken(row, token))
    );
    const checked = new Map<string, Set<string>>();
    for (const input of facetInputs) {
      const facet = input.dataset.facet ?? '';
      const count = byQuery.filter((row) =>
        facetValue(row, facet) === input.value
      ).length;
      const label = input.closest('label')?.querySelector('[data-facet-count]');
      if (label !== null && label !== undefined) {
        label.textContent = String(count);
      }
      if (input.checked) {
        checked.set(
          facet,
          (checked.get(facet) ?? new Set<string>()).add(input.value),
        );
      }
    }
    const shown = byQuery.filter((row) =>
      [...checked].every(([facet, values]) =>
        values.has(facetValue(row, facet))
      )
    );
    const shownSet = new Set(shown);
    for (const row of rows) {
      row.element.hidden = !shownSet.has(row);
    }
    logCount.textContent = `${rows.length}件中 ${shown.length}件`;
    logEmpty.hidden = shown.length !== 0;

    const now = startedAt + elapsedMs();
    const lastBar = Math.floor(now / minuteMs) * minuteMs;
    const firstBar = lastBar - visibleFromMinutes * minuteMs;
    shownMinute = lastBar;
    const counts = bars.map((_, index) =>
      shown.filter((row) =>
        Math.floor((row.time - firstBar) / minuteMs) === index
      )
    );
    const peak = Math.max(...counts.map((list) => list.length));
    bars.forEach((bar, index) => {
      const list = counts[index] ?? [];
      bar.style.height = list.length === 0
        ? '0%'
        : `${Math.max(8, Math.round(list.length / peak * 100))}%`;
      bar.dataset.warn = String(list.some((row) => row.level === 'warn'));
    });
    for (const axis of axes) {
      axis.textContent = minuteOf(
        firstBar + Number(axis.dataset.tick ?? '0') * minuteMs,
      );
    }
    const total = counts.reduce((sum, list) => sum + list.length, 0);
    const warnMinutes = counts.flatMap((list, index) =>
      list.some((row) => row.level === 'warn')
        ? [minuteOf(firstBar + index * minuteMs)]
        : []
    );
    const peakIndex = counts.findIndex((list) => list.length === peak);
    chart.setAttribute(
      'aria-label',
      total === 0
        ? '1分ごとのログ件数。表示中のログはありません。'
        : `1分ごとのログ件数。合計 ${total} 件。最も多いのは ${
          minuteOf(firstBar + peakIndex * minuteMs)
        } の ${peak} 件。${
          warnMinutes.length === 0
            ? 'Warn を含む時間帯はありません。'
            : `Warn を含む時間帯は ${warnMinutes.join('、')}。`
        }`,
    );
    if (state.current !== null && state.current.element.hidden) {
      closeDetail(false);
    }
  };

  const fillDetail = (row: LogRow): void => {
    for (
      const field of detail.querySelectorAll<HTMLElement>('[data-detail-field]')
    ) {
      const key = field.dataset.detailField;
      field.textContent = key === 'message'
        ? row.content
        : key === 'date'
        ? row.date
        : row.level === 'warn'
        ? 'Warn'
        : 'Info';
    }
    for (
      const attr of detail.querySelectorAll<HTMLElement>('[data-detail-attr]')
    ) {
      attr.textContent = row.attrs.get(attr.dataset.detailAttr ?? '') ?? '';
    }
  };

  const openDetail = (row: LogRow): void => {
    state.current?.element.removeAttribute('aria-current');
    state.current = row;
    row.element.setAttribute('aria-current', 'true');
    fillDetail(row);
    detail.hidden = false;
    if (row.cancel) state.opened.add('logs');
    render();
    detailClose.focus();
  };

  function closeDetail(restoreFocus: boolean): void {
    const row = state.current;
    state.current = null;
    row?.element.removeAttribute('aria-current');
    detail.hidden = true;
    if (restoreFocus && row !== null && !row.element.hidden) {
      row.element.focus();
    }
  }

  const addRow = (entry: LogEntry, time: number, dynamic: boolean): void => {
    const view = describeLog(entry, time);
    const element = parseRow();
    element.dataset.level = view.level;
    element.dataset.method = view.method;
    element.dataset.cancel = String(view.cancel);
    element.dataset.date = view.iso;
    const dateCell = element.querySelector<HTMLElement>('[data-log-date]');
    if (dateCell !== null) {
      dateCell.textContent = view.date;
      dateCell.setAttribute('datetime', view.iso);
    }
    const levelCell = element.querySelector<HTMLElement>('[data-log-level]');
    if (levelCell !== null) {
      levelCell.textContent = view.levelLabel;
      levelCell.dataset.level = view.level;
    }
    const contentCell = element.querySelector<HTMLElement>(
      '[data-log-content]',
    );
    if (contentCell !== null) contentCell.textContent = view.content;
    const row: LogRow = {
      element,
      level: view.level,
      method: view.method,
      time: view.time,
      text: view.text,
      cancel: view.cancel,
      date: view.iso,
      content: view.content,
      attrs: new Map(view.attrs),
      dynamic,
    };
    element.addEventListener('click', () => openDetail(row));
    element.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openDetail(row);
    });
    rows.push(row);
    logBody.prepend(element);
  };

  const trimRows = (): void => {
    let dynamicCount = rows.filter((row) => row.dynamic).length;
    while (dynamicCount > maxDynamicRows) {
      const index = rows.findIndex((row) => row.dynamic);
      const [removed] = rows.splice(index, 1);
      if (removed === undefined) break;
      if (state.current === removed) closeDetail(false);
      removed.element.remove();
      dynamicCount -= 1;
    }
  };

  const loadEarlierLogs = (): void => {
    const from = startedAt - visibleFromMinutes * minuteMs;
    for (const entry of earlierLogs) {
      const time = Date.parse(entry.time);
      if (time >= from) addRow(entry, time, false);
    }
  };

  const addPost = (post: Post, at: number): void => {
    const copy = postTemplate.content.querySelector('li')?.cloneNode(true);
    if (!(copy instanceof HTMLElement)) {
      throw new Error('投稿の部品が見つかりません');
    }
    const actor = actors[post.actor];
    copy.classList.toggle('is-you', post.actor === 'you');
    const fill = (selector: string, text: string): void => {
      const target = copy.querySelector(selector);
      if (target !== null) target.textContent = text;
    };
    fill('[data-avatar]', actor.avatar);
    fill('[data-name]', actor.name);
    fill('[data-time]', minuteOf(startedAt + at));
    fill('[data-text]', post.text);
    feed.append(copy);
    feed.scrollTop = feed.scrollHeight;
  };

  const reasonText = (): string => {
    const missing = tools.filter((tool) => !state.opened.has(tool));
    if (missing.length === tools.length) {
      return '3つのツールをすべて開くと返信できます。';
    }
    if (missing.length >= 2) {
      return `あと${missing.length}つのツールを開くと返信できます。`;
    }
    if (missing[0] === 'console') {
      return 'DB コンソールで、visit-pochi の status を表示すると返信できます。';
    }
    if (missing[0] === 'logs') {
      return 'ログの検索で、キャンセルの操作のログを開くと返信できます。';
    }
    return 'リポジトリのタブを開くと返信できます。';
  };

  const renderClock = (): void => {
    const ms = elapsedMs();
    elapsedText.textContent = formatElapsed(ms);
    clockText.textContent = clockOf(startedAt + ms);
    affectedText.textContent = `${state.affected}件`;
  };

  function render(): void {
    const ready = state.revealed
      || tools.every((tool) => state.opened.has(tool));
    const known = {
      what: state.revealed || state.opened.has('console'),
      when: state.revealed || state.opened.has('logs'),
      who: ready,
      why: ready,
    };
    const started = state.status === 'running' || state.status === 'paused';
    root.dataset.opened = [...state.opened].join(' ');
    root.dataset.selected = state.selected;
    root.dataset.ready = String(ready);
    root.dataset.phase = state.status === 'idle'
      ? 'idle'
      : state.status === 'ended'
      ? 'ended'
      : state.status === 'paused'
      ? 'paused'
      : state.replied
      ? 'replied'
      : 'running';
    startPanel.hidden = state.status !== 'idle';
    for (const element of windows) {
      element.inert = state.status === 'idle';
    }
    live.dataset.state = state.status === 'running' ? 'on' : 'off';
    pauseButton.textContent = state.status === 'paused'
      ? '再開する'
      : '一時停止';
    pauseButton.disabled = !started;
    resetButton.disabled = state.status === 'idle';
    interimButton.disabled = !started || state.replied;
    const tabs = tabsOf();
    for (const tab of tabs) {
      const tool = tab.dataset.tool;
      const isSelected = tool === state.selected;
      tab.setAttribute('aria-selected', String(isSelected));
      tab.tabIndex = isSelected ? 0 : -1;
      const unseen = tab.querySelector<HTMLElement>('[data-unseen]');
      if (unseen !== null) {
        unseen.hidden = isTool(tool) && state.opened.has(tool);
      }
    }
    for (const panel of panelsOf()) {
      panel.hidden = panel.dataset.tool !== state.selected;
    }
    const selectedTab = tabs.find((tab) => tab.dataset.tool === state.selected);
    address.textContent = selectedTab?.dataset.url ?? '';
    for (const memo of memos) {
      const key = memo.dataset.memo;
      const isKnown =
        key === 'what' || key === 'when' || key === 'who' || key === 'why'
          ? known[key]
          : false;
      memo.dataset.state = isKnown
        ? memo.dataset.result ?? 'unknown'
        : 'unknown';
      memo.textContent = isKnown ? memo.dataset.text ?? '' : unknownText;
    }
    answerButton.disabled = state.agent;
    replyButton.disabled = !ready || !started;
    replyButton.hidden = state.replied;
    reason.hidden = ready || state.replied;
    reason.textContent = reasonText();
    renderClock();
  }

  const stopInterval = (): void => {
    window.clearInterval(intervalId);
    intervalId = undefined;
  };

  const insertPending = (items: Pending[]): void => {
    queue = [...queue, ...items].sort((a, b) => a.at - b.at);
  };

  const heartbeatAt = (index: number): number =>
    index * heartbeat.everySeconds * 1000;

  const addHeartbeat = (index: number): void => {
    const request = heartbeat.requests[(index - 1) % heartbeat.requests.length];
    if (request === undefined) return;
    const duration = heartbeat.durations[
      (index - 1) % heartbeat.durations.length
    ] ?? 0;
    const millis = heartbeat.millis[(index - 1) % heartbeat.millis.length] ?? 0;
    addRow(
      {
        level: 'INFO',
        method: request.method,
        path: request.path,
        status: 200,
        duration,
      },
      startedAt + heartbeatAt(index) + millis,
      true,
    );
  };

  const perform = (event: TimedEvent): void => {
    if (event.kind === 'post') {
      if (event.unlessReplied === true && state.replied) return;
      addPost(event.post, event.at * 1000);
    } else if (event.kind === 'log') {
      addRow(event.entry, startedAt + event.at * 1000 + event.millis, true);
    } else if (event.kind === 'sql') {
      playground.dispatchEvent(
        new CustomEvent('playground:exec-sql', { detail: { sql: event.sql } }),
      );
    } else {
      state.affected = event.count;
    }
  };

  const finish = (at: number): void => {
    state.status = 'ended';
    frozenMs = at;
    stopInterval();
    refreshLogs();
    render();
  };

  const tick = (): void => {
    if (state.status !== 'running') return;
    const now = elapsedMs();
    let changed = false;
    for (;;) {
      const head = queue[0];
      const beatAt = heartbeatAt(nextBeat);
      if (beatAt <= now && (head === undefined || beatAt <= head.at)) {
        addHeartbeat(nextBeat);
        nextBeat += 1;
        changed = true;
        continue;
      }
      if (head !== undefined && head.at <= now) {
        queue.shift();
        head.run();
        changed = true;
        if (state.status !== 'running') break;
        continue;
      }
      break;
    }
    if (state.status !== 'running') return;
    trimRows();
    const minute = Math.floor((startedAt + now) / minuteMs) * minuteMs;
    if (changed || minute !== shownMinute) refreshLogs();
    renderClock();
  };

  const startInterval = (): void => {
    stopInterval();
    intervalId = window.setInterval(tick, tickMs);
  };

  const start = (): void => {
    if (state.status !== 'idle') return;
    state.status = 'running';
    startedMs = Date.now();
    pausedAt = null;
    pausedTotal = 0;
    frozenMs = null;
    nextBeat = 1;
    queue = [];
    insertPending(
      timeline.map((event) => ({
        at: event.at * 1000,
        run: () => perform(event),
      })),
    );
    startInterval();
    render();
    tick();
    feed.focus({ preventScroll: true });
  };

  const pause = (): void => {
    if (state.status !== 'running') return;
    tick();
    if (state.status !== 'running') return;
    pausedAt = Date.now();
    state.status = 'paused';
    stopInterval();
    render();
  };

  const resume = (): void => {
    if (state.status !== 'paused' || pausedAt === null) return;
    pausedTotal += Date.now() - pausedAt;
    pausedAt = null;
    state.status = 'running';
    startInterval();
    render();
    tick();
  };

  const select = (tool: string): void => {
    state.selected = tool;
    if (tool === 'repo') state.opened.add(tool);
    render();
  };

  const tabOf = (event: Event): HTMLButtonElement | null =>
    event.target instanceof Element
      ? event.target.closest<HTMLButtonElement>('[role="tab"]')
      : null;
  tabList.addEventListener('click', (event) => {
    const tab = tabOf(event);
    if (tab !== null) select(tab.dataset.tool ?? '');
  });
  tabList.addEventListener('keydown', (event) => {
    const tab = tabOf(event);
    if (
      tab === null || event.altKey || event.ctrlKey || event.metaKey
      || event.shiftKey
    ) return;
    const tabs = tabsOf();
    const index = tabs.indexOf(tab);
    const target = event.key === 'ArrowRight'
      ? tabs[(index + 1) % tabs.length]
      : event.key === 'ArrowLeft'
      ? tabs[(index + tabs.length - 1) % tabs.length]
      : event.key === 'Home'
      ? tabs[0]
      : event.key === 'End'
      ? tabs[tabs.length - 1]
      : undefined;
    if (target === undefined) return;
    event.preventDefault();
    select(target.dataset.tool ?? '');
    target.focus();
  });

  query.addEventListener('input', refreshLogs);
  for (const input of facetInputs) {
    input.addEventListener('change', refreshLogs);
  }

  detailClose.addEventListener('click', () => closeDetail(true));
  root.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && !detail.hidden) {
      event.preventDefault();
      closeDetail(true);
    }
  });

  const setSql = (sql: string): void => {
    playground.dispatchEvent(
      new CustomEvent('playground:set-sql', { detail: { sql, run: true } }),
    );
  };
  for (
    const button of root.querySelectorAll<HTMLButtonElement>('[data-table]')
  ) {
    button.addEventListener(
      'click',
      () => setSql(`SELECT * FROM ${button.dataset.table ?? ''};`),
    );
  }

  const placeholder = (): void => {
    const note = document.createElement('p');
    note.className = 'playground-note';
    note.textContent = 'クエリを実行すると、結果がここに出ます。';
    results.replaceChildren(note);
  };
  const quietEditor = (): boolean => {
    const announced = playground.querySelector('.cm-announced');
    announced?.removeAttribute('aria-live');
    return announced !== null;
  };
  if (!quietEditor()) {
    const editorWatcher = new MutationObserver(() => {
      if (quietEditor()) editorWatcher.disconnect();
    });
    editorWatcher.observe(playground, { childList: true, subtree: true });
  }
  results.removeAttribute('aria-live');
  results.setAttribute('role', 'status');
  placeholder();
  new MutationObserver(() => {
    if (
      results.querySelector('.playground-result, .playground-error') !== null
      && !state.opened.has('console') && showsPochiStatus()
    ) {
      state.opened.add('console');
      render();
    }
  }).observe(results, { childList: true });

  startButton.addEventListener('click', start);
  pauseButton.addEventListener(
    'click',
    () => (state.status === 'paused' ? resume() : pause()),
  );
  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) tick();
  });

  replyButton.addEventListener('click', () => {
    tick();
    if (state.status !== 'running' && state.status !== 'paused') return;
    const at = elapsedMs();
    const lines: string[] = [reply.text];
    if (at >= reply.tamaAfter * 1000) lines.push(reply.tamaText);
    addPost({ actor: 'you', text: lines.join('\n') }, at);
    state.replied = true;
    let when = at;
    insertPending(
      reply.followUps.map((item, index) => {
        when += item.delay * 1000;
        const due = when;
        const last = index === reply.followUps.length - 1;
        return {
          at: due,
          run: () => {
            addPost({ actor: 'support', text: item.text }, due);
            if (last) finish(due);
          },
        };
      }),
    );
    render();
    feed.focus({ preventScroll: true });
  });

  interimButton.addEventListener('click', () => {
    tick();
    if (state.status !== 'running' && state.status !== 'paused') return;
    const parts = interim.order.map((key) => {
      const memo = memos.find((item) => item.dataset.memo === key);
      const value = memo === undefined || memo.dataset.state === 'unknown'
        ? interim.unknown
        : memo.dataset.text ?? interim.unknown;
      return `${memo?.dataset.label ?? ''}: ${value}`;
    });
    addPost(
      { actor: 'you', text: `${interim.heading}${parts.join(' / ')}` },
      elapsedMs(),
    );
  });

  let agentTimers: number[] = [];
  const stepDelay = 800;
  const toolDelay = 600;
  const agentFollowUp =
    'これ以上調べられるデータがありません。理由と操作した人は、どこにも記録されていません。';

  const startAgent = (): void => {
    state.agent = true;
    tabList.append(agentTab.content.cloneNode(true));
    pages.append(agentPanel.content.cloneNode(true));
    const list = must<HTMLElement>('[data-agent-list]');
    const log = must<HTMLElement>('[data-agent-log]');
    const statusLabel = must<HTMLElement>('[data-agent-status]');
    const input = must<HTMLTextAreaElement>('[data-agent-input]');
    const send = must<HTMLButtonElement>('[data-agent-send]');
    const blocks = [...agentSteps.content.children];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const later = (ms: number, run: () => void): void => {
      if (ms === 0) {
        run();
      } else {
        agentTimers.push(window.setTimeout(run, ms));
      }
    };
    const part = (name: string): HTMLElement => {
      const found = agentParts.content.querySelector(`[data-part="${name}"]`);
      const copy = found?.cloneNode(true);
      if (!(copy instanceof HTMLElement)) {
        throw new Error(`部品が見つかりません: ${name}`);
      }
      return copy;
    };
    const toEnd = (): void => {
      log.scrollTop = log.scrollHeight;
    };
    const append = (node: Node): void => {
      list.querySelector('[data-thinking]')?.remove();
      list.append(node);
      toEnd();
    };
    const thinking = (): void => {
      list.querySelector('[data-thinking]')?.remove();
      list.append(part('thinking'));
      toEnd();
    };
    const setRunning = (running: boolean): void => {
      statusLabel.dataset.state = running ? 'running' : 'done';
      statusLabel.textContent = running ? '実行中' : '完了';
      send.disabled = running;
    };
    const setToolState = (node: HTMLElement, running: boolean): void => {
      node.dataset.state = running ? 'running' : 'done';
      const body = node.querySelector<HTMLElement>('[data-tool-body]');
      if (body !== null) body.hidden = running;
      const label = node.querySelector('[data-tool-state-text]');
      if (label !== null) label.textContent = running ? '実行中' : '完了';
    };
    const complete = (): void => {
      state.revealed = true;
      setRunning(false);
      render();
    };

    select('agent');
    setRunning(true);
    if (reduced) {
      for (const block of blocks) append(block.cloneNode(true));
      complete();
    } else {
      let elapsed = 0;
      blocks.forEach((block, index) => {
        const node = block.cloneNode(true) as HTMLElement;
        const isTool = block.getAttribute('data-kind') === 'tool';
        const last = index === blocks.length - 1;
        if (index > 0) elapsed += stepDelay;
        later(elapsed, () => {
          if (isTool) setToolState(node, true);
          append(node);
          if (last) complete();
          else if (!isTool) thinking();
        });
        if (isTool) {
          elapsed += toolDelay;
          later(elapsed, () => {
            setToolState(node, false);
            if (!last) thinking();
          });
        }
      });
    }

    const submit = (): void => {
      const text = input.value.trim();
      if (text === '' || send.disabled) return;
      input.value = '';
      const user = part('user');
      const userText = user.querySelector('[data-text]');
      if (userText !== null) userText.textContent = text;
      append(user);
      const answer = (): void => {
        const answerNode = part('reply');
        const answerText = answerNode.querySelector('[data-text]');
        if (answerText !== null) answerText.textContent = agentFollowUp;
        append(answerNode);
        setRunning(false);
      };
      setRunning(true);
      if (reduced) {
        answer();
      } else {
        thinking();
        later(stepDelay, answer);
      }
    };
    send.addEventListener('click', submit);
    input.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' || event.shiftKey || event.isComposing) return;
      event.preventDefault();
      submit();
    });
  };

  const openTool = (tool: string): void => {
    select(tool);
    if (tool === 'console') {
      setSql(`SELECT * FROM visits WHERE id = 'visit-pochi';`);
    }
    if (tool === 'logs') {
      query.value = 'service:clinic-api visit-pochi';
      for (const input of facetInputs) input.checked = false;
      refreshLogs();
      const target = rows.find((row) => row.cancel);
      if (target !== undefined) openDetail(target);
    }
  };
  root.addEventListener('click', (event) => {
    const button = event.target instanceof Element
      ? event.target.closest<HTMLElement>('[data-open-tool]')
      : null;
    if (button !== null) openTool(button.dataset.openTool ?? '');
  });

  answerButton.addEventListener('click', () => {
    if (!state.agent) startAgent();
  });
  resetButton.addEventListener('click', () => {
    stopInterval();
    for (const timer of agentTimers) window.clearTimeout(timer);
    agentTimers = [];
    for (const element of root.querySelectorAll('[data-tool="agent"]')) {
      element.remove();
    }
    state.status = 'idle';
    state.agent = false;
    state.opened.clear();
    state.revealed = false;
    state.replied = false;
    state.selected = 'console';
    state.affected = initialAffected;
    pausedAt = null;
    pausedTotal = 0;
    frozenMs = null;
    queue = [];
    nextBeat = 1;
    feed.replaceChildren();
    for (const row of rows.filter((item) => item.dynamic)) {
      row.element.remove();
    }
    rows.splice(0, rows.length, ...rows.filter((row) => !row.dynamic));
    query.value = query.dataset.initial ?? '';
    for (const input of facetInputs) input.checked = false;
    closeDetail(false);
    refreshLogs();
    resetSql.click();
    restoreSql.hidden = true;
    playground.dispatchEvent(new CustomEvent('playground:discard-state'));
    placeholder();
    render();
    startButton.focus();
  });

  loadEarlierLogs();
  refreshLogs();
  render();
}
</script>
