---
import './figure.css';

import {
  type ConsultationIntro,
  consultationIntros,
  type ConsultationKey,
} from './consultation-intros';
import { richHtml } from './rich';

type Props = { readonly consultation: ConsultationKey };

const { consultation } = Astro.props;
const intro: ConsultationIntro = consultationIntros[consultation];
const excerpt = intro.excerpt;
const at = (index: number): string => `--i:${index}`;
const systems = excerpt.kind === 'architecture'
  ? [
    { node: excerpt.source, side: 'source', order: 3 },
    { node: excerpt.target, side: 'target', order: 2 },
  ]
  : [];
const link = excerpt.kind === 'architecture' ? excerpt.link : '';
const recording = excerpt.kind === 'recording' ? excerpt : undefined;
const timeline = excerpt.kind === 'timeline' ? excerpt : undefined;
const calloutAt = timeline !== undefined ? 8 : recording === undefined ? 6 : 7;
const place = (order: number, column: number, row: number, span = 1): string =>
  `--i:${order};grid-column:${column} / span ${span};grid-row:${row}`;
const cancelColumns = timeline === undefined
  ? []
  : timeline.points.flatMap((point, index) =>
    point.kind === 'cancel' ? [index + 1] : []
  );
---

<p class="cif-lead" set:html={richHtml(intro.lead)} />
<section
  class="cfig cif"
  data-consultation-figure={consultation}
  aria-label={intro.label}
>
  <div class="ask reveal" style={at(0)}>
    <div class="who">
      <span class="avatar" aria-hidden="true">{intro.speaker.avatar}</span>
      <span class="who-text">
        <span class="who-name">{intro.speaker.name}</span>
        {
          intro.speaker.role !== undefined && (
            <span class="who-role">{intro.speaker.role}</span>
          )
        }
      </span>
    </div>
    <div class="bubble" set:html={richHtml(intro.question)} />
  </div>

  <div class="data">
    {
      intro.heading !== undefined && (
        <div class="data-label reveal" style={at(2)}>{intro.heading}</div>
      )
    }
    <div class="excerpts">
      {
        timeline !== undefined && (
          <div class="tl">
            <span
              class="tl-axis reveal"
              style="--i: 2; grid-column: 1 / 5; grid-row: 2"
              aria-hidden="true"
            ></span>
            {
              timeline.points.map((point, index) => (
                <>
                  <span
                    class:list={[
                      'tl-label',
                      'reveal',
                      { 'tl-intro': point.kind === 'introduction' },
                    ]}
                    style={place(index + 2, index + 1, 1)}
                  >{point.label}</span>
                  <span
                    class:list={[
                      point.kind === 'introduction' ? 'tl-mark' : 'tl-dot',
                      'reveal',
                    ]}
                    style={place(index + 2, index + 1, 2)}
                    aria-hidden="true"
                  ></span>
                </>
              ))
            }
            {
              timeline.rows.map((row, rowIndex) => (
                <>
                  <div
                    class="tl-name reveal"
                    style={place(2, 1, 3 + rowIndex * 2, 5)}
                  >
                    <span class="mono">{row.name}</span>
                    {
                      row.note !== undefined && (
                        <span class="tl-note">{row.note}</span>
                      )
                    }
                  </div>
                  {
                    row.cells.map((cell, cellIndex) => (
                      <span
                        class:list={[
                          'ev',
                          'tl-cell',
                          'reveal',
                          {
                            mono: cell.tone === 'mono',
                            ghost: cell.tone === 'ghost',
                          },
                        ]}
                        style={place(
                          (cancelColumns[cellIndex] ?? 1) + 1,
                          cancelColumns[cellIndex] ?? 1,
                          4 + rowIndex * 2,
                        )}
                      >{cell.text}</span>
                    ))
                  }
                  <span
                    class="count-figure tl-total reveal"
                    style={place(6, 5, 4 + rowIndex * 2)}
                  >
                    <span class="count-value">{row.count}</span>
                    <span class="count-unit">{row.unit}</span>
                  </span>
                </>
              ))
            }
          </div>
        )
      }
      {
        excerpt.kind === 'architecture' && (
          <div class="arch">
            {
              systems.map((system, index) => (
                <>
                  <div
                    class="sys reveal"
                    style={at(system.order)}
                    data-side={system.side}
                  >
                    <span class="person">{system.node.person}</span>
                    <div class="act">
                      <span class="down-arrow" aria-hidden="true"></span>
                      <span class="act-label">{system.node.action}</span>
                    </div>
                    <div class="tbl">
                      <div class="tbl-head">
                        <span>{system.node.name}</span>
                        {
                          system.node.note !== undefined
                    && (
                            <span class="tbl-head-note">{
                              system.node.note
                            }</span>
                          )
                        }
                      </div>
                      <div class="tbl-body state">
                        <span class="state-value">{system.node.state}</span>
                        {
                          system.node.detail !== undefined
                    && (
                            <span
                              class="state-detail"
                              set:html={richHtml(system.node.detail)}
                            />
                          )
                        }
                      </div>
                    </div>
                  </div>
                  {
                    index === 0 && (
                      <div class="bridge">
                        <span class="bridge-label reveal" style={at(4)}>{
                          link
                        }</span>
                        <span
                          class="bridge-arrow reveal"
                          style={at(4)}
                          aria-hidden="true"
                        ></span>
                        <span
                          class="down-arrow bridge-down reveal"
                          style={at(4)}
                          aria-hidden="true"
                        ></span>
                      </div>
                    )
                  }
                </>
              ))
            }
          </div>
        )
      }
      {
        recording !== undefined && (
          <div class="rec">
            <div class="rec-top reveal" style={at(2)}>
              <span class="person">{recording.person}</span>
              <div class="rec-act">
                <span class="bridge-label">{recording.action}</span>
                <span class="bridge-arrow" aria-hidden="true"></span>
                <span class="down-arrow bridge-down" aria-hidden="true"></span>
              </div>
              <div class="tbl rec-system">
                <div class="tbl-head">{recording.system}</div>
              </div>
            </div>
            <div class="rec-cols">
              <div class="rec-col reveal" style={at(3)}>
                <div class="rec-link">
                  <span class="down-arrow" aria-hidden="true"></span>
                  <span class="rec-link-label">{recording.update.label}</span>
                </div>
                <div class="tbl">
                  <div class="tbl-head mono">{recording.update.table}</div>
                  <div
                    class="tbl-body"
                    set:html={richHtml(recording.update.content)}
                  />
                </div>
              </div>
              <div class="rec-col reveal" style={at(4)}>
                <div class="rec-link">
                  <span class="down-arrow" aria-hidden="true"></span>
                  <span class="rec-link-label">{recording.log.label}</span>
                </div>
                <div class="tbl">
                  <div class="tbl-head mono">{recording.log.table}</div>
                  <div class="tbl-body pairs">
                    {
                      recording.log.columns.map((
                    pair,
                  ) => (
                        <div class="ev">
                          <span class="pair-column mono">{pair.column}</span>
                          <span
                            class:list={['pair-value', { mono: pair.mono }]}
                          >{pair.value}</span>
                        </div>
                      ))
                    }
                    <div class="ev ghost reveal" style={at(5)}>
                      {recording.log.missing}
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        )
      }
    </div>
  </div>

  <div
    class="cfig-callout callout reveal"
    style={at(calloutAt)}
    data-tone="problem"
    data-tail="top"
  >
    <span class="cfig-callout-label">課題</span>{intro.problem}
  </div>
</section>

<style>
.cfig.cif {
  word-break: auto-phrase;
  --fig-small: var(--text-note);
  --fig-code: 1em;
  --fig-label: var(--text-note);
  gap: var(--space-4);
  container-type: inline-size;
}
:global(.content) :global(.scene[data-scenario]) :global(.doc-paper) .cif-lead {
  margin-block: 0 var(--space-1);
  font-size: var(--text-code);
  font-weight: var(--weight-regular);
  line-height: var(--leading-tight);
}
:global(.content)
  :global(.scene[data-scenario])
  :global(.doc-paper)
  .cif-lead
  :global(code) {
  background: var(--role-ground);
  font-size: 1em;
}
.mono {
  font-family: var(--font-code);
}

.ask {
  display: flex;
  align-items: center;
  gap: var(--space-3);
}
.who {
  display: flex;
  flex: none;
  align-items: center;
  gap: var(--space-2);
}
.avatar {
  display: inline-flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  border-radius: var(--radius-pill);
  background: var(--role-accent-strong);
  color: var(--role-on-strong);
  font-size: var(--text-code);
  line-height: 1;
}
.who-text {
  display: flex;
  flex-direction: column;
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.who-role {
  color: var(--role-muted);
}
.bubble {
  position: relative;
  flex: 1;
  min-width: 0;
  border: 1px solid var(--role-rail);
  border-radius: var(--radius-md);
  background: var(--role-ground);
  padding: var(--space-1) var(--space-3);
  font-size: var(--text-code);
  line-height: var(--leading-tight);
}
.bubble::before,
.bubble::after {
  position: absolute;
  width: 0;
  height: 0;
  border-style: solid;
  border-color: transparent;
  content: "";
}
.bubble::before {
  top: calc(50% - 7px);
  left: -8px;
  border-width: 7px 8px 7px 0;
  border-right-color: var(--role-rail);
}
.bubble::after {
  top: calc(50% - 6px);
  left: -7px;
  border-width: 6px 7px 6px 0;
  border-right-color: var(--role-ground);
}

.data {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
}
.data-label {
  color: var(--role-muted);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.excerpts {
  display: flex;
  align-items: stretch;
  gap: var(--space-2);
}

.tbl {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-width: 0;
  border: 2px solid var(--role-accent-strong);
  border-radius: var(--radius-md);
  background: var(--role-ground);
  overflow: hidden;
  line-height: var(--leading-tight);
}
.tbl-head {
  background: var(--role-accent-strong);
  padding: 0 var(--space-2);
  color: var(--role-on-strong);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.tbl-body {
  padding: var(--space-2);
  font-size: var(--text-note);
}

.count-figure {
  display: inline-flex;
  flex: none;
  align-items: baseline;
}
.count-value {
  font-size: 2rem;
  font-weight: var(--weight-bold);
  line-height: 1;
}
.count-unit {
  font-size: var(--text-note);
  font-weight: var(--weight-regular);
}

.state {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}
.state-value {
  font-size: var(--text-code);
}

.tl {
  display: grid;
  flex: 1;
  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) minmax(0, 1fr) 4rem;
  column-gap: var(--space-2);
  row-gap: var(--space-1);
  min-width: 32rem;
}
.tl-label {
  align-self: end;
  font-size: var(--text-note);
  line-height: var(--leading-tight);
  text-align: center;
  text-wrap: balance;
}
.tl-label.tl-intro {
  align-self: center;
  justify-self: center;
  border-radius: var(--radius-md);
  background: var(--role-marker);
  padding: 0 var(--space-2);
  white-space: nowrap;
}
.tl-axis {
  position: relative;
  align-self: center;
  height: 2px;
  margin-right: 0.375rem;
  background: var(--role-accent-strong);
}
.tl-axis::after {
  position: absolute;
  top: 50%;
  right: -0.3125rem;
  border: 0.3125rem solid transparent;
  border-right: 0;
  border-left-color: var(--role-accent-strong);
  content: "";
  transform: translateY(-50%);
}
.tl-dot {
  align-self: center;
  justify-self: center;
  width: 0.625rem;
  height: 0.625rem;
  border-radius: var(--radius-pill);
  background: var(--role-accent-strong);
}
.tl-mark {
  align-self: center;
  justify-self: center;
  width: 0.25rem;
  height: 1rem;
  border-radius: var(--radius-sm);
  background: var(--role-marker);
}
.tl-name {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  margin-top: var(--space-1);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.tl-note {
  color: var(--role-muted);
}
.ev.tl-cell {
  align-items: center;
  justify-content: center;
  border: 2px solid transparent;
  padding-block: var(--space-1);
  text-align: center;
}
.tl-total {
  align-self: center;
  justify-self: center;
}

.arch {
  display: grid;
  flex: 1;
  grid-template-columns: minmax(0, 1fr) 9.5rem minmax(0, 1.2fr);
  grid-template-rows: auto auto auto;
  row-gap: var(--space-1);
  min-width: 0;
}
.sys {
  display: grid;
  grid-row: 1 / 4;
  grid-template-rows: subgrid;
  min-width: 0;
}
.sys[data-side="source"] {
  grid-column: 1;
}
.sys[data-side="target"] {
  grid-column: 3;
}
.person {
  align-self: center;
  justify-self: center;
  border: 1px solid var(--role-rail);
  border-radius: var(--radius-pill);
  background: var(--role-ground);
  padding: 0 var(--space-3);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.act {
  display: grid;
  grid-template-columns: 1fr 0.75rem 1fr;
  column-gap: var(--space-2);
  min-height: 1.5rem;
}
.act .down-arrow {
  grid-column: 2;
}
.act-label {
  grid-column: 3;
  align-self: center;
  white-space: nowrap;
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.down-arrow {
  position: relative;
  width: 0.75rem;
}
.down-arrow::before {
  position: absolute;
  top: 0;
  bottom: 0.375rem;
  left: calc(50% - 1px);
  width: 2px;
  background: var(--role-accent-strong);
  content: "";
}
.down-arrow::after {
  position: absolute;
  bottom: 0;
  left: 50%;
  border: 0.375rem solid transparent;
  border-bottom: 0;
  border-top-color: var(--role-accent-strong);
  content: "";
  transform: translateX(-50%);
}
.tbl-head {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
}
.tbl-head-note {
  opacity: 0.8;
}
.bridge {
  display: grid;
  grid-column: 2;
  grid-row: 3;
  grid-template-rows: 1fr auto 1fr;
  min-width: 0;
}
.bridge-label {
  grid-row: 1;
  align-self: end;
  padding-inline: var(--space-1);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
  text-align: center;
  text-wrap: balance;
}
.bridge-arrow {
  position: relative;
  grid-row: 2;
  height: 2px;
  margin-inline: var(--space-1) 0.375rem;
  background: var(--role-accent-strong);
}
.bridge-arrow::after {
  position: absolute;
  top: 50%;
  right: -0.3125rem;
  border: 0.3125rem solid transparent;
  border-right: 0;
  border-left-color: var(--role-accent-strong);
  content: "";
  transform: translateY(-50%);
}
.bridge-down {
  display: none;
}

.rec {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}
.rec-top {
  display: flex;
  flex-direction: row-reverse;
  align-items: center;
}
.rec .person {
  flex: none;
  white-space: nowrap;
}
.rec-act {
  display: grid;
  flex: none;
  grid-template-rows: 1fr auto 1fr;
  width: 8rem;
}
.rec-act .bridge-label {
  white-space: nowrap;
}
.rec-act .bridge-arrow {
  margin-inline: 0.375rem var(--space-1);
}
.rec-act .bridge-arrow::after {
  right: auto;
  left: -0.3125rem;
  border-right: 0.3125rem solid var(--role-accent-strong);
  border-left: 0;
}
.rec-system {
  flex: 1;
}
.rec-cols {
  display: grid;
  grid-template-columns: minmax(0, 1.3fr) minmax(0, 1.75fr);
  align-items: start;
  column-gap: var(--space-3);
}
.rec-col {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
}
.rec-col .tbl {
  flex: none;
}
.rec-link {
  display: flex;
  align-items: stretch;
  gap: var(--space-2);
  padding-left: var(--space-4);
  min-height: 1.5rem;
}
.rec-link .down-arrow {
  flex: none;
}
.rec-link-label {
  align-self: center;
  white-space: nowrap;
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.rec .pairs {
  gap: var(--space-1);
}
.pairs {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: var(--space-2);
}
.ev {
  display: flex;
  flex-direction: column;
  border-radius: var(--radius-sm);
  background: var(--role-surface);
  padding: 0 var(--space-2);
  font-size: var(--text-note);
  line-height: var(--leading-tight);
}
.pair-column {
  color: var(--role-muted);
}
.ev.ghost {
  border: 2px dashed var(--role-ink-sub);
  background: transparent;
  padding-block: var(--space-1);
  color: var(--role-muted);
}

.callout {
  margin-top: var(--space-2);
}

@media (prefers-reduced-motion: no-preference) {
  .reveal {
    animation: reveal-in 0.4s ease-out both;
    animation-delay: calc(var(--i) * 0.35s);
  }
  .callout.reveal {
    transform-origin: center top;
    animation-name: callout-in;
  }
  .bridge-arrow.reveal {
    transform-origin: left center;
    animation-name: bridge-grow;
  }
  .tl-axis.reveal {
    transform-origin: left center;
    animation-name: bridge-grow;
    animation-duration: 1.2s;
  }
  .rec-act .bridge-arrow {
    transform-origin: right center;
    animation: bridge-grow 0.4s ease-out both;
    animation-delay: calc(var(--i) * 0.35s);
  }
}
@keyframes reveal-in {
  from {
    opacity: 0;
    transform: translateY(0.375rem);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@keyframes bridge-grow {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}
@keyframes callout-in {
  from {
    opacity: 0;
    transform: scale(0.92);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

@container (max-width: 34rem) {
  .ask {
    flex-direction: column;
    align-items: stretch;
  }
  .bubble::before {
    top: -8px;
    left: calc(1.25rem - 7px);
    border-width: 0 7px 8px;
    border-right-color: transparent;
    border-bottom-color: var(--role-rail);
  }
  .bubble::after {
    top: -7px;
    left: calc(1.25rem - 6px);
    border-width: 0 6px 7px;
    border-right-color: transparent;
    border-bottom-color: var(--role-ground);
  }
  .excerpts {
    flex-direction: column;
    overflow-x: auto;
  }
  .tbl {
    flex: none;
  }
  .arch,
  .rec {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .rec-top {
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-1);
  }
  .rec .person {
    align-self: center;
  }
  .rec-cols {
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-1);
  }
  .sys {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .bridge,
  .rec-act {
    width: auto;
    grid-template-rows: none;
    grid-template-columns: 1fr 0.75rem 1fr;
    column-gap: var(--space-2);
    min-height: 1.5rem;
  }
  .bridge-arrow {
    display: none;
  }
  .bridge-down {
    display: block;
    grid-column: 2;
    grid-row: 1;
  }
  .bridge-label {
    grid-column: 3;
    grid-row: 1;
    align-self: center;
    padding-inline: 0;
    text-align: left;
  }
}
</style>
