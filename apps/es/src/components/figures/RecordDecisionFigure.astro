---
import './figure.css';

type Cell = {
  readonly column: string;
  readonly value: string;
  readonly answers?: string;
  readonly before?: string;
  readonly mark?: true;
};
type Part = string | { readonly code: string };
type Write = {
  readonly sql: string;
  readonly table: string;
  readonly note: readonly Part[];
  readonly cells: readonly Cell[];
  readonly label: string;
};

const visit: readonly Cell[] = [
  { column: 'id', value: 'visit-pochi' },
  { column: 'pet_name', value: 'ポチ' },
  { column: 'status', value: 'cancelled', before: 'reserved' },
];
const record: readonly Cell[] = [
  { column: 'id', value: '1' },
  { column: 'visit_id', value: 'visit-pochi' },
  {
    column: 'cancelled_at',
    value: '2026-11-06T18:11:58.846Z',
    answers: 'いつ',
  },
  { column: 'operated_by', value: '受付スタッフ', answers: '誰が', mark: true },
  { column: 'reason', value: '飼い主の都合', answers: 'なぜ', mark: true },
];
const writes: readonly Write[] = [
  {
    sql: 'UPDATE visits',
    table: 'visits',
    note: [{ code: 'visits' }, ' の ', { code: 'status' }, ' が ', {
      code: 'cancelled',
    }, ' になります。'],
    cells: visit,
    label: 'visits の行',
  },
  {
    sql: 'INSERT INTO visit_cancellations',
    table: 'visit_cancellations',
    note: [{ code: 'visit_cancellations' }, ' に1行を書きます。'],
    cells: record,
    label: 'visit_cancellations に書く1行',
  },
];
---

<section
  class="cfig decision"
  data-record-decision-figure
  aria-label="cancelVisit が、来院の更新と記録を同じトランザクションで行う図"
>
  <div class="caller">
    <span class="tag">呼び出し元</span>
    <span class="mono call"
    >cancelVisit(db, &#123; visitId: 'visit-pochi', <span class="mark"
      >reason: '飼い主の都合'</span>, <span class="mark"
      >operatedBy: '受付スタッフ'</span> &#125;)</span>
  </div>
  <div class="down" aria-hidden="true">↓</div>

  <div class="frame">
    <div class="frame-head">
      <span class="mono">cancelVisit</span> の <span class="mono"
      >withTransaction</span>
    </div>
    <ol class="ops">
      {
        writes.map((write, index) => (
          <li class="op" data-write={write.table}>
            <div class="op-line">
              <span class="op-no" aria-hidden="true">{index + 1}</span>
              <span class="mono op-sql">{write.sql}</span>
              <span class="op-note">
                {
                  write.note.map((part) =>
                typeof part === 'string'
                  ? part
                  : (
                    <span class="mono">{part.code}</span>
                  )
              )
                }
              </span>
            </div>
            <dl class="cells" aria-label={write.label}>
              {
                write.cells.map((cell) => (
                  <div class="cell">
                    <dt>
                      <span class="mono">{cell.column}</span>
                      {
                        cell.answers !== undefined && (
                          <span class="badge">{cell.answers}</span>
                        )
                      }
                    </dt>
                    <dd class="mono">
                      {
                        cell.before !== undefined && (
                          <>
                            <span class="before">{cell.before}</span>
                            <span class="to" aria-hidden="true">→</span>
                            <span class="cfig-sr">から</span>
                          </>
                        )
                      }
                      <span
                        class:list={['value', {
                          mark: cell.mark === true,
                          after: cell.before !== undefined,
                        }]}
                      >{cell.value}</span>
                      {
                        cell.answers !== undefined && (
                          <span class="badge">{cell.answers}</span>
                        )
                      }
                    </dd>
                  </div>
                ))
              }
            </dl>
          </li>
        ))
      }
    </ol>
  </div>

  <div class="fork" aria-hidden="true">
    <span>↓</span>
    <span>↓</span>
  </div>
  <div class="outcomes">
    <div class="outcome" data-outcome="success">
      <div class="outcome-head">
        <strong>記録に成功する場合</strong>
        <span class="stamp">確定</span>
      </div>
      <div class="outcome-text">
        トランザクションを確定します。来院の更新と記録の両方が残ります。
      </div>
    </div>
    <div class="outcome" data-outcome="fail">
      <div class="outcome-head">
        <strong>記録に失敗する場合</strong>
        <span class="stamp">取り消し</span>
      </div>
      <div class="outcome-text">
        <span class="mono">visit_cancellations</span>
        への記録が失敗すると、トランザクションを取り消します。<span class="mono"
        >visits</span> の <span class="mono">status</span> は <span class="mono"
        >reserved</span> に戻ります。
      </div>
    </div>
  </div>
</section>

<style>
.cfig.decision {
  container-type: inline-size;
  gap: var(--space-1);
}
.mono {
  font-family: var(--font-code);
  font-size: var(--fig-code);
}
.mark {
  border-radius: var(--radius-sm);
  background: var(--role-marker);
  color: var(--role-ink);
}

.caller {
  border-radius: var(--radius-md);
  background: var(--role-ground);
  padding: var(--space-1) var(--space-2);
  font-size: var(--fig-small);
  line-height: var(--leading-normal);
}
.tag {
  display: inline-block;
  margin-right: var(--space-2);
  border-radius: var(--radius-sm);
  background: var(--role-accent-strong);
  padding: 0 var(--space-2);
  color: var(--role-on-strong);
  font-size: var(--fig-label);
  font-weight: var(--weight-bold);
}
.call {
  overflow-wrap: anywhere;
}
.down,
.fork {
  color: var(--role-muted);
  font-size: var(--fig-label);
  line-height: var(--leading-tight);
  text-align: center;
}
.fork,
.outcomes {
  display: grid;
  grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
  gap: var(--space-2);
}

.frame {
  border-radius: var(--radius-lg);
  background: var(--role-accent-soft);
  padding: var(--space-1) var(--space-2) var(--space-2);
}
.frame-head {
  font-size: var(--fig-text);
  font-weight: var(--weight-bold);
  line-height: var(--leading-normal);
}
.frame-head .mono {
  font-size: inherit;
}
.cfig .ops {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin: 0;
  padding: 0;
  list-style: none;
}
.cfig .op {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  margin: 0;
  border-radius: var(--radius-md);
  background: var(--role-ground);
  padding: var(--space-1) var(--space-2) var(--space-2);
}
.op-line {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 0 var(--space-2);
  font-size: var(--fig-small);
  line-height: var(--leading-normal);
}
.op-no {
  display: inline-grid;
  flex: none;
  place-items: center;
  align-self: center;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: 50%;
  background: var(--role-accent-strong);
  color: var(--role-on-strong);
  font-size: var(--fig-label);
  font-weight: var(--weight-bold);
}
.op-sql {
  font-weight: var(--weight-bold);
}

.cfig .cells {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 0.125rem;
  margin: 0;
  background: var(--role-rail);
  line-height: var(--leading-normal);
}
.cell {
  display: contents;
}
.cfig .cells dt,
.cfig .cells dd {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0 var(--space-2);
  margin: 0;
  padding: var(--space-1) var(--space-2);
  overflow-wrap: anywhere;
}
.cfig .cells dt {
  background: var(--role-surface);
  font-weight: var(--weight-bold);
}
.cfig .cells dd {
  background: var(--role-ground);
}
.cfig .cells dt .badge {
  display: none;
}
.badge {
  border-radius: var(--radius-sm);
  background: var(--role-marker);
  padding: 0 var(--space-2);
  font-size: var(--fig-label);
  line-height: var(--leading-tight);
  white-space: nowrap;
}
.cfig .cells dd .badge {
  margin-left: auto;
  font-family: var(--font-body, inherit);
  font-weight: var(--weight-bold);
}
.value {
  display: inline-block;
  max-width: 100%;
}
.before {
  color: var(--role-muted);
}
.to {
  color: var(--role-muted);
}
.after {
  font-weight: var(--weight-bold);
}

.outcome {
  min-width: 0;
  border-radius: var(--radius-lg);
  background: var(--role-ground);
  padding: var(--space-1) var(--space-2) var(--space-2);
}
.outcome[data-outcome="success"] {
  background: var(--role-success-soft);
}
.outcome[data-outcome="fail"] {
  background: var(--role-danger-soft);
}
.outcome-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-1) var(--space-2);
  font-size: var(--fig-text);
  line-height: var(--leading-normal);
}
.stamp {
  border-radius: var(--radius-sm);
  padding: 0 var(--space-2);
  color: var(--role-on-strong);
  font-size: var(--fig-label);
  font-weight: var(--weight-bold);
}
[data-outcome="success"] .stamp {
  background: var(--role-success);
}
[data-outcome="fail"] .stamp {
  background: var(--role-danger);
}
.outcome-text {
  font-size: var(--fig-small);
  line-height: var(--leading-normal);
}

@container (min-width: 60rem) {
  .cfig .cells {
    grid-auto-flow: column;
    grid-template-columns: none;
    grid-template-rows: auto auto;
  }
  [data-write="visits"] .cells {
    align-self: flex-start;
    min-width: min(100%, 22rem);
  }
  .cfig .cells dt {
    flex-direction: column;
    align-items: flex-start;
  }
  .cfig .cells dt .badge {
    display: inline-block;
  }
  .cfig .cells dd .badge {
    display: none;
  }
}
@container (max-width: 36rem) {
  .fork,
  .outcomes {
    grid-template-columns: minmax(0, 1fr);
  }
  .fork span + span {
    display: none;
  }
}
</style>
