---
import './figure.css';

type Source = { readonly name: string; readonly plain?: true };
type Row = {
  readonly from: readonly Source[];
  readonly column: string;
  readonly value: string;
  readonly why: string;
};

const rows: readonly Row[] = [
  {
    from: [{ name: 'id' }],
    column: 'event_id',
    value: '1',
    why: '1行を指し示すため',
  },
  {
    from: [{ name: 'cancelled_at' }],
    column: 'event_at',
    value: '2026-11-06T18:11:58.846Z',
    why: '「いつ」に答えるため',
  },
  {
    from: [{ name: 'テーブルの名前', plain: true }],
    column: 'event_name',
    value: 'VisitCancelled',
    why: '「何を」に答えるため',
  },
  {
    from: [{ name: 'operated_by' }, { name: 'reason' }],
    column: 'payload',
    value: '{"reason":"飼い主の都合","operatedBy":"受付スタッフ"}',
    why: '「誰が」「なぜ」に答えるため',
  },
  {
    from: [{ name: 'visit_id' }],
    column: 'target_id',
    value: 'visit-pochi',
    why: '来院の ID で記録を検索するため',
  },
  {
    from: [],
    column: 'target_type',
    value: 'Visit',
    why: '来院以外の対象も同じテーブルに記録するため',
  },
  {
    from: [],
    column: 'target_state',
    value: '{"id":"visit-pochi","pet_name":"ポチ","status":"cancelled"}',
    why: 'その時点の状態を後から確かめるため',
  },
];
---

<section
  class="cfig mapping"
  data-record-mapping-figure
  aria-label="visit_cancellations の列を business_events の列に移す図"
>
  <div class="merge">
    <div class="side">
      <div class="side-head">出来事ごとにテーブルを作る</div>
      <ul class="chips">
        <li class="chip mono">visit_cancellations</li>
        <li class="chip ghost">診察の完了を記録するテーブル</li>
        <li class="chip ghost">…</li>
      </ul>
    </div>
    <div class="merge-arrow" aria-hidden="true"></div>
    <div class="side one">
      <div class="side-head">1つのテーブルにまとめる</div>
      <ul class="chips">
        <li class="chip mono">business_events</li>
      </ul>
    </div>
  </div>

  <div
    class="map"
    role="table"
    aria-label="visit_cancellations の列と business_events の列の対応"
  >
    <div class="row head" role="row">
      <span class="from" role="columnheader">ADR 1 の列</span>
      <span class="to" role="columnheader">
        <span class="mono">business_events</span> の列
      </span>
      <span class="why" role="columnheader">残す理由</span>
    </div>
    {
      rows.map((row) => (
        <div class="row" role="row" data-column={row.column}>
          <span class="from" role="cell">
            <span class="sources">
              {
                row.from.length === 0
              ? (
                  <span class="none">無し</span>
                )
              : row.from.map((source) => (
                  <span
                    class:list={['source', { mono: source.plain !== true }]}
                  >
                    {source.name}
                  </span>
                ))
              }
            </span>
            <span class="arrow" aria-hidden="true"></span>
          </span>
          <span class="to" role="cell">
            <span class="mono name">{row.column}</span>
            <span class="mono value">
              {
                row.value.split(/(?<=,)/).map((part) => (
                  <span class="part">{part}</span>
                ))
              }
            </span>
          </span>
          <span class="why" role="cell">{row.why}</span>
        </div>
      ))
    }
  </div>
</section>

<style>
.cfig.mapping {
  container-type: inline-size;
  gap: var(--space-2);
}
.mono {
  font-family: var(--font-code);
  font-size: var(--fig-code);
}

.merge {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto auto;
  align-items: stretch;
  gap: var(--space-2);
}
.side {
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  min-width: 0;
  border-radius: var(--radius-lg);
  background: var(--role-ground);
  padding: var(--space-1) var(--space-2) var(--space-2);
}
.side.one {
  background: var(--role-accent-soft);
}
.side-head {
  font-size: var(--fig-small);
  font-weight: var(--weight-bold);
  line-height: var(--leading-normal);
}
.cfig .chips {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1);
  margin: 0;
  padding: 0;
  list-style: none;
}
.cfig .chip {
  margin: 0;
  border-radius: var(--radius-sm);
  background: var(--role-surface);
  padding: 0 var(--space-2);
  font-size: var(--fig-label);
  line-height: var(--leading-normal);
}
.cfig .chip.mono {
  font-size: var(--fig-label);
  font-weight: var(--weight-bold);
}
.cfig .chip.ghost {
  border: 2px dashed var(--role-ink-sub);
  background: transparent;
  color: var(--role-muted);
  font-weight: var(--weight-regular);
}
.one .chip {
  background: var(--role-accent-strong);
  color: var(--role-on-strong);
}
.merge-arrow {
  align-self: center;
  color: var(--role-accent-strong);
  font-size: var(--fig-text);
  font-weight: var(--weight-bold);
  line-height: 1;
}
.merge-arrow::before {
  content: "→";
}

.map {
  display: flex;
  flex-direction: column;
  gap: 0.125rem;
}
.row {
  display: grid;
  grid-template-columns: 11rem minmax(0, 1fr) 15rem;
  align-items: stretch;
  line-height: var(--leading-normal);
}
.from {
  display: flex;
  align-items: center;
  gap: var(--space-1);
  min-width: 0;
  padding-block: var(--space-1);
}
.sources {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-1);
  min-width: 0;
}
.source,
.none {
  border-radius: var(--radius-sm);
  background: var(--role-ground);
  padding: 0 var(--space-2);
  font-size: var(--fig-label);
  white-space: nowrap;
}
.source.mono {
  font-weight: var(--weight-bold);
}
.none {
  border: 2px dashed var(--role-ink-sub);
  background: transparent;
  color: var(--role-muted);
}
.arrow {
  position: relative;
  flex: 1;
  min-width: 1rem;
  height: 2px;
  margin-right: 0.375rem;
  background: var(--role-accent-strong);
}
.arrow::after {
  position: absolute;
  top: 50%;
  right: -0.3125rem;
  border: 0.3125rem solid transparent;
  border-right: 0;
  border-left-color: var(--role-accent-strong);
  content: "";
  transform: translateY(-50%);
}
.sources:has(.none) + .arrow {
  background: var(--role-border);
}
.sources:has(.none) + .arrow::after {
  border-left-color: var(--role-border);
}
.to {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  min-width: 0;
  border-radius: var(--radius-md);
  background: var(--role-accent-soft);
  padding: var(--space-1) var(--space-2);
}
.name {
  flex: none;
  width: 13ch;
  font-weight: var(--weight-bold);
}
.value {
  min-width: 0;
  overflow-wrap: anywhere;
}
.part {
  display: inline-block;
  max-width: 100%;
}
.why {
  display: flex;
  align-items: center;
  min-width: 0;
  padding-left: var(--space-2);
  color: var(--role-muted);
  font-size: var(--fig-small);
  text-wrap: balance;
}
.head .from,
.head .why {
  align-items: flex-end;
  color: var(--role-fg);
  font-size: var(--fig-small);
  font-weight: var(--weight-bold);
}
.head .to {
  display: block;
  background: var(--role-accent-strong);
  padding-block: var(--space-1);
  color: var(--role-on-strong);
  font-size: var(--fig-small);
  font-weight: var(--weight-bold);
}
.head .mono {
  font-size: inherit;
}

@container (max-width: 52rem) {
  .row {
    grid-template-columns: 9rem minmax(0, 1fr);
  }
  .from {
    grid-row: 1 / span 2;
  }
  .to {
    grid-column: 2;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
    padding-bottom: 0;
  }
  .name {
    width: auto;
  }
  .why {
    grid-column: 2;
    border-radius: 0 0 var(--radius-md) var(--radius-md);
    background: var(--role-accent-soft);
    padding: 0 var(--space-2) var(--space-1);
  }
  .head .to {
    border-radius: var(--radius-md);
    padding-bottom: var(--space-1);
  }
  .head .why {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    padding: 0;
    white-space: nowrap;
  }
}
@container (max-width: 32rem) {
  .merge {
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
  }
  .merge-arrow {
    justify-self: center;
  }
  .merge-arrow::before {
    content: "↓";
  }
  .row {
    grid-template-columns: 7rem minmax(0, 1fr);
  }
  .from {
    gap: var(--space-1);
  }
  .arrow {
    min-width: 0.5rem;
    margin-right: 0.3125rem;
  }
}
</style>
