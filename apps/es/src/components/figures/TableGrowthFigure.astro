---
import './figure.css';

type Fn = {
  readonly name: string;
  readonly note?: string;
  readonly ghost?: true;
};
type Table = {
  readonly name: string;
  readonly note: string;
  readonly ghost?: true;
};

const fns: readonly Fn[] = [
  { name: 'cancelVisit', note: '来院のキャンセル' },
  { name: 'completeVisit', note: '診察の完了' },
  { name: 'これから記録する出来事', ghost: true },
];
const tables: readonly Table[] = [
  { name: 'visit_cancellations', note: 'ADR 1 で追加' },
  { name: '診察の完了を記録するテーブル', note: '追加が必要', ghost: true },
  { name: '出来事ごとのテーブル', note: '追加が必要', ghost: true },
];
---

<section
  class="cfig growth"
  data-table-growth-figure
  aria-label="出来事ごとにテーブルを作ると、記録する出来事を追加するたびにテーブルが増える図"
>
  <div class="grid">
    <div class="col col-write">
      <div class="col-head">更新処理</div>
      {
        fns.map((fn) => (
          <div class:list={['fn', { ghost: fn.ghost === true }]}>
            {
              fn.ghost === true
                ? <span class="fn-name">{fn.name}</span>
                : <span class="fn-name mono">{fn.name}</span>
            }
            {fn.note !== undefined && <span class="note">{fn.note}</span>}
          </div>
        ))
      }
    </div>

    <div class="link link-write" aria-hidden="true">
      {
        tables.map((table) => (
          <span class:list={['hline', { ghost: table.ghost === true }]}></span>
        ))
      }
    </div>

    <div class="col col-tables">
      <div class="col-head">出来事ごとのテーブル</div>
      <span class="cfig-sr">左の更新処理が、上から順に1つずつ書き込みます。</span>
      {
        tables.map((table) => (
          <div class:list={['tbl', { ghost: table.ghost === true }]}>
            <div class="tbl-head">
              {
                table.ghost === true
                  ? <span>{table.name}</span>
                  : <span class="mono" set:html={table.name.replace(/_/g, '_<wbr />')} />
              }
            </div>
            <div class="tbl-body note">{table.note}</div>
          </div>
        ))
      }
    </div>

    <div class="link link-read" aria-hidden="true">
      <span class="merge first"></span>
      <span class="merge mid"><span class="out"></span></span>
      <span class="merge last"></span>
    </div>

    <div class="col col-read">
      <div class="col-head">読み取り</div>
      <span class="cfig-sr">中央の3つのテーブルすべてを読みます。</span>
      <div class="fn read">
        <span class="fn-name">
          1つの来院に起きた出来事を、時刻の順に読む SQL
        </span>
      </div>
    </div>

    <div class="cfig-callout callout-tables" data-tone="problem" data-tail="top">
      <span class="cfig-callout-label">課題</span>記録する出来事を追加するたびに、テーブルと SQL が増える
    </div>
    <div class="cfig-callout callout-read" data-tone="problem" data-tail="top">
      <span class="cfig-callout-label">課題</span>すべてのテーブルを参照する必要がある
    </div>
  </div>
</section>

<style>
.cfig.growth {
  --fig-small: var(--text-note);
  --fig-code: var(--text-note);
  container-type: inline-size;
}
.mono {
  font-family: var(--font-code);
  font-size: var(--fig-code);
}

.grid {
  --link: 2rem;
  display: grid;
  grid-template-columns:
    minmax(0, 1.05fr) var(--link) minmax(0, 1.3fr) var(--link)
    minmax(0, 0.95fr);
  grid-template-rows: auto auto auto auto auto;
  min-width: 34rem;
}

.col {
  display: grid;
  grid-row: 1 / span 4;
  grid-template-rows: subgrid;
  min-width: 0;
}
.col-write {
  grid-column: 1;
}
.col-tables {
  grid-column: 3;
}
.col-read {
  grid-column: 5;
}
.col-head {
  padding-bottom: 0.125rem;
  font-size: var(--fig-small);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
}

.fn {
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 0;
  min-width: 0;
  margin-block: 0.125rem;
  border: 2px solid transparent;
  border-radius: var(--radius-md);
  background: var(--role-ground);
  padding: var(--space-1) var(--space-2);
  line-height: var(--leading-tight);
  overflow-wrap: anywhere;
}
.fn-name {
  font-size: var(--fig-small);
  font-weight: var(--weight-bold);
}
.fn .mono {
  font-size: var(--fig-code);
}
.note {
  color: var(--role-muted);
  font-size: var(--fig-label);
  line-height: var(--leading-tight);
}
.fn.read {
  grid-row: 2 / 5;
  align-items: center;
  text-align: center;
}

.tbl {
  display: flex;
  flex-direction: column;
  min-width: 0;
  margin-block: 0.125rem;
  border: 2px solid var(--role-accent-strong);
  border-radius: var(--radius-md);
  background: var(--role-ground);
  overflow: hidden;
}
.tbl-head {
  background: var(--role-accent-strong);
  padding: 0 var(--space-2);
  color: var(--role-on-strong);
  font-size: var(--fig-small);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
}
.tbl-head .mono {
  font-size: var(--fig-code);
}
.tbl-body {
  padding: 0 var(--space-2);
}

.fn.ghost,
.tbl.ghost {
  border: 2px dashed var(--role-ink-sub);
  background: transparent;
}
.tbl.ghost .tbl-head {
  border-bottom: 2px dashed var(--role-ink-sub);
  background: transparent;
  color: var(--role-fg);
}
.fn.ghost .fn-name {
  color: var(--role-muted);
  font-weight: var(--weight-regular);
}

.link {
  display: grid;
  grid-template-rows: subgrid;
  grid-row: 2 / span 3;
  min-width: 0;
}
.link-write {
  grid-column: 2;
}
.link-read {
  grid-column: 4;
}
.hline {
  position: relative;
  align-self: center;
  height: 2px;
  margin-inline: var(--space-1) 0.375rem;
  background: var(--role-accent-strong);
}
.hline::after {
  position: absolute;
  top: 50%;
  right: -0.3125rem;
  border: 0.3125rem solid transparent;
  border-right: 0;
  border-left-color: var(--role-accent-strong);
  content: "";
  transform: translateY(-50%);
}
.hline.ghost {
  background: var(--role-ink-sub);
}
.hline.ghost::after {
  border-left-color: var(--role-ink-sub);
}

.merge {
  position: relative;
}
.merge::before {
  position: absolute;
  top: calc(50% - 1px);
  right: 50%;
  left: 0;
  height: 2px;
  background: var(--role-accent-strong);
  content: "";
}
.merge::after {
  position: absolute;
  left: calc(50% - 1px);
  width: 2px;
  background: var(--role-accent-strong);
  content: "";
}
.merge.first::after {
  top: 50%;
  bottom: 0;
}
.merge.mid::after {
  top: 0;
  bottom: 0;
}
.merge.last::after {
  top: 0;
  bottom: 50%;
}
.out {
  position: absolute;
  top: calc(50% - 1px);
  right: 0.375rem;
  left: 50%;
  height: 2px;
  background: var(--role-accent-strong);
}
.out::after {
  position: absolute;
  top: 50%;
  right: -0.3125rem;
  border: 0.3125rem solid transparent;
  border-right: 0;
  border-left-color: var(--role-accent-strong);
  content: "";
  transform: translateY(-50%);
}

.callout-tables {
  grid-column: 1 / 4;
  grid-row: 5;
  justify-self: end;
  width: min(100%, 21rem);
  margin-top: var(--space-1);
}
.callout-read {
  grid-column: 4 / 6;
  grid-row: 5;
  justify-self: end;
  width: 100%;
  margin-top: var(--space-1);
}

@container (max-width: 40rem) {
  .callout-tables {
    width: min(100%, 18rem);
  }
}
</style>
