---
interface Props {
  head: string[];
  rows: string[][];
}

const { head, rows } = Astro.props;
---

<div class="playground-table-scroll">
  <table class="playground-console-table">
    <thead>
      <tr>{head.map((title) => <th>{title}</th>)}</tr>
    </thead>
    <tbody>
      {rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}
    </tbody>
  </table>
</div>

<style>
.playground-table-scroll {
  /* 親の details が flex の子で min-width: auto のため、表の幅で文書が広がらないようにする */
  contain: inline-size;
  width: 100%;
  max-width: 100%;
  margin-block: var(--space-2);
  overflow-x: auto;
}
.playground-table-scroll .playground-console-table {
  display: table;
  width: max-content;
  min-width: 0;
  border-collapse: collapse;
  background: var(--role-ground);
  color: var(--role-ink);
  font-family: var(--font-code);
  font-size: var(--text-code);
  white-space: nowrap;
}
.playground-table-scroll .playground-console-table th,
.playground-table-scroll .playground-console-table td {
  border: 1px solid var(--role-rail);
  background: transparent;
  padding: 2px 8px;
  color: inherit;
  text-align: left;
  vertical-align: top;
}
.playground-table-scroll .playground-console-table th {
  position: static;
  background: var(--role-surface);
  font-weight: var(--weight-regular);
}
</style>
