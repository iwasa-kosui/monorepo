---
import type { PageRoute } from '../../lib/lesson-frame';

interface Group {
  readonly id: string;
  readonly title: string;
  readonly range: string;
  readonly hasCurrent: boolean;
  readonly links: readonly {
    readonly href: string;
    readonly label: string;
    readonly route: PageRoute;
  }[];
}

interface Props {
  groups: readonly Group[];
  idPrefix: string;
  label: string;
}

const { groups, idPrefix, label } = Astro.props;
---

<nav class="lesson-pages" aria-label={label}>
  {
    groups.map((group) => {
      const titleId = `${idPrefix}-${group.id}`;
      return (
      <section class="lesson-pages__group">
        <p class="lesson-pages__title" id={titleId}>
          <span class="lesson-pages__chapter">{group.title}</span>
          <span class="lesson-pages__range">{group.range}</span>
        </p>
        <ol aria-labelledby={titleId}>
          {
            group.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  data-route={link.route}
                  aria-current={link.route === 'current' ? 'page' : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ol>
      </section>
    );
    })
  }
</nav>
