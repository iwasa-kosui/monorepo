---
import '../playground/play.css';
import '../playground/agent.css';
import '../playground/workbench.css';

import { blankLabelsOf, blankValuesOf, insertTemplates } from '../lib/extract';
import { insertTemplateOf, lessonFile, snapshotFiles } from '../lib/snapshots';
import { agentLimits } from '../playground/agent-protocol';
import {
  cancelReasons,
  defaultReason,
  operatorName,
  targetVisitId,
} from '../playground/cancel-form';
import { sceneSteps } from '../playground/scene-steps';

interface Props {
  step: 1 | 2;
}

const { step } = Astro.props;
const scene = sceneSteps[step];
const project = snapshotFiles(scene.snapshot);
const visitsOf = (snapshot: string): string => {
  const source = snapshotFiles(snapshot)['visits.ts'];
  if (source === undefined) {
    throw new Error(`${snapshot} に visits.ts がありません`);
  }
  return source;
};
const template = step === 1 ? insertTemplates.step1 : insertTemplates.step2;
const config = JSON.stringify({
  step,
  storageId: scene.storageId,
  carryFrom: scene.carryFrom,
  table: scene.table,
  files: {
    ...project,
    ...lessonFile('play-cancel.ts'),
    ...lessonFile('play-initial.ts'),
    ...lessonFile('play-input.ts'),
  },
  project: Object.keys(project),
  initial: visitsOf(scene.snapshot),
  complete: visitsOf(scene.answer),
  template: insertTemplateOf(step),
});
const blanks = blankLabelsOf(template).map((
  label,
  index,
) => [label, blankValuesOf(template)[index] ?? ''] as const);
---

<div
  class="play"
  data-play="add-record"
  data-step={step}
  data-state="loading"
  data-config={config}
>
  <section class="play-col play-work" aria-label="コードの編集と実行">
    <div class="play-tabbar">
      <div class="play-tabs" role="tablist" aria-label="ファイル">
        <button
          type="button"
          role="tab"
          data-file="visits.ts"
          aria-selected="true"
          tabindex="0"
        >
          visits.ts
        </button>
      </div>
      <div class="play-editor-tools">
        <button type="button" class="btn btn--text" data-role="reset" disabled>
          最初のコードに戻す
        </button>
        <button type="button" class="btn btn--text" data-role="restore" hidden>
          読み込む前のコードに戻す
        </button>
      </div>
    </div>
    <div class="play-editor" data-role="editor"></div>
    <div class="play-actions">
      <button type="button" class="btn btn--soft" data-role="template" disabled>
        {
          step === 1
            ? (
            <>
              記録の雛形を <code>UPDATE</code> の次の行に入れる
            </>
          )
            : (
            <>
              INSERT を <code>business_events</code> 用に書き換える
            </>
          )
        }
      </button>
      <button
        type="button"
        class="btn btn--text play-hints-open"
        data-role="hints-open"
        aria-haspopup="dialog"
      >
        ヒントと解答
      </button>
    </div>
    <div class="play-message" data-role="message" aria-live="polite" hidden>
    </div>
    <section class="play-tests" aria-labelledby="tests-title">
      <div class="play-tests-row">
        <h2 id="tests-title">テスト</h2>
        <p class="play-summary" data-role="summary">まだ実行していません</p>
        <button type="button" class="btn btn--soft" data-role="tests" disabled>
          テストを実行する
        </button>
      </div>
      <p class="note">
        テストを実行して <code>pass 8 / fail 0</code> になれば完了です。
      </p>
      <ul class="play-failed" data-role="failed" aria-label="失敗したテスト">
      </ul>
    </section>
  </section>
  <section class="play-col play-side" aria-label="実行結果">
    <section class="play-app" aria-label="予約管理アプリ">
      <div class="play-window">
        <div class="play-window-bar">
          <span class="play-url">http://localhost:3000/visits/{
              targetVisitId
            }</span>
          <div class="play-status" data-role="status">
            <span data-role="status-text" role="status"
            >実行環境を読み込んでいます</span>
            <button
              type="button"
              class="btn btn--soft"
              data-role="retry"
              hidden
            >
              もう一度読み込む
            </button>
          </div>
        </div>
        <div class="play-app-body">
          <header class="play-app-head">
            <span class="play-app-brand">
              <svg
                class="play-app-mark"
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="currentColor"
                aria-hidden="true"
                focusable="false"
              >
                <ellipse cx="12" cy="16.5" rx="5.5" ry="4.5"></ellipse>
                <ellipse cx="4.5" cy="11" rx="2.2" ry="2.8"></ellipse>
                <ellipse cx="9" cy="5.8" rx="2.2" ry="2.9"></ellipse>
                <ellipse cx="15" cy="5.8" rx="2.2" ry="2.9"></ellipse>
                <ellipse cx="19.5" cy="11" rx="2.2" ry="2.8"></ellipse>
              </svg>
              clinic 予約管理
            </span>
            <span class="play-app-user">
              <span class="play-avatar" aria-hidden="true">受</span>
              {operatorName}
            </span>
          </header>
          <div class="play-app-main">
            <section
              class="play-visits-pane"
              aria-labelledby="visits-app-title"
            >
              <h2 class="play-app-title" id="visits-app-title">来院の予約</h2>
              <table class="play-visit-list" aria-label="来院の一覧">
                <thead>
                  <tr>
                    <th scope="col">ペット</th>
                    <th scope="col">来院 ID</th>
                    <th scope="col">状態</th>
                  </tr>
                </thead>
                <tbody data-role="app-visits"></tbody>
              </table>
              <p class="play-banner" data-role="app-banner" role="status"></p>
            </section>
            <section
              class="play-visit-detail"
              aria-labelledby="visit-detail-title"
            >
              <h3 id="visit-detail-title" data-role="app-detail-title">
                ポチの来院
              </h3>
              <div class="play-field">
                <label for="cancel-reason">キャンセルの理由</label>
                <select id="cancel-reason" data-role="cancel-reason">
                  {
                    cancelReasons.map((
                      reason,
                    ) => (
                      <option
                        value={reason}
                        selected={reason === defaultReason}
                      >
                        {reason}
                      </option>
                    ))
                  }
                </select>
              </div>
              <div class="play-field play-field-row">
                <span class="play-field-label">操作する人</span>
                <p>{operatorName}</p>
              </div>
              <button
                type="button"
                class="btn play-danger"
                data-role="run"
                disabled
              >
                ポチの来院をキャンセルする
              </button>
            </section>
          </div>
        </div>
      </div>
      <p class="note">
        ローカル環境です。押すたびに、DB
        を最初の状態に戻してからキャンセルします。
      </p>
    </section>
    <section class="play-db" aria-label="DB クライアント">
      <div class="play-db-conn">
        <span class="play-db-dot" aria-hidden="true"></span>
        <span class="play-db-name">clinic_local（read-write）</span>
        <span class="play-db-kind">SQLite</span>
      </div>
      <section
        class="play-grid play-grid-visits"
        aria-labelledby="visits-title"
      >
        <header class="play-grid-head">
          <span class="play-tbl-icon" aria-hidden="true"></span>
          <h2 id="visits-title"><code>visits</code></h2>
          <span class="note" data-role="visits-badge" data-phase="before"
          >実行前</span>
          <span class="note" data-role="visits-count" aria-live="polite"></span>
        </header>
        <div class="play-grid-scroll" data-role="visits"></div>
      </section>
      <section
        class="play-grid play-grid-events"
        aria-labelledby="events-title"
      >
        <header class="play-grid-head">
          <span class="play-tbl-icon" aria-hidden="true"></span>
          <h2 id="events-title"><code>{scene.table}</code></h2>
          <span class="note" data-role="events-badge" data-phase="before"
          >実行前</span>
          <span class="note" data-role="events-count" aria-live="polite"></span>
        </header>
        <div class="play-grid-scroll" data-role="events"></div>
      </section>
    </section>
    <div class="play-inquiry-dock">
      <section class="play-inquiry" aria-labelledby="inquiry-title">
        <span class="note">問い合わせ</span>
        <h2 id="inquiry-title">
          この来院がキャンセルになっているのはなぜですか。
        </h2>
        <dl class="play-answer" aria-label="問い合わせへの答え">
          {
            scene.answers.map((
              { key, label },
            ) => (
              <div data-answer={key}>
                <dt class="play-chip">{label}</dt>
                <dd data-role="answer-value">まだ実行していません</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </section>
  <dialog
    class="play-dialog"
    data-role="hints-dialog"
    aria-labelledby="hints-title"
  >
    <section class="play-hints" aria-labelledby="hints-title">
      <header class="play-dialog-head">
        <h2 id="hints-title">ヒントと解答</h2>
        <button type="button" class="btn btn--soft" data-role="hints-close">
          閉じる
        </button>
      </header>
      <p class="note play-hint">上から順に開きます。</p>
      <details class="play-hint-step" name={`hints-step-${step}`}>
        <summary>ヒント1 考えること</summary>
        <div class="play-hint-body">
          {
            step === 1 ? (
              <p>
                問い合わせの「誰が」「いつ」「なぜ」に答えるには、<code
                >visit_cancellations</code>
                に1行を入れます。どの列がどの問いに答えるかは、前のページの図で確かめます。テーブルの定義は、エクスプローラーから
                <code>db.ts</code>
                を開くと読めます。呼び出し元は、理由と操作した人を
                <code>cancelVisit</code> に渡しています。いまの <code
                >cancelVisit</code>
                は、その2つを受け取っていません。記録は、来院の更新と同じトランザクションの中に置きます。
              </p>
            ) : (
              <p>
                書き込み先を <code>visit_cancellations</code> から <code
                >business_events</code>
                に変えます。ステップ1の値がどの列に入るかは、前のページの図で確かめます。ステップ2の
                DB に <code>visit_cancellations</code>
                テーブルはありません。テーブルの定義は、エクスプローラーから
                <code>db.ts</code> を開くと読めます。
              </p>
            )
          }
        </div>
      </details>
      <details class="play-hint-step" name={`hints-step-${step}`}>
        <summary>ヒント2 変える場所</summary>
        <div class="play-hint-body">
          {
            step === 1 ? (
              <p>
                変える場所は2か所です。1か所目は <code>input</code>
                の型で、2か所目は <code>UPDATE</code>
                の次の行です。<code>UPDATE</code> の次の行に、<code
                >visit_cancellations</code>
                への <code>INSERT</code> を足します。左の「記録の雛形を
                <code>UPDATE</code>
                の次の行に入れる」を押すと、{
                  blanks.length
                }つの空欄がある雛形が入ります。
              </p>
            ) : (
              <p>
                変える場所は、ステップ1で足した <code>INSERT</code>
                です。左の「INSERT を <code>business_events</code>
                用に書き換える」を押すと、<code>INSERT</code>
                が{
                  blanks.length
                }つの空欄がある雛形に入れ替わります。雛形は、<code>UPDATE</code>
                の後で来院の行を読みます。更新の後に置くのは、変化後の状態を
                <code>target_state</code> に入れるためです。
              </p>
            )
          }
        </div>
      </details>
      <details class="play-hint-step" name={`hints-step-${step}`}>
        <summary>ヒント3 入れる値</summary>
        <div class="play-hint-body">
          <table class="play-table play-blanks" aria-label="空欄に入れる値">
            <thead>
              <tr>
                <th>空欄</th>
                <th>値</th>
              </tr>
            </thead>
            <tbody>
              {
                blanks.map((
                  [blank, value],
                ) => (
                  <tr>
                    <td><code>{blank}</code></td>
                    <td><code>{value}</code></td>
                  </tr>
                ))
              }
            </tbody>
          </table>
          {
            step === 1 ? (
              <p>
                <code>input</code> の型に <code>reason: string</code> と
                <code>operatedBy: string</code> を足します。
              </p>
            ) : (
              <p>
                <code>payload</code>
                のキーの名前はこのとおりにします。テストと第3章の SELECT は
                <code>$.reason</code> と <code>$.operatedBy</code>
                を読みます。
              </p>
            )
          }
        </div>
      </details>
      <details class="play-hint-step" name={`hints-step-${step}`}>
        <summary>解答</summary>
        <div class="play-hint-body">
          {
            step === 1 ? (
              <>
                <p>
                  <code>input</code>
                  の型と{
                    blanks.length
                  }つの空欄の値、その値にする理由は次のとおりです。
                </p>
                <ul class="play-changes play-bullets">
                  <li>
                    <code>input</code> の型は <code>{
                      '{ visitId: string; reason: string; operatedBy: string }'
                    }</code>
                    です。呼び出し元が渡す2つを受け取るためです。
                  </li>
                  <li>
                    <code>operated_by</code> は <code>input.operatedBy</code>
                    です。「誰が」に答えます。
                  </li>
                  <li>
                    <code>reason</code> は <code>input.reason</code>
                    です。「なぜ」に答えます。
                  </li>
                </ul>
              </>
            ) : (
              <>
                <p>
                  {
                    blanks.length
                  }つの空欄の値と、その値にする理由は次のとおりです。
                </p>
                <ul class="play-changes play-bullets">
                  <li>
                    <code>event_name</code> は <code>'VisitCancelled'</code>
                    です。起きたことの名前で、「何を」に答えます。
                  </li>
                  <li>
                    <code>payload</code> は <code>JSON.stringify({
                        '{ reason: input.reason, operatedBy: input.operatedBy }'
                      })</code>
                    です。テストと第3章の SELECT が、<code>$.reason</code>
                    と
                    <code>$.operatedBy</code> を読むためです。
                  </li>
                  <li>
                    <code>target_type</code> は <code>'Visit'</code>
                    です。来院以外の対象の記録と区別するためです。
                  </li>
                </ul>
              </>
            )
          }
          <p>次のボタンで、解答のコードを編集欄に読み込めます。</p>
          <button
            type="button"
            class="btn btn--soft"
            data-role={step === 1 ? 'complete' : 'complete-step-2'}
            disabled
          >
            ステップ{step}の完成コードを読み込む
          </button>
        </div>
      </details>
      <details class="play-agent-step" name={`hints-step-${step}`}>
        <summary>生成AIに依頼する</summary>
        <div class="play-agent-body">
          <div class="play-agent-copy">
            <button type="button" class="btn btn--soft" data-role="agent-copy">
              手元のコーディングエージェント用のプロンプトをコピーする
            </button>
            <span
              class="play-agent-copied"
              data-role="agent-copied"
              aria-live="polite"
            >
            </span>
          </div>
          <textarea
            class="play-agent-prompt"
            data-role="agent-prompt"
            aria-label="手元のコーディングエージェント用のプロンプト"
            rows="6"
            readonly
            hidden
          ></textarea>
          <form class="play-agent-form" data-role="agent-login">
            <label for="agent-password">講師が伝えるパスワード</label>
            <div class="play-agent-row">
              <input
                id="agent-password"
                type="password"
                autocomplete="off"
                data-role="agent-password"
              />
              <button type="submit" class="btn btn--soft">使い始める</button>
            </div>
            <p
              class="play-agent-note"
              data-role="agent-login-error"
              role="alert"
            >
            </p>
          </form>
          <form class="play-agent-form" data-role="agent-form" hidden>
            <label for="agent-request">生成AIへの依頼</label>
            <textarea
              id="agent-request"
              rows="3"
              maxlength={agentLimits.turnChars}
              data-role="agent-request"
            ></textarea>
            <div class="play-agent-row">
              <button
                type="submit"
                class="btn btn--soft"
                data-role="agent-send"
              >
                依頼する
              </button>
            </div>
          </form>
          <ol
            class="play-agent-log"
            data-role="agent-log"
            aria-label="経過"
            aria-live="polite"
          >
          </ol>
        </div>
      </details>
      <details class="play-node">
        <summary>手元の Node で動かすとき</summary>
        <div class="play-node-body">
          {
            step === 1 ? (
              <p>
                <code>chapter-1-start/visits.ts</code> の <code
                >cancelVisit</code>
                を編集し、<code>node --test visits.test.ts</code>
                を実行します。<code>pass 8</code> と <code>fail 0</code>
                が出れば、ステップ1は完了です。解答は <code
                >chapter-2-step-1</code>
                にあります。第1章と同じく、<code>ℹ pass</code> と <code>ℹ
                  fail</code>
                の行は失敗の詳細の上に出ます。
              </p>
            ) : (
              <p>
                <code>chapter-2-step-2-start</code>
                に移動します。このディレクトリの <code>db.ts</code>
                とテストは、<code>business_events</code> 用です。<code
                >visits.ts</code>
                はステップ1の解答です。自分のコードで続けるときは、ステップ1で書いた
                <code>visits.ts</code> で上書きします。<code>cancelVisit</code>
                を編集し、<code>node --test visits.test.ts</code>
                を実行します。<code>pass 8</code> と <code>fail 0</code>
                が出れば、ステップ2は完了です。演習が終わらないうちに次の章へ進むときは、<code
                >chapter-2-step-2</code> に移動します。<code
                >chapter-2-step-2</code>
                は全テストが成功する完成のスナップショットです。
              </p>
            )
          }
        </div>
      </details>
    </section>
  </dialog>
</div>

<script>
import '../playground/play-add-record.ts';
</script>
