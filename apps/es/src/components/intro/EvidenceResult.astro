---
type Cell = {
  readonly found: boolean;
  readonly text: string;
  readonly code?: true;
};

const missing: Cell = { found: false, text: '残っていない' };

const rows: readonly {
  readonly name: string;
  readonly added?: true;
  readonly cells: readonly Cell[];
}[] = [
  {
    name: 'アクセスログ',
    cells: [
      missing,
      { found: true, text: '2026-11-06 18:11:58' },
      { found: true, text: 'POST /visits/visit-pochi/cancel', code: true },
      missing,
    ],
  },
  {
    name: 'DBバックアップ',
    cells: [
      missing,
      { found: true, text: '11月6日 0:00 から今までのどこか' },
      { found: true, text: 'reserved から cancelled', code: true },
      missing,
    ],
  },
  {
    name: '更新処理を呼ぶコードに記録を足していた場合',
    added: true,
    cells: [
      { found: true, text: '受付スタッフ' },
      { found: true, text: '2026-11-06 18:11:58' },
      { found: true, text: '来院のキャンセル' },
      { found: true, text: '飼い主の都合' },
    ],
  },
];

const columns = ['誰が', 'いつ', '何を', 'なぜ'];
---

<div class="evidence" data-evidence-result>
  <button
    type="button"
    class="reveal"
    aria-expanded="false"
    aria-controls="evidence-result-body"
    data-evidence-toggle
  >
    分かったことを見る
  </button>
  <div id="evidence-result-body" class="body" hidden data-evidence-body>
    <button type="button" class="close" data-evidence-close>閉じる</button>
    <div class="scroll">
      <table>
        <caption>ポチのキャンセルについて分かったこと</caption>
        <thead>
          <tr>
            <td></td> {columns.map((column) => <th scope="col">{column}</th>)}
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class:list={{ added: row.added === true }}>
                <th scope="row">{row.name}</th>
                {
                  row.cells.map((cell) => (
                    <td data-found={String(cell.found)}>
                      {
                        cell.code === true ? (
                          <code>{cell.text}</code>
                        ) : cell.text
                      }
                    </td>
                  ))
                }
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="conclusion">
      なぜ変えたのかを知っているのは更新処理を呼ぶコードだけです。
    </p>
  </div>
</div>

<style>
.evidence {
  position: relative;
  display: flex;
  flex: none;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}
.reveal {
  min-height: 2.75rem;
  border: 0;
  border-radius: 999px;
  background: var(--role-accent);
  padding: 0 1.5rem;
  color: var(--role-on-accent);
  font-size: 1.125rem;
  font-weight: 700;
  cursor: pointer;
}
.reveal:hover {
  opacity: 0.9;
}
.reveal:focus-visible {
  outline: 2px solid var(--role-accent);
  outline-offset: 2px;
}
.body {
  position: absolute;
  inset-inline: 0;
  bottom: calc(100% + 0.25rem);
  z-index: 30;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
  max-height: calc(100dvh - 7rem);
  overflow-y: auto;
  border: 1px solid var(--role-border);
  border-radius: var(--radius-lg);
  background: var(--role-surface);
  box-shadow: var(--shadow-raised);
  padding: 0.5rem 0.75rem 0.625rem;
}
.body[hidden] {
  display: none;
}
.close {
  align-self: flex-end;
  min-height: 2rem;
  border: 1px solid var(--role-border);
  border-radius: 999px;
  background: var(--role-sunken);
  padding: 0 1rem;
  color: var(--role-fg);
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
}
.close:hover {
  background: var(--role-rule);
}
.close:focus-visible {
  outline: 2px solid var(--role-accent);
  outline-offset: 2px;
}
.scroll {
  overflow-x: auto;
}
table {
  width: 100%;
  margin: 0;
  border-collapse: collapse;
  font-size: 1.125rem;
  line-height: 1.4;
}
caption {
  padding-block: 0.25rem;
  font-size: 1.125rem;
  font-weight: 700;
  text-align: left;
}
th,
td {
  border: 1px solid var(--role-rule);
  padding: 0.375rem 0.625rem;
  text-align: left;
  vertical-align: top;
}
thead th,
tbody th {
  background: var(--role-sunken);
  font-weight: 700;
}
tbody th {
  min-width: 11rem;
}
thead th:nth-child(2),
thead th:nth-child(5) {
  min-width: 9rem;
}
td[data-found="true"] {
  background: var(--role-highlight-soft);
  font-weight: 700;
}
td[data-found="false"] {
  border-style: dashed;
  background: var(--role-sunken);
  color: var(--role-muted);
}
tr.added th,
tr.added td {
  border-top: 4px double var(--role-border);
}
code {
  font-size: 1em;
  overflow-wrap: anywhere;
}
.conclusion {
  margin: 0.5rem 0 0;
  font-size: 1.5rem;
  font-weight: 700;
  line-height: 1.5;
}

@media (max-height: 800px) {
  table,
  caption {
    font-size: 1.125rem;
    line-height: 1.3;
  }
  th,
  td {
    padding: 0.25rem 0.5rem;
  }
  .conclusion {
    margin-top: 0.25rem;
    font-size: 1.25rem;
    line-height: 1.4;
  }
}
</style>

<script>
for (
  const root of document.querySelectorAll<HTMLElement>('[data-evidence-result]')
) {
  const toggle = root.querySelector<HTMLButtonElement>(
    '[data-evidence-toggle]',
  );
  const body = root.querySelector<HTMLElement>('[data-evidence-body]');
  const close = root.querySelector<HTMLButtonElement>('[data-evidence-close]');
  if (toggle === null || body === null || close === null) continue;
  const show = (open: boolean): void => {
    toggle.setAttribute('aria-expanded', String(open));
    body.hidden = !open;
  };
  toggle.addEventListener(
    'click',
    () => show(toggle.getAttribute('aria-expanded') !== 'true'),
  );
  close.addEventListener('click', () => {
    show(false);
    toggle.focus();
  });
}
</script>
