---
import SqlPlayground from '../SqlPlayground.astro';
import { restoredVisitsSql } from './evidence-scenario';

interface Props {
  duration?: number;
}

const { duration = 6000 } = Astro.props;

const backups = ['2026-11-04 00:00', '2026-11-05 00:00', '2026-11-06 00:00'];
const initial = 'SELECT * FROM visits;';
---

<div
  class="restore"
  data-backup-restore
  data-duration={duration}
  data-initial-sql={initial}
>
  <fieldset class="backups">
    <legend>毎日 0:00 の定期バックアップ</legend>
    {
      backups.map((backup, index) => (
        <label>
          <input
            type="radio"
            name="backup"
            value={backup}
            checked={index === backups.length - 1}
          />
          {backup}
        </label>
      ))
    }
  </fieldset>
  <button type="button" class="btn btn--soft" data-restore>復元する</button>
  <p class="status" aria-live="polite" data-status></p>
  <div class="bar" aria-hidden="true" data-bar hidden><span></span></div>
  <h3 class="restored" data-heading hidden></h3>
  <SqlPlayground
    id="intro-evidence-restored"
    setup={restoredVisitsSql}
    initial={initial}
    hidden={true}
  />
</div>

<style>
.restore {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-3);
  padding: var(--space-4);
  font-size: var(--text-body);
  line-height: var(--leading-normal);
}
.restore > :global(.playground) {
  align-self: stretch;
  margin-block: 0;
}
.backups {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-1) var(--space-5);
  margin: 0;
  border: 0;
  border-radius: var(--radius-lg);
  background: var(--role-sunken);
  padding: var(--space-3) var(--space-4);
}
.backups legend {
  margin-bottom: var(--space-1);
  padding: 0;
  font-weight: var(--weight-bold);
}
.backups label {
  display: inline-flex;
  align-items: center;
  gap: var(--space-2);
  min-height: var(--tap-min);
  font-family: var(--font-code);
  font-size: var(--text-code);
}
.backups input {
  width: 1.25rem;
  height: 1.25rem;
  accent-color: var(--role-accent);
}
.status {
  margin: 0;
  font-weight: var(--weight-bold);
}
.status:empty {
  display: none;
}
.bar {
  align-self: stretch;
  height: 0.75rem;
  overflow: hidden;
  border-radius: var(--radius-pill);
  background: var(--role-sunken);
}
.bar[hidden] {
  display: none;
}
.bar span {
  display: block;
  width: 100%;
  height: 100%;
  transform-origin: left;
  background: var(--role-accent);
  animation: fill var(--duration, 6000ms) linear forwards;
}
.restored {
  margin: var(--space-1) 0 0;
  font-size: var(--text-body);
  font-weight: var(--weight-bold);
}
.restored[hidden] {
  display: none;
}

@keyframes fill {
  from {
    transform: scaleX(0);
  }
  to {
    transform: scaleX(1);
  }
}

@media (prefers-reduced-motion: reduce) {
  .bar span {
    animation: none;
    background: repeating-linear-gradient(
      -45deg,
      var(--role-accent) 0 0.5rem,
      transparent 0.5rem 1rem
    );
  }
}

.restore :global([data-role="reset"]),
.restore :global([data-role="reset-sql"]),
.restore :global([data-role="restore"]) {
  display: none !important;
}
.restore :global(.playground button) {
  min-width: var(--tap-min);
  min-height: var(--tap-min);
  border: 0;
  border-radius: var(--radius-lg);
  background: var(--role-accent-soft);
  padding: 0 var(--space-4);
  color: var(--role-accent);
  font-size: var(--text-code);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
}
.restore :global(.playground button:disabled) {
  background: var(--role-rail);
  color: var(--role-ink-sub);
}
.restore :global(.playground-status),
.restore :global(.playground-origin),
.restore :global(.playground-hint),
.restore :global(.playground-note) {
  color: var(--role-ink-sub);
  font-size: var(--text-note);
}
.restore :global(.playground-editor .cm-editor) {
  font-size: var(--text-body);
}
.restore :global(.playground-editor .cm-scroller) {
  font-family: var(--font-code);
}
.restore :global(.playground-result table) {
  font-family: var(--font-code);
  font-size: var(--text-code);
  line-height: var(--leading-normal);
}
.restore :global(.playground-result th) {
  font-size: var(--text-note);
  font-weight: var(--weight-bold);
}
.restore :global(.playground-result .playground-statement code) {
  font-size: var(--text-note);
}
.restore :global(.playground-label),
.restore :global(.playground-error),
.restore :global(.playground pre) {
  font-size: var(--text-code);
}
</style>

<script>
import { emitSignal } from '../../workspace/panel';

for (
  const root of document.querySelectorAll<HTMLElement>('[data-backup-restore]')
) {
  const duration = Number(root.dataset.duration);
  const button = root.querySelector<HTMLButtonElement>('[data-restore]');
  const status = root.querySelector<HTMLElement>('[data-status]');
  const bar = root.querySelector<HTMLElement>('[data-bar]');
  const heading = root.querySelector<HTMLElement>('[data-heading]');
  const playground = root.querySelector<HTMLElement>('[data-playground="sql"]');
  const radios = [
    ...root.querySelectorAll<HTMLInputElement>('input[name="backup"]'),
  ];
  if (
    button === null || status === null || bar === null || heading === null
    || playground === null
  ) continue;

  const results = playground.querySelector<HTMLElement>(
    '[data-role="results"]',
  );
  if (results !== null) {
    new MutationObserver(() => {
      if (results.querySelector('.playground-result') === null) return;
      emitSignal(root, 'sql:executed', { key: 'restored' });
    }).observe(results, { childList: true });
  }

  let restoredOnce = false;

  const lock = (locked: boolean): void => {
    button.disabled = locked;
    for (const radio of radios) radio.disabled = locked;
  };

  const finish = (label: string): void => {
    status.textContent = '';
    bar.hidden = true;
    heading.textContent = `復元した DB（${label} 時点）`;
    heading.hidden = false;
    if (restoredOnce) {
      playground.dispatchEvent(new CustomEvent('playground:discard-state'));
      playground.dispatchEvent(
        new CustomEvent('playground:set-sql', {
          detail: { sql: root.dataset.initialSql ?? '', run: false },
        }),
      );
      playground.querySelector('[data-role="results"]')?.replaceChildren();
    }
    playground.hidden = false;
    restoredOnce = true;
    lock(false);
  };

  button.addEventListener('click', () => {
    const chosen = radios.find((radio) => radio.checked);
    if (chosen === undefined || button.disabled) return;
    lock(true);
    heading.hidden = true;
    if (restoredOnce) playground.hidden = true;
    bar.style.setProperty('--duration', `${duration}ms`);
    bar.hidden = false;
    status.textContent = '復元しています';
    setTimeout(() => finish(chosen.value), duration);
  });
}
</script>
