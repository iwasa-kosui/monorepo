  --db-func: #0b6b8f;
  --pn-bg: var(--db-band);
  --pn-fg: var(--db-fg);
  --pn-rule: var(--db-rule);
  --ring: #0b7a75;
  --role-surface: var(--db-bg);
  --role-sunken: var(--db-side);
  --role-fg: var(--db-fg);
  --role-muted: var(--db-muted);
  --role-rule: var(--db-rule);
  --role-border: var(--db-edge);
  --role-accent: var(--db-accent);
  --role-accent-soft: var(--db-soft);
  --role-on-accent: var(--db-on-accent);
  --role-danger: var(--db-danger);
  --role-danger-soft: var(--db-danger-soft);
  --role-code-keyword: var(--db-keyword);
  --role-code-string: var(--db-string);
  --role-code-number: var(--db-number);
  --role-code-comment: var(--db-comment);
  --role-code-function: var(--db-func);
  --role-code-type: var(--db-func);
  background: var(--db-bg);
  color: var(--db-fg);
}
.scene .console {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
}
.scene .db-conn {
  display: flex;
  flex: none;
  align-items: center;
  gap: 0.5rem;
  border-bottom: 1px solid var(--db-rule);
  background: var(--db-band);
  padding: 0.25rem 0.625rem;
  font-size: 0.8125rem;
  line-height: 1.5;
}
.scene .db-dot {
  flex: none;
  width: 0.5rem;
  height: 0.5rem;
  border-radius: 50%;
  background: var(--db-online);
}
.scene .db-name {
  min-width: 0;
  overflow: hidden;
  font-family: var(--font-code);
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.scene .db-kind {
  flex: none;
  margin-left: auto;
  border: 1px solid var(--db-rule);
  border-radius: 999px;
  padding: 0 0.5rem;
  color: var(--db-muted);
  font-size: 0.75rem;
}
.scene .db-body {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
}
.scene .tables {
  flex: none;
  border-bottom: 1px solid var(--db-rule);
  background: var(--db-side);
  padding: 0.375rem 0.5rem;
}
.scene .side-title {
  margin: 0 0 0.125rem;
  color: var(--db-muted);
  font-size: 0.75rem;
  font-weight: 700;
}
.scene .side-title::before {
  content: "▾" / "";
  margin-right: 0.25rem;
}
.scene .table-item {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  width: 100%;
  border: 1px solid transparent;
  border-radius: var(--radius-sm);
  background: transparent;
  padding: 0.125rem 0.375rem 0.125rem 0.75rem;
  color: var(--db-fg);
  font-family: var(--font-code);
  font-size: 0.8125rem;
  font-weight: 700;
  text-align: left;
  cursor: pointer;
}
.scene .table-item:hover {
  background: var(--db-soft);
}
.scene .tbl-icon {
  flex: none;
  width: 0.75rem;
  height: 0.625rem;
  border: 1.5px solid var(--db-accent);
  border-top-width: 3px;
  border-radius: 1px;
  background: linear-gradient(
    to right,
    transparent calc(50% - 0.5px),
    var(--db-accent) calc(50% - 0.5px),
    var(--db-accent) calc(50% + 0.5px),
    transparent calc(50% + 0.5px)
  );
}
.scene .columns {
  margin: 0;
  padding: 0 0 0 2rem;
  list-style: none;
  font-size: 0.75rem;
  line-height: 1.5;
}
.scene .columns li {
  margin: 0;
}
.scene .columns code {
  background: transparent;
  padding: 0;
  font-size: 0.75rem;
}
.scene .columns span {
  color: var(--db-muted);
  font-family: var(--font-code);
}

.scene :global(.playground) {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: var(--db-bg);
  padding: 0.375rem 0.625rem;
}
.scene :global(.playground-status),
.scene :global(.playground-toolbar) {
  margin-bottom: 0.25rem;
}
.scene :global(.playground-status) {
  color: var(--db-muted);
  font-size: 0.75rem;
}
.scene :global(.playground-toolbar) {
  align-items: center;
}
.scene :global(.playground button) {
  padding: 0.125rem 0.625rem;
  font-size: 0.8125rem;
}
.scene :global(.playground button[data-role="run"]) {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  font-weight: 700;
}
.scene :global(.playground button[data-role="run"])::before {
  content: "";
  border-top: 0.3125rem solid transparent;
  border-bottom: 0.3125rem solid transparent;
  border-left: 0.5rem solid currentColor;
}
.scene :global(.playground button[data-role="run"]:disabled) {
  background: var(--db-band);
}
.scene :global(.playground-hint) {
  font-size: 0.75rem;
}
:global(.content) .scene :global(.playground-panes) {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  gap: 0.375rem;
  min-width: 0;
  min-height: 0;
}
:global(.content) .scene :global(.playground-pane-editor) {
  display: block;
  flex: none;
  min-height: 0;
}
:global(.content) .scene :global(.playground-editor) {
  position: static;
  height: 4.5rem;
  min-height: 0;
  overflow: hidden;
}
:global(.content) .scene :global(.playground-editor .cm-editor) {
  height: 100%;
  max-height: none;
}
:global(.content) .scene :global(.playground-results) {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-height: 0;
  max-height: none;
  margin-top: 0;
  overflow: auto;
  border: 1px solid var(--db-grid);
  background: var(--db-bg);
  padding: 0;
}
.scene :global(.playground-results > *) {
  flex: none;
}
.scene :global(.playground-results > .playground-note) {
  margin: 0;
  padding: 0.375rem 0.5rem;
  color: var(--db-muted);
}
.scene :global(.playground-results > .playground-result) {
  display: flex;
  flex: 1 0 auto;
  flex-direction: column;
  margin: 0;
}
.scene :global(.playground-result + .playground-result) {
  border-top: 2px solid var(--db-grid);
}
.scene :global(.playground-result .playground-statement) {
  margin: 0;
  border-bottom: 1px solid var(--db-grid);
  background: var(--db-band);
  padding: 0.125rem 0.5rem;
}
.scene :global(.playground-result .playground-statement code) {
  background: transparent;
  padding: 0;
  color: var(--db-muted);
  font-size: 0.75rem;
}
.scene :global(.playground-result table) {
  margin: 0;
  border-collapse: collapse;
  font-family: var(--font-code);
  font-size: 0.75rem;
  counter-reset: row;
}
.scene :global(.playground-result th),
.scene :global(.playground-result td) {
  border: 1px solid var(--db-grid);
  padding: 0.125rem 0.5rem;
  text-align: left;
  white-space: nowrap;
}
.scene :global(.playground-result th) {
  background: var(--db-head);
  color: var(--db-muted);
  font-weight: 700;
}
.scene :global(.playground-result tr)::before {
  content: "";
  display: table-cell;
  width: 2rem;
  border: 1px solid var(--db-grid);
  background: var(--db-head);
  padding: 0.125rem 0.5rem;
  color: var(--db-muted);
  text-align: right;
}
.scene :global(.playground-result tbody tr) {
  counter-increment: row;
}
.scene :global(.playground-result tbody tr)::before {
  content: counter(row);
}
.scene :global(.playground-result > .playground-note) {
  position: sticky;
  bottom: 0;
  margin: auto 0 0;
  border-top: 1px solid var(--db-grid);
  background: var(--db-band);
  padding: 0.125rem 0.625rem;
  color: var(--db-muted);
  font-size: 0.75rem;
}

.scene .panel[data-tool="logs"] {
  --lg-bg: #ffffff;
  --lg-panel: #f6f7fa;
  --lg-fg: #2a2c38;
  --lg-muted: #5a5e73;
  --lg-rule: #e3e5eb;
  --lg-edge: #8b8fa3;
  --lg-rail: #632ca6;
  --lg-accent: #632ca6;
  --lg-info: #3f9ae0;
  --lg-info-text: #14659f;
  --lg-info-soft: #e6f1fb;
  --lg-warn: #b58105;
  --lg-warn-text: #7f5200;
  --lg-warn-soft: #fff4cc;
  --lg-select: #dbe9fa;
  --lg-hover: #eef3fa;
  --lg-live: #1f9d55;
  --pn-bg: var(--lg-panel);
  --pn-fg: var(--lg-fg);
  --pn-rule: var(--lg-rule);
  --ring: #632ca6;
  background: var(--lg-bg);
  color: var(--lg-fg);
}
.scene .logs-shell {
  display: flex;
  flex: 1 1 0;
  min-height: 0;
}
.scene .lg-rail {
  display: none;
  flex: none;
  flex-direction: column;
  align-items: center;
  gap: 0.375rem;
  width: 2.25rem;
  background: var(--lg-rail);
  padding-top: 0.5rem;
}
.scene .lg-rail i {
  display: block;
  width: 1.75rem;
  height: 1.75rem;
  border-radius: var(--radius-md);
  background: radial-gradient(
    circle,
    rgb(255 255 255 / 0.6) 0.3125rem,
    transparent 0.3125rem
  );
}
.scene .lg-rail i:nth-child(2n) {
  background: linear-gradient(
    rgb(255 255 255 / 0.6),
    rgb(255 255 255 / 0.6)
  ) center / 0.5625rem 0.5625rem no-repeat;
}
.scene .lg-rail i.on {
  background:
    radial-gradient(circle, #ffffff 0.3125rem, transparent 0.3125rem),
    rgb(255 255 255 / 0.22);
}
.scene .lg-col {
  display: flex;
  flex: 1 1 0;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
}
.scene .lg-head {
  display: flex;
  flex: none;
  align-items: baseline;
  gap: 0.75rem;
  border-bottom: 1px solid var(--lg-rule);
  padding: 0.25rem 0.625rem;
}
.scene .lg-head p {
  margin: 0;
  line-height: 1.5;
}
.scene .lg-title {
  font-size: 0.9375rem;
  font-weight: 700;
}
.scene .lg-sub {
  border-bottom: 2px solid var(--lg-accent);
  color: var(--lg-muted);
  font-size: 0.8125rem;
}
.scene .logs {
  display: grid;
  flex: 1 1 0;
  grid-template-columns: minmax(0, 1fr);
  grid-template-rows: auto minmax(0, 1fr);
  min-height: 0;
}
.scene .facets {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem 1rem;
  border-bottom: 1px solid var(--lg-rule);
  background: var(--lg-panel);
  padding: 0.375rem 0.625rem;
  font-size: 0.75rem;
}
.scene .facet {
  min-width: 0;
  margin: 0;
  border: 0;
  padding: 0;
}
.scene .facet legend {
  padding: 0;
  color: var(--lg-muted);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.scene .facet-item {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  line-height: 1.6;
  cursor: pointer;
}
.scene .facet-item input {
  margin: 0;
  accent-color: var(--lg-accent);
}
.scene .swatch {
  flex: none;
  width: 0.625rem;
  height: 0.625rem;
  border: 1px solid var(--lg-info-text);
  border-radius: 2px;
  background: var(--lg-info);
}
.scene .swatch[data-level="warn"] {
  border-color: var(--lg-warn-text);
  background: var(--lg-warn);
}
.scene .facet-count {
  margin-left: auto;
  color: var(--lg-muted);
  font-variant-numeric: tabular-nums;
}
.scene .logs-main {
  position: relative;
  display: flex;
  flex-direction: column;
  min-width: 0;
  min-height: 0;
}
.scene .search-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.25rem 0.5rem;
  border-bottom: 1px solid var(--lg-rule);
  padding: 0.25rem 0.625rem;
}
.scene .query-box {
  display: flex;
  flex: 1 1 12rem;
  align-items: center;
  gap: 0.375rem;
  min-width: 0;
  border: 1px solid var(--lg-edge);
  border-radius: var(--radius-md);
  background: var(--lg-bg);
  padding-left: 0.5rem;
  color: var(--lg-muted);
}
.scene .query-box:focus-within {
  outline: 2px solid var(--ring);
  outline-offset: -2px;
}
.scene .mag {
  flex: none;
}
.scene .query {
  flex: 1 1 auto;
  min-width: 0;
  border: 0;
  background: transparent;
  padding: 0.125rem 0.5rem 0.125rem 0;
  color: var(--lg-fg);
  font-family: var(--font-code);
  font-size: 0.8125rem;
}
.scene .query:focus-visible {
  outline: 0;
}
.scene .range,
.scene .live {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  border: 1px solid var(--lg-rule);
  border-radius: var(--radius-md);
  background: var(--lg-panel);
  padding: 0.0625rem 0.5rem;
  color: var(--lg-fg);
  font-size: 0.75rem;
  line-height: 1.5;
  white-space: nowrap;
}
.scene .range::after {
  content: "▾" / "";
  color: var(--lg-muted);
}
.scene .live {
  font-weight: 700;
}
.scene .live i {
  width: 0.5rem;
  height: 0.5rem;
  border: 1.5px solid var(--lg-muted);
  border-radius: 50%;
}
.scene .live[data-state="on"] i {
  border-color: var(--lg-live);
  background: var(--lg-live);
  box-shadow: 0 0 0 2px color-mix(in srgb, var(--lg-live) 30%, transparent);
}
.scene .chart {
  flex: none;
  border-bottom: 1px solid var(--lg-rule);
  padding: 0.25rem 0.625rem 0.125rem;
}
.scene .bars {
  display: grid;
  grid-template-columns: repeat(16, minmax(0, 1fr));
  align-items: end;
  gap: 2px;
  height: 2.5rem;
  border-bottom: 1px solid var(--lg-rule);
}
.scene .bar {
  display: block;
  min-height: 0;
  border-radius: 1px 1px 0 0;
  background: var(--lg-info);
}
.scene .bar[data-warn="true"] {
  background: var(--lg-warn);
}
.scene .axis {
  display: flex;
  justify-content: space-between;
  color: var(--lg-muted);
  font-size: 0.75rem;
  line-height: 1.4;
}
.scene .log-count {
  flex: none;
  margin: 0;
  padding: 0.125rem 0.625rem;
  color: var(--lg-muted);
  font-size: 0.75rem;
}
.scene .log-scroll {
  flex: 1 1 0;
  min-height: 0;
  max-height: 14rem;
  overflow: auto;
}
.scene .log-table {
  display: table;
  width: max-content;
  min-width: 100%;
  margin: 0;
  border-collapse: collapse;
  font-family: var(--font-code);
  font-size: 0.75rem;
}
.scene .log-table th,
.scene .log-table td {
  border-bottom: 1px solid var(--lg-rule);
  padding: 0.125rem 0.5rem;
  text-align: left;
  white-space: nowrap;
}
.scene .log-table th {
  position: sticky;
  top: 0;
  z-index: 1;
  background: var(--lg-panel);
  color: var(--lg-muted);
  font-weight: 700;
  letter-spacing: 0.04em;
}
.scene .log-row {
  cursor: pointer;
}
.scene .log-row:hover {
  background: var(--lg-hover);
}
.scene .log-row[aria-current="true"] {
  background: var(--lg-select);
}
.scene .log-row .col-date {
  border-left: 3px solid var(--lg-info);
}
.scene .log-row[data-level="warn"] .col-date {
  border-left-color: var(--lg-warn);
}
.scene .level {
  display: inline-block;
  min-width: 4ch;
  margin-right: 0.5ch;
  color: var(--lg-info-text);
  font-weight: 700;
}
.scene .level[data-level="warn"] {
  color: var(--lg-warn-text);
}
.scene .log-empty {
  margin: 0;
  padding: 0.5rem 0.625rem;
  font-size: 0.8125rem;
}

.scene .detail {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  width: min(22rem, 100%);
  border-top: 3px solid var(--lg-info);
  border-left: 1px solid var(--lg-edge);
  background: var(--lg-bg);
  box-shadow: var(--shadow-raised);
}
.scene .detail[data-level="warn"] {
  border-top-color: var(--lg-warn);
}
.scene .detail[hidden] {
  display: none;
}
.scene .detail-head {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--lg-rule);
  background: var(--lg-panel);
  padding: 0.125rem 0.625rem;
}
.scene .detail-title {
  margin: 0;
  font-size: 0.8125rem;
  font-weight: 700;
}
.scene .detail-head button {
  border: 1px solid var(--lg-accent);
  border-radius: var(--radius-md);
  background: var(--lg-bg);
  padding: 0 0.5rem;
  color: var(--lg-accent);
  font-size: 0.75rem;
  cursor: pointer;
}
.scene .detail-body {
  flex: 1 1 0;
  min-height: 0;
  overflow: auto;
  padding: 0.375rem 0.625rem;
  font-size: 0.75rem;
}
.scene .detail-message {
  margin: -0.375rem -0.625rem 0.375rem;
  border-left: 4px solid var(--lg-info);
  background: var(--lg-info-soft);
  padding: 0.375rem 0.625rem;
  font-family: var(--font-code);
  font-size: 0.8125rem;
  font-weight: 700;
  overflow-wrap: anywhere;
}
.scene .detail[data-level="warn"] .detail-message {
  border-left-color: var(--lg-warn);
  background: var(--lg-warn-soft);
}
.scene .detail-section {
  margin: 0.375rem 0 0.125rem;
  color: var(--lg-muted);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}
.scene .detail dl {
  margin: 0;
}
.scene .detail dl > div {
  display: grid;
  grid-template-columns: 8.5rem minmax(0, 1fr);
  gap: 0.5rem;
  border-top: 1px solid var(--lg-rule);
  padding: 0.0625rem 0;
}
.scene .detail dt {
  margin: 0;
  color: var(--lg-muted);
  font-family: var(--font-code);
}
.scene .detail-attrs dt {
  color: var(--lg-accent);
}
.scene .detail dd {
  margin: 0;
  font-family: var(--font-code);
  overflow-wrap: anywhere;
}

.scene .panel[data-tool="repo"] {
  --gh-bg: #ffffff;
  --gh-band: #f6f8fa;
  --gh-fg: #1f2328;
  --gh-muted: #59636e;
  --gh-rule: #d1d9e0;
  --gh-link: #0969da;
