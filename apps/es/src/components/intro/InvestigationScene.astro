---
import { Code } from 'astro:components';

import { cancelVisitOf, snapshotFiles } from '../../lib/snapshots';
import '../figures/figure.css';
import SqlPlayground from '../SqlPlayground.astro';
import { clockOf, describeLog } from './incident-log';
import {
  earlierLogs,
  initialAffected,
  initialVisits,
  startedAt,
  startGuide,
  visibleFromMinutes,
} from './incident-scenario';

interface Props {
  id?: string;
}

const { id = 'investigation' } = Astro.props;

const files = snapshotFiles('chapter-1-start');
const sourceOf = (name: string): string => {
  const source = files[name];
  if (source === undefined) {
    throw new Error(`chapter-1-start に ${name} がありません`);
  }
  return source;
};

const tools = [
  {
    key: 'console',
    label: 'DB コンソール',
    title: 'DB Console',
    url: 'https://db.internal.example/console',
  },
  {
    key: 'logs',
    label: 'ログの検索',
    title: 'Log Explorer',
    url: 'https://logs.internal.example/logs',
  },
  {
    key: 'repo',
    label: 'リポジトリ',
    title: 'clinic-api/visits.ts',
    url: 'https://code.internal.example/clinic/visits.ts',
  },
] as const;

const channels = [
  { name: '# general', current: false },
  { name: '# dev', current: false },
  { name: '# 問い合わせ対応', current: true },
  { name: '# 障害対応', current: false },
] as const;

const railMarks = [false, false, true, false, false] as const;

const unknownText = 'まだ分からない';
const memos = [
  { key: 'who', label: '誰が', text: 'どこにも残っていない' },
  { key: 'when', label: 'いつ', text: '2026-11-06 18:11:58' },
  { key: 'what', label: '何を', text: 'status が cancelled' },
  { key: 'why', label: 'なぜ', text: 'どこにも残っていない' },
] as const;
const memoResult = {
  who: 'missing',
  when: 'found',
  what: 'found',
  why: 'missing',
} as const;

const createVisits = /CREATE TABLE visits \([\s\S]*?\n\s*\);/.exec(
  sourceOf('db.ts'),
)?.[0];
if (createVisits === undefined) {
  throw new Error('db.ts から visits の CREATE TABLE 文を切り出せません');
}
const columns = createVisits.split('\n').slice(1, -1).map((line) => {
  const match = /^\s*(\w+)\s+(\w+)/.exec(line);
  if (match === null) {
    throw new Error(`visits の列の定義を読めません: ${line}`);
  }
  return { name: match[1] ?? '', type: match[2] ?? '' };
});
const sqlLiteral = (value: string): string =>
  `'${value.replaceAll(`'`, `''`)}'`;
const insertRows = initialVisits.map((visit) =>
  `  (${[visit.id, visit.petName, visit.status].map(sqlLiteral).join(', ')})`
).join(',\n');
const setupSql = `${createVisits}
INSERT INTO visits (id, pet_name, status) VALUES
${insertRows};`;

const facets = [
  {
    key: 'service',
    label: 'Service',
    items: [{ value: 'clinic-api', label: 'clinic-api' }],
  },
  {
    key: 'status',
    label: 'Status',
    items: [
      { value: 'info', label: 'Info' },
      { value: 'warn', label: 'Warn' },
    ],
  },
  {
    key: 'method',
    label: 'HTTP Method',
    items: [
      { value: 'GET', label: 'GET' },
      { value: 'POST', label: 'POST' },
    ],
  },
] as const;

const barCount = visibleFromMinutes + 1;
const bars = Array.from({ length: barCount }, (_, index) => index);
const axisBars = [0, Math.floor(barCount / 2), barCount - 1];
const firstBarTime = startedAt - visibleFromMinutes * 60_000;

const code = sourceOf('visits.ts').trimEnd();
const codeLines = code.split('\n').length;

const tabId = (key: string): string => `${id}-tab-${key}`;
const panelId = (key: string): string => `${id}-panel-${key}`;

const cancelEntry = earlierLogs.find((entry) => describeLog(entry, 0).cancel);
if (cancelEntry === undefined) {
  throw new Error('キャンセルのログがありません');
}
const cancelLog = describeLog(cancelEntry, Date.parse(cancelEntry.time));
const cancelVisitCode = cancelVisitOf('chapter-1-start');
const agentUrl = 'https://agent.internal.example/sessions/1';
const agentConclusion = [
  { label: 'いつ', text: '2026-11-06 18:11:58' },
  { label: '何を', text: 'status を cancelled に更新' },
  { label: '誰が', text: '特定できません' },
  { label: 'なぜ', text: '特定できません' },
] as const;
---

<section
  class="cfig scene"
  data-investigation
  data-opened=""
  data-selected="console"
  data-phase="idle"
  data-ready="false"
  aria-label="来院のキャンセル理由の調査"
>
  <div class="status-bar" role="group" aria-label="対応の状況">
    <p class="status-item status-elapsed" role="timer" aria-live="off">
      対応開始から <span data-elapsed>00:00</span>
    </p>
    <p class="status-item status-clock">
      <span class="cfig-sr">画面内の現在時刻</span>
      <time data-clock>{clockOf(startedAt)}</time>
    </p>
    <p class="status-item status-affected">
      キャンセルになった来院 <strong data-affected>{initialAffected}件</strong>
    </p>
    <div class="status-actions">
      <button type="button" data-action="pause" disabled>一時停止</button>
      <button type="button" data-action="reset" disabled>
        最初からやり直す
      </button>
    </div>
  </div>

  <div class="workspace" data-workspace>
    <div class="win chat" role="group" aria-label="チャット" data-window inert>
      <div class="chat-side" aria-hidden="true">
        <span class="dots"><i></i><i></i><i></i></span>
        <p class="ws">clinic-dev</p>
        <ul class="chs">
          {
            channels.map((channel) => (
              <li class={channel.current ? 'on' : undefined}>{channel.name}</li>
            ))
          }
        </ul>
      </div>

      <div class="chat-main">
        <div class="chat-head">
          <p class="channel"># 問い合わせ対応</p>
        </div>

        <ol
          class="feed"
          aria-live="polite"
          aria-label="チャットの投稿"
          tabindex="0"
          data-feed
        >
        </ol>

        <template data-post>
          <li class="post">
            <span class="avatar" aria-hidden="true" data-avatar></span>
            <div class="post-main">
              <p class="post-head">
                <strong data-name></strong>
                <time data-time></time>
              </p>
              <p class="post-text" data-text></p>
            </div>
          </li>
        </template>

        <div class="composer">
          <div class="compose-box">
            <p class="fmt" aria-hidden="true">
              <b>B</b>
              <i>I</i>
              <s>S</s>
              <svg
                viewBox="0 0 16 16"
                width="14"
                height="14"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
              >
                <rect x="1" y="5.5" width="8" height="5" rx="2.5"></rect>
                <rect x="7" y="5.5" width="8" height="5" rx="2.5"></rect>
              </svg>
              <span>&lt;/&gt;</span>
              <span>≡</span>
            </p>
            <p class="ph" aria-hidden="true"># 問い合わせ対応 へのメッセージ</p>
            <p class="memo-title" id={`${id}-memo`}>返信の下書き（調査メモ）</p>
            <dl
              class="memo-list"
              aria-labelledby={`${id}-memo`}
              data-unknown={unknownText}
            >
              {
                memos.map((memo) => (
                  <div class="memo-row">
                    <dt>{memo.label}</dt>
                    <dd
                      data-memo={memo.key}
                      data-state="unknown"
                      data-result={memoResult[memo.key]}
                      data-label={memo.label}
                      data-text={memo.text}
                    >
                      {unknownText}
                    </dd>
                  </div>
                ))
              }
            </dl>
            <p class="reason" id={`${id}-reason`} data-reason>
              3つのツールをすべて開くと返信できます。
            </p>
            <div class="compose-foot">
              <div class="actions">
                <button type="button" data-action="interim" disabled>
                  途中経過を報告する
                </button>
                <button
                  type="button"
                  class="primary"
                  data-action="reply"
                  aria-describedby={`${id}-reason`}
                  disabled
                >
                  調査結果を返信する
                </button>
                <button type="button" data-action="answer">答えを見る</button>
              </div>
              <span class="send-shape" aria-hidden="true">
                <svg
                  viewBox="0 0 16 16"
                  width="14"
                  height="14"
                  fill="currentColor"
                >
                  <path d="M2 2.5 14 8 2 13.5 3.8 8z"></path>
                </svg>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div
      class="win browser"
      role="group"
      aria-label="ブラウザ"
      data-window
      inert
    >
      <div class="win-bar tab-strip">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <div class="tabs" role="tablist" aria-label="開くツール">
          {
            tools.map((tool) => (
              <button
                type="button"
                class="tab"
                role="tab"
                id={tabId(tool.key)}
                data-tool={tool.key}
                data-url={tool.url}
                aria-selected={tool.key === 'console' ? 'true' : 'false'}
                aria-controls={panelId(tool.key)}
                tabindex={tool.key === 'console' ? 0 : -1}
              >
                <span class="fav" aria-hidden="true"></span>
                <span class="tab-title">{tool.title}</span>
                <span class="cfig-sr">（{tool.label}）</span>
                <span class="unseen" data-unseen>未確認</span>
              </button>
            ))
          }
        </div>
      </div>
      <p class="address">
        <span class="nav" aria-hidden="true"><i>←</i><i>→</i><i>↻</i></span>
        <span class="url-pill">
          <span class="cfig-sr">アドレス</span>
          <span class="lock" aria-hidden="true"></span>
          <span class="address-text" data-address>{tools[0].url}</span>
        </span>
      </p>

      <div class="pages">
        <div
          class="panel"
          role="tabpanel"
          id={panelId('console')}
          aria-labelledby={tabId('console')}
          data-tool="console"
        >
          <div class="console">
            <div class="db-conn">
              <span class="db-dot" aria-hidden="true"></span>
              <span class="db-name">clinic_production（read-write）</span>
              <span class="db-kind">SQLite</span>
            </div>
            <div class="db-body">
              <div class="tables" role="group" aria-label="テーブルの一覧">
                <p class="side-title">Tables</p>
                <button type="button" class="table-item" data-table="visits">
                  <span class="tbl-icon" aria-hidden="true"></span>visits
                </button>
                <ul class="columns" aria-label="visits の列">
                  {
                    columns.map((column) => (
                      <li>
                        <code>{column.name}</code>
                        <span>{column.type}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <SqlPlayground
                id="chapter-1-console"
                setup={setupSql}
                initial="SELECT * FROM visits;"
              />
            </div>
          </div>
          <p class="panel-note">いまの状態だけが入っています。</p>
        </div>

        <div
          class="panel"
          role="tabpanel"
          id={panelId('logs')}
          aria-labelledby={tabId('logs')}
          data-tool="logs"
          hidden
        >
          <div class="logs-shell">
            <div class="lg-rail" aria-hidden="true">
              {railMarks.map((on) => <i class={on ? 'on' : undefined}></i>)}
            </div>
            <div class="lg-col">
              <div class="lg-head">
                <p class="lg-title">Logs</p>
                <p class="lg-sub">Explorer</p>
              </div>
              <div class="logs">
                <div class="facets" role="group" aria-label="ログの絞り込み">
                  {
                    facets.map((facet) => (
                      <fieldset class="facet">
                        <legend>{facet.label}</legend>
                        {
                          facet.items.map((
                        item,
                      ) => (
                            <label class="facet-item">
                              <input
                                type="checkbox"
                                data-facet={facet.key}
                                value={item.value}
                              />
                              {
                                facet.key === 'status'
                          && (
                                  <span
                                    class="swatch"
                                    data-level={item.value}
                                    aria-hidden="true"
                                  >
                                  </span>
                                )
                              }
                              <span class="facet-name">{item.label}</span>
                              <span class="facet-count" data-facet-count
                              >0</span>
                            </label>
                          ))
                        }
                      </fieldset>
                    ))
                  }
                </div>

                <div class="logs-main">
                  <div class="search-row">
                    <label class="cfig-sr" for={`${id}-query`}
                    >ログの検索クエリ</label>
                    <div class="query-box">
                      <svg
                        class="mag"
                        viewBox="0 0 16 16"
                        width="14"
                        height="14"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.6"
                        aria-hidden="true"
                      >
                        <circle cx="7" cy="7" r="4.5"></circle>
                        <path d="M10.5 10.5 14 14"></path>
                      </svg>
                      <input
                        type="search"
                        class="query"
                        id={`${id}-query`}
                        value="service:clinic-api"
                        spellcheck="false"
                        autocomplete="off"
                        data-query
                        data-initial="service:clinic-api"
                      />
                    </div>
                    <span class="range">Past 15 Minutes</span>
                    <span class="live" data-live data-state="off">
                      <i aria-hidden="true"></i>Live
                    </span>
                  </div>

                  <div class="chart" role="img" data-chart>
                    <div class="bars" aria-hidden="true">
                      {
                        bars.map(() => (
                          <span
                            class="bar"
                            data-warn="false"
                            style="height: 0%"
                          >
                          </span>
                        ))
                      }
                    </div>
                    <div class="axis" aria-hidden="true">
                      {
                        axisBars.map((
                          index,
                        ) => (
                          <span data-tick={index}>
                            {
                              clockOf(
                            firstBarTime
                              + index * 60_000,
                          ).slice(0, 5)
                            }
                          </span>
                        ))
                      }
                    </div>
                  </div>

                  <p class="log-count" data-log-count>
                    0件中 0件
                  </p>

                  <div
                    class="log-scroll"
                    role="region"
                    aria-label="ログの一覧"
                    data-log-scroll
                  >
                    <table class="log-table">
                      <thead>
                        <tr>
                          <th scope="col">DATE</th>
                          <th scope="col">HOST</th>
                          <th scope="col">SERVICE</th>
                          <th scope="col">CONTENT</th>
                        </tr>
                      </thead>
                      <tbody data-log-body></tbody>
                    </table>
                    <p class="log-empty" data-empty hidden>
                      条件に合うログはありません。
                    </p>
                    <template data-log-row-template>
                      <table>
                        <tbody>
                          <tr class="log-row" tabindex="0" data-log-row>
                            <td class="col-date">
                              <time data-log-date></time>
                            </td>
                            <td>clinic-api-1</td>
                            <td>clinic-api</td>
                            <td class="col-content">
                              <span class="level" data-log-level></span>
                              <span data-log-content></span>
                            </td>
                          </tr>
                        </tbody>
                      </table>
                    </template>
                  </div>

                  <div
                    class="detail"
                    role="region"
                    aria-label="ログの詳細"
                    data-detail
                    hidden
                  >
                    <div class="detail-head">
                      <p class="detail-title">Log</p>
                      <button
                        type="button"
                        data-detail-close
                        aria-label="ログの詳細を閉じる"
                      >
                        閉じる
                      </button>
                    </div>
                    <div class="detail-body">
                      <p class="detail-message" data-detail-field="message"></p>
                      <dl class="detail-summary">
                        <div>
                          <dt>Date</dt>
                          <dd data-detail-field="date"></dd>
                        </div>
                        <div>
                          <dt>Status</dt>
                          <dd data-detail-field="status"></dd>
                        </div>
                        <div>
                          <dt>Service</dt>
                          <dd>clinic-api</dd>
                        </div>
                        <div>
                          <dt>Host</dt>
                          <dd>clinic-api-1</dd>
                        </div>
                      </dl>
                      <p class="detail-section">Event Attributes</p>
                      <dl class="detail-attrs">
                        <div>
                          <dt>http.method</dt>
                          <dd data-detail-attr="http.method"></dd>
                        </div>
                        <div>
                          <dt>http.url</dt>
                          <dd data-detail-attr="http.url"></dd>
                        </div>
                        <div>
                          <dt>http.status_code</dt>
                          <dd data-detail-attr="http.status_code"></dd>
                        </div>
                        <div>
                          <dt>duration</dt>
                          <dd data-detail-attr="duration"></dd>
                        </div>
                        <div>
                          <dt>network.client.ip</dt>
                          <dd data-detail-attr="network.client.ip"></dd>
                        </div>
                        <div>
                          <dt>http.useragent</dt>
                          <dd data-detail-attr="http.useragent"></dd>
                        </div>
                      </dl>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <p class="panel-note">
            キャンセルの操作があった時刻は分かります。理由と操作した人は、ログの属性にありません。
          </p>
        </div>

        <div
          class="panel"
          role="tabpanel"
          id={panelId('repo')}
          aria-labelledby={tabId('repo')}
          data-tool="repo"
          hidden
        >
          <div class="repo-body">
            <div class="repo-top">
              <p class="repo-path">
                <span>clinic</span>
                <span class="sep">/</span>
                <strong>clinic-api</strong>
              </p>
              <span class="repo-badge">Private</span>
            </div>
            <p class="repo-tabs" aria-hidden="true">
              <span class="on">Code</span>
              <span>Issues</span>
              <span>Pull requests</span>
            </p>
            <div class="repo-nav">
              <span class="branch">main</span>
              <p class="crumbs">
                <span>clinic-api</span>
                <span class="sep">/</span>
                <span>src</span>
                <span class="sep">/</span>
                <strong>visits.ts</strong>
              </p>
            </div>
            <div class="repo-code">
              <div class="repo-bar">
                <span class="seg" aria-hidden="true"><span class="on"
                  >Code</span><span>Blame</span></span>
                <span class="repo-lines">{codeLines} lines</span>
              </div>
              <Code
                code={code}
                lang="ts"
                themes={{
                  light: 'github-light-default',
                  dark: 'github-dark-default',
                }}
                defaultColor={false}
              />
            </div>
          </div>
          <p class="panel-note">
            status
            を書き換えるだけで、理由と操作した人はどこにも保存していません。
          </p>
        </div>
      </div>
    </div>

    <div class="start" role="group" aria-labelledby={`${id}-start`} data-start>
      <div class="start-card">
        <p class="start-text" id={`${id}-start`}>
          {startGuide.join('')}
        </p>
        <button type="button" class="primary" data-action="start">
          対応を始める
        </button>
      </div>
    </div>
  </div>

  <template data-agent-tab>
    <button
      type="button"
      class="tab"
      role="tab"
      id={tabId('agent')}
      data-tool="agent"
      data-url={agentUrl}
      aria-selected="false"
      aria-controls={panelId('agent')}
      tabindex="-1"
    >
      <span class="fav" aria-hidden="true"></span>
      <span class="tab-title">Coding Agent</span>
      <span class="cfig-sr">（エージェント）</span>
    </button>
  </template>

  <template data-agent-panel>
    <div
      class="panel"
      role="tabpanel"
      id={panelId('agent')}
      aria-labelledby={tabId('agent')}
      data-tool="agent"
      hidden
    >
      <div class="agent-bar">
        <span class="agent-brand">Coding Agent</span>
        <span class="agent-slash" aria-hidden="true">/</span>
        <span class="agent-session">visit-pochi のキャンセルの調査</span>
        <span class="agent-status" data-agent-status data-state="running"
        >実行中</span>
      </div>
      <div
        class="agent-log"
        role="log"
        aria-label="エージェントの会話"
        tabindex="0"
        data-agent-log
      >
        <ol class="turns" data-agent-list></ol>
      </div>
      <div class="agent-composer">
        <label class="cfig-sr" for={`${id}-agent-input`}
        >エージェントへの依頼</label>
        <div class="agent-box">
          <textarea
            class="agent-input"
            id={`${id}-agent-input`}
            rows="2"
            placeholder="依頼を入力"
            data-agent-input
          ></textarea>
          <button type="button" class="agent-send" data-agent-send disabled>
            <span class="cfig-sr">送信</span>
            <svg
              viewBox="0 0 16 16"
              width="16"
              height="16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"></path>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </template>

  <template data-agent-parts>
    <li class="turn user" data-part="user">
      <p class="bubble" data-text></p>
    </li>
    <li class="turn agent" data-part="reply">
      <p data-text></p>
    </li>
    <li class="thinking" data-part="thinking" data-thinking>
      <span class="thinking-mark" aria-hidden="true"></span>考え中…
    </li>
  </template>

  <template data-agent-steps>
    <li class="turn user" data-kind="user">
      <p class="bubble">
        visit-pochi
        の来院がキャンセルになっています。誰が、いつ、なぜキャンセルしたのかを調べてください。
      </p>
    </li>
    <li class="turn agent" data-kind="agent">
      <p>データベース、ログ、コードの順に調べます。</p>
    </li>
    <li class="turn tool" data-kind="tool" data-state="done">
      <details>
        <summary>
          <span class="tool-state" aria-hidden="true"></span>
          <span class="cfig-sr" data-tool-state-text>完了</span>
