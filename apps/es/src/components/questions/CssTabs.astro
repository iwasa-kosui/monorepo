---
interface Props {
  name: string;
  label: string;
  labels: readonly string[];
}

const { name, label, labels } = Astro.props;
---

<div class="qtabs" role="group" aria-label={label}>
  {
    labels.map((text, index) => (
      <Fragment>
        <input
          class="qtabs-input"
          type="radio"
          name={name}
          id={`${name}-${index + 1}`}
          checked={index === 0}
        />
        <label class="qtabs-label" for={`${name}-${index + 1}`}>
          {text}
        </label>
      </Fragment>
    ))
  }
  <div class="qtabs-panels">
    <div class="qtabs-panel"><slot name="tab-1" /></div>
    <div class="qtabs-panel"><slot name="tab-2" /></div>
    {labels.length > 2 && <div class="qtabs-panel"><slot name="tab-3" /></div>}
  </div>
</div>

<style>
.qtabs {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
  margin-block: var(--space-4);
}
.qtabs-input {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0 0 0 0);
  white-space: nowrap;
}
.qtabs-label {
  display: inline-flex;
  align-items: center;
  min-height: var(--tap-min);
  border-radius: var(--radius-pill);
  background: var(--role-surface);
  padding: var(--space-1) var(--space-4);
  font-size: var(--text-code);
  font-weight: var(--weight-bold);
  line-height: var(--leading-tight);
  cursor: pointer;
}
.qtabs-input:checked + .qtabs-label {
  background: var(--role-accent-strong);
  color: var(--role-on-strong);
}
.qtabs-input:focus-visible + .qtabs-label {
  outline: 3px solid var(--role-accent);
  outline-offset: 2px;
}
.qtabs-panels {
  flex-basis: 100%;
  min-width: 0;
}
.qtabs-panel {
  display: none;
}
.qtabs-input:nth-of-type(1):checked ~ .qtabs-panels > .qtabs-panel:nth-child(1),
.qtabs-input:nth-of-type(2):checked ~ .qtabs-panels > .qtabs-panel:nth-child(2),
.qtabs-input:nth-of-type(3):checked
  ~ .qtabs-panels
  > .qtabs-panel:nth-child(3) {
  display: block;
}
.qtabs-panel > :global(:first-child) {
  margin-top: 0;
}
</style>
