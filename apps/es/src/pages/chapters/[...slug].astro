---
import { getCollection, render } from 'astro:content';

import LessonFrame from '../../components/frame/LessonFrame.astro';
import { lessonPageOf } from '../../lesson-pages';
import { buildChapterPages } from '../../lib/chapter-routes';
import { schedule } from '../../schedule';

export const getStaticPaths = async () => {
  const pages = buildChapterPages(
    await getCollection('chapters'),
    schedule.map((row) => row.id),
  );
  for (const page of pages) {
    const hasGoal = page.entry.data.goal !== undefined;
    if (page.number === 1 && !hasGoal) {
      throw new Error(`章の最初のページに goal がありません: ${page.entry.id}`);
    }
    if (page.number > 1 && hasGoal) {
      throw new Error(
        `goal は章の最初のページだけに置きます: ${page.entry.id}`,
      );
    }
    lessonPageOf(page.entry.id);
  }
  return pages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
};

const { page } = Astro.props;
const { Content } = await render(page.entry);
---

<LessonFrame chapter={page.chapter} number={page.number}>
  <Content />
</LessonFrame>
