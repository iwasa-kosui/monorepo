---
import { getCollection } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import { buildChapterPages, pagePath } from '../lib/chapter-routes';
import { formatClock, schedule, withTimeRanges } from '../schedule';
import {
  eventLabel,
  siteDescription,
  siteName,
  siteSubtitle,
  siteTitle,
} from '../site';

const totalMinutes = schedule.reduce((sum, row) => sum + row.minutes, 0);
const firstChapter = schedule[0];
if (firstChapter === undefined) {
  throw new Error('schedule.ts に章がありません');
}
const firstPages = new Map(
  buildChapterPages(
    await getCollection('chapters'),
    schedule.map((row) => row.id),
  )
    .filter((page) => page.number === 1)
    .map((page) => [page.chapter, page.entry] as const),
);
let elapsed = 0;
const rows = withTimeRanges(schedule).map((row) => {
  const start = formatClock(elapsed);
  elapsed += row.minutes;
  return { ...row, start, entry: firstPages.get(row.id) };
});
const meterLabel = `教材の流れ。${
  rows.map((row) => `${row.title.split(' ')[0] ?? row.title}${row.minutes}分`)
    .join('、')
}`;
---

<BaseLayout title={siteTitle} description={siteDescription}>
  <div class="top-page">
    <section class="top-hero">
      <p class="top-eyebrow">
        {eventLabel}・<span class="whitespace-nowrap">{totalMinutes}分</span>
      </p>
      <h1 class="top-title">
        <span class="block">{siteName}</span>
        <span class="top-subtitle">{siteSubtitle}</span>
      </h1>
      <p class="top-lead">
        全体を移行しなくても、既存の更新処理に記録を足せば、足した後の変更を説明できることを確かめます。題材は架空の動物病院の来院管理です。
      </p>
      <div class="top-actions">
        <a
          href={pagePath(firstChapter.id, 1)}
          class="top-button top-button-primary"
        >導入から始める</a>
        <a href="/setup/" class="top-button top-button-secondary">事前準備</a>
      </div>
      <p class="top-note">
        手元でコードを動かさなくても、講師の画面を見るだけで追えます。前提知識は、SQL
        の UPDATE と INSERT が読めることです。TypeScript
        は読めれば十分です。手元で動かす方は、事前準備を当日までに済ませてください。
      </p>
    </section>
    <section class="top-flow-panel">
      <div class="top-flow-head">
        <h2 class="top-flow-heading">教材の流れ</h2>
        <span class="top-flow-total">合計 {totalMinutes}分</span>
      </div>
      <ol class="top-flow">
        {
          rows.map((row) => (
            <li>
              {
                row.entry === undefined ? (
                  <div class="top-card">
                    <span class="top-card-range">{row.start}</span>
                    <span class="top-card-title">{row.title}</span>
                  </div>
                ) : (
                  <a
                    href={pagePath(row.id, 1)}
                    class="top-card top-card-link"
                  >
                    <span class="top-card-range">{row.start}</span>
                    <span class="top-card-title">{row.title}</span>
                    <span class="visually-hidden">{row.range}</span>
                    <span class="visually-hidden">{row.entry.data.goal}</span>
                  </a>
                )
              }
            </li>
          ))
        }
      </ol>
      <div class="top-meter" role="img" aria-label={meterLabel}>
        {rows.map((row) => <span style={`flex-grow: ${row.minutes}`}></span>)}
      </div>
    </section>
  </div>
</BaseLayout>
