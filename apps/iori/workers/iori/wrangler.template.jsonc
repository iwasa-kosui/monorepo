{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "__WORKER_NAME__",
  "account_id": "__ACCOUNT_ID__",
  "main": "../../src/worker.ts",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "../../dist",
  },
  "vars": {
    "ORIGIN": "__ORIGIN__",
    "IORI_ADMISSION_MODE": "__IORI_ADMISSION_MODE__",
    "IORI_ADMISSION_IDENTITY": "__IORI_ADMISSION_IDENTITY__",
    "VAPID_SUBJECT": "__VAPID_SUBJECT__",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "__WORKER_NAME__",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "../../drizzle-d1",
    },
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "__R2_BUCKET_NAME__",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "FEDIFY_KV",
      "id": "__KV_NAMESPACE_ID__",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "FEDIFY_QUEUE",
        "queue": "__QUEUE_NAME__",
      },
    ],
  },
}
