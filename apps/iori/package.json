{
  "type": "module",
  "name": "@iwasa-kosui/iori",
  "version": "0.1.0",
  "engines": {
    "node": "24.12.0"
  },
  "dependencies": {
    "@cf-wasm/resvg": "0.4.0",
    "@cf-wasm/satori": "0.4.2",
    "@dotenvx/dotenvx": "2.38.2",
    "@fedify/cfworkers": "2.4.6",
    "@fedify/fedify": "2.4.6",
    "@fedify/postgres": "2.4.6",
    "@fedify/vocab": "2.4.6",
    "@fedify/vocab-runtime": "2.4.6",
    "@hono/node-server": "2.1.11",
    "@hono/standard-validator": "0.4.1",
    "@iwasa-kosui/result": "workspace:*",
    "@logtape/logtape": "2.4.2",
    "@mixmark-io/domino": "2.2.0",
    "@noble/hashes": "2.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "@standard-schema/spec": "1.1.0",
    "argon2id": "1.0.1",
    "dotenv": "18.0.10",
    "drizzle-orm": "0.45.4",
    "fast-xml-parser": "5.12.1",
    "hls.js": "1.7.4",
    "hono": "4.13.19",
    "hyparquet-writer": "0.18.0",
    "marked": "18.2.1",
    "pg": "8.23.1",
    "postgres": "3.4.9",
    "sanitize-html": "2.18.2",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "shiki": "4.6.0",
    "temporal-polyfill": "1.0.8",
    "turndown": "7.2.5",
    "web-push": "4.0.0",
    "x-forwarded-fetch": "0.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.9.0",
    "@cloudflare/workers-types": "5.20261121.1",
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@hono/vite-build": "1.11.1",
    "@hono/vite-dev-server": "0.26.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/sanitize-html": "2.16.2",
    "@types/turndown": "5.0.6",
    "@types/web-push": "3.6.4",
    "dprint": "0.65.0",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "fast-check": "4.11.0",
    "hyparquet": "1.33.1",
    "source-map-support": "0.5.21",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wrangler": "4.166.0",
    "yaml": "2.9.1"
  },
  "scripts": {
    "dev": "dotenvx run -- vite",
    "prod": "cp .env dist/.env && cd dist && dotenvx run -- node  -r source-map-support/register ./index.js",
    "build:client": "dotenvx run --ignore=MISSING_ENV_FILE -- vite build --mode client",
    "build": "pnpm run build:client && NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "drizzle:push": "dotenvx run -- drizzle-kit push",
    "drizzle:generate": "dotenvx run -- drizzle-kit generate",
    "drizzle:migrate": "dotenvx run -- drizzle-kit migrate",
    "dev:worker": "pnpm run build:client && wrangler dev --config workers/iori/wrangler.local.jsonc",
    "types:worker": "wrangler types --config workers/iori/wrangler.local.jsonc",
    "deploy:worker": "pnpm run build:client && node scripts/deploy-worker.mjs",
    "deploy:worker:dry-run": "pnpm run build:client && node scripts/deploy-worker.mjs --dry-run",
    "d1:migrate:local": "wrangler d1 migrations apply iori-local --local --config workers/iori/wrangler.local.jsonc",
    "d1:migrate:remote": "node scripts/d1-migrate-remote.mjs",
    "cloudflare:public-artifacts:check": "node scripts/assert-public-artifacts.mjs",
    "cloudflare:workflow-output:check": "node scripts/assert-workflow-output.mjs",
    "cloudflare:render-config": "node scripts/render-worker-config.mjs",
    "infra:validate": "terraform -chdir=infra/cloudflare validate",
    "compose:up": "dotenvx run -- docker compose up -d",
    "compose:down": "dotenvx run -- docker compose down --volumes --remove-orphans",
    "test": "vitest",
    "test:ci": "vitest --run --project isolated && vitest --run --project shared --no-isolate",
    "build:workerd-test": "node scripts/build-workerd-test-bundle.mjs",
    "test:workerd": "pnpm run build:workerd-test && vitest --run --config vitest.workerd.config.ts",
    "typecheck": "tsc",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "dprint fmt",
    "format:check": "dprint check"
  }
}
