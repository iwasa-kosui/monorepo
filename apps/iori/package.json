{
  "type": "module",
  "name": "@iwasa-kosui/iori",
  "engines": {
    "node": "24.12.0"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.51.4",
    "@fedify/fedify": "1.10.0",
    "@fedify/hono": "1.10.0",
    "@fedify/postgres": "1.10.0",
    "@hono/node-server": "1.19.6",
    "@hono/standard-validator": "0.2.1",
    "@iwasa-kosui/result": "workspace:*",
    "@js-temporal/polyfill": "0.5.1",
    "@logtape/logtape": "1.3.5",
    "@noble/hashes": "1.8.0",
    "@standard-schema/spec": "1.1.0",
    "dotenv": "17.2.3",
    "drizzle-orm": "0.45.1",
    "hono": "4.11.1",
    "marked": "17.0.1",
    "pg": "8.16.3",
    "postgres": "3.4.7",
    "sanitize-html": "2.17.0",
    "satori": "0.19.1",
    "sharp": "0.34.5",
    "shiki": "3.21.0",
    "web-push": "3.6.7",
    "x-forwarded-fetch": "0.2.0",
    "zod": "4.2.1"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1127.0",
    "@cloudflare/workers-types": "4.20250604.0",
    "@eslint/js": "9.39.2",
    "@fast-check/vitest": "0.2.0",
    "@hono/vite-build": "1.9.0",
    "@hono/vite-dev-server": "0.24.0",
    "@types/node": "24.10.4",
    "@types/pg": "8.16.0",
    "@types/sanitize-html": "2.16.0",
    "@types/sharp": "0.32.0",
    "@types/web-push": "3.6.4",
    "dprint": "0.51.1",
    "drizzle-kit": "0.31.8",
    "esbuild": "0.27.2",
    "eslint": "^9.36.0",
    "eslint-plugin-simple-import-sort": "12.1.1",
    "eslint-plugin-unused-imports": "4.3.0",
    "fast-check": "3.23.2",
    "source-map-support": "0.5.21",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.53.0",
    "vite": "7.3.1",
    "vitest": "3.1.2",
    "wrangler": "4.20.0",
    "yaml": "2.8.2"
  },
  "scripts": {
    "dev": "dotenvx run -- vite",
    "prod": "cp .env dist/.env && cd dist && dotenvx run -- node  -r source-map-support/register ./index.js",
    "prebuild": "pnpm --filter result run build",
    "build:client": "dotenvx run --ignore=MISSING_ENV_FILE -- vite build --mode client",
    "build": "pnpm run build:client && NODE_OPTIONS=--max-old-space-size=4096 vite build",
    "drizzle:push": "dotenvx run -- drizzle-kit push",
    "drizzle:generate": "dotenvx run -- drizzle-kit generate",
    "drizzle:migrate": "dotenvx run -- drizzle-kit migrate",
    "dev:worker": "pnpm run build:client && wrangler dev --config workers/iori/wrangler.local.jsonc",
    "types:worker": "wrangler types --config workers/iori/wrangler.local.jsonc",
    "deploy:worker": "pnpm run build:client && node scripts/deploy-worker.mjs",
    "deploy:worker:dry-run": "pnpm run build:client && node scripts/deploy-worker.mjs --dry-run",
    "d1:migrate:local": "wrangler d1 migrations apply iori-local --local --config workers/iori/wrangler.local.jsonc",
    "d1:migrate:remote": "node scripts/d1-migrate-remote.mjs",
    "cloudflare:public-artifacts:check": "node scripts/assert-public-artifacts.mjs",
    "cloudflare:workflow-output:check": "node scripts/assert-workflow-output.mjs",
    "cloudflare:render-config": "node scripts/render-worker-config.mjs",
    "cloudflare:export:pg": "node scripts/export-postgres.mjs",
    "cloudflare:convert:d1": "node scripts/convert-d1-import.mjs",
    "cloudflare:import:uploads": "node scripts/import-r2-uploads.mjs",
    "cloudflare:verify:import": "node scripts/verify-cloudflare-import.mjs",
    "cloudflare:migrate:protected": "node scripts/run-protected-migration.mjs",
    "infra:validate": "terraform -chdir=infra/cloudflare validate",
    "compose:up": "dotenvx run -- docker compose up -d",
    "compose:down": "dotenvx run -- docker compose down --volumes --remove-orphans",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "tsc",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "dprint fmt",
    "format:check": "dprint check"
  }
}
