{
  "name": "@iwasa-kosui/result",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "tsc",
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.2",
    "dprint": "0.65.0",
    "eslint": "^10.15.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "fast-check": "4.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.1"
  }
}
