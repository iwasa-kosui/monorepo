{
  "name": "@iwasa-kosui/kosui-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./styles.css": "./dist/styles/index.css"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "tsc",
    "build": "rm -rf ./dist && tsc -p tsconfig.build.json && cp -r src/styles dist/styles",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "dprint fmt",
    "format:check": "dprint check"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dprint": "0.65.0",
    "eslint": "^10.15.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "^8.3.8",
    "vitest": "5.1.1"
  }
}
